<UserControl x:Class="DarkUI.WPF.CustomControls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls"
             x:Name="Root">
    <StackPanel>
        <Grid x:Name="Surface" Height="190" Background="{Binding HueBrush, ElementName=Root}" ClipToBounds="True"
              MouseLeftButtonDown="SurfaceMouseDown" MouseMove="SurfaceMouseMove" MouseLeftButtonUp="SurfaceMouseUp" SizeChanged="SurfaceSizeChanged">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0" /><GradientStop Color="Black" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False"><Ellipse x:Name="Marker" Width="10" Height="10" Stroke="White" StrokeThickness="2" Fill="Transparent" /></Canvas>
        </Grid>
        <Slider Minimum="0" Maximum="359.99" Value="{Binding Hue, ElementName=Root}" Margin="0,10,0,12" ToolTip="Hue" AutomationProperties.Name="Hue">
            <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0" /><GradientStop Color="Yellow" Offset="0.167" /><GradientStop Color="Lime" Offset="0.333" /><GradientStop Color="Cyan" Offset="0.5" /><GradientStop Color="Blue" Offset="0.667" /><GradientStop Color="Magenta" Offset="0.833" /><GradientStop Color="Red" Offset="1" /></LinearGradientBrush></Slider.Background>
        </Slider>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Label Content="R" VerticalAlignment="Center" /><controls:NumericUpDown Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red, ElementName=Root}" Margin="4,0,8,0" AutomationProperties.Name="Red" />
            <Label Grid.Column="2" Content="G" VerticalAlignment="Center" /><controls:NumericUpDown Grid.Column="3" Minimum="0" Maximum="255" Value="{Binding Green, ElementName=Root}" Margin="4,0,8,0" AutomationProperties.Name="Green" />
            <Label Grid.Column="4" Content="B" VerticalAlignment="Center" /><controls:NumericUpDown Grid.Column="5" Minimum="0" Maximum="255" Value="{Binding Blue, ElementName=Root}" Margin="4,0,0,0" AutomationProperties.Name="Blue" />
        </Grid>
        <DockPanel Margin="0,12,0,0">
            <Border Width="80" Height="30" Background="{Binding PreviewBrush, ElementName=Root}" BorderBrush="{DynamicResource Brush_Border_Low}" BorderThickness="1" Margin="0,0,12,0" />
            <TextBox Text="{Binding Hex, ElementName=Root, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" AutomationProperties.Name="RGB hexadecimal" />
        </DockPanel>
    </StackPanel>
</UserControl>
