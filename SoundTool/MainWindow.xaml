<Window x:Class="SoundTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
        xmlns:icons="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
        xmlns:tomb="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
        Title="{Binding Title}" Icon="ST.ico" Width="1050" Height="700" MinWidth="850" MinHeight="560"
        Background="{DynamicResource Brush_Background}" Style="{DynamicResource CustomWindowStyle}" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchCommand}" />
        <KeyBinding Key="F3" Command="{Binding SearchCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{tomb:Localize File}">
                <MenuItem Header="{tomb:Localize New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"><MenuItem.Icon><Image Source="{icons:Icon General/create_new}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="{tomb:Localize Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"><MenuItem.Icon><Image Source="{icons:Icon General/Open}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="{tomb:Localize Recent}" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle><Style TargetType="MenuItem"><Setter Property="Header" Value="{Binding}" /><Setter Property="Command" Value="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" /><Setter Property="CommandParameter" Value="{Binding}" /></Style></MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{tomb:Localize ClearRecent}" Command="{Binding ClearRecentCommand}" />
                <Separator />
                <MenuItem Header="{tomb:Localize Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"><MenuItem.Icon><Image Source="{icons:Icon General/Save}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="{tomb:Localize SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{tomb:Localize LoadReference}" Command="{Binding LoadReferenceCommand}" />
                <MenuItem Header="{tomb:Localize UnloadReference}" Command="{Binding UnloadReferenceCommand}" IsEnabled="{Binding HasReferenceLevel}" />
                <Separator />
                <MenuItem Header="{tomb:Localize Exit}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{tomb:Localize Edit}">
                <MenuItem Header="{tomb:Localize Copy}" Command="{Binding CopyCommand}" IsEnabled="{Binding HasSelection}" />
                <MenuItem Header="{tomb:Localize Paste}" Command="{Binding PasteCommand}" IsEnabled="{Binding HasSelection}" />
                <MenuItem Header="{tomb:Localize Options}" Command="{Binding OptionsCommand}" />
            </MenuItem>
            <MenuItem Header="{tomb:Localize Tools}">
                <MenuItem Header="{tomb:Localize IndexAll}" Command="{Binding IndexAllCommand}" />
                <MenuItem Header="{tomb:Localize UnindexAll}" Command="{Binding UnindexAllCommand}" />
                <Separator />
                <MenuItem Header="{tomb:Localize CompileTr2}" Command="{Binding CompileTr2Command}" />
                <MenuItem Header="{tomb:Localize CompileTr3}" Command="{Binding CompileTr3Command}" />
                <MenuItem Header="{tomb:Localize Unpack}" Command="{Binding UnpackCommand}" />
            </MenuItem>
            <MenuItem Header="{tomb:Localize Help}"><MenuItem Header="{tomb:Localize About}" Command="{Binding AboutCommand}" /></MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding Status}" /></StatusBar>
        <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Command="{Binding SearchCommand}" ToolTip="{tomb:Localize Search}" Width="30" Margin="4,0,0,0"><Image Source="{icons:Icon General/search}" Width="16" /></Button>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}" /></TextBox.InputBindings></TextBox>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{tomb:Localize AddSound}" Command="{Binding AddSoundCommand}" Margin="0,0,8,0" />
                    <Button Content="{tomb:Localize Delete}" Command="{Binding DeleteSoundsCommand}" IsEnabled="{Binding HasSelection}" />
                </StackPanel>
                <DataGrid x:Name="SoundList" ItemsSource="{Binding Sounds}" SelectedItem="{Binding SelectedSound}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="SoundsSelectionChanged" MouseDoubleClick="SoundListDoubleClick" CanUserAddRows="False">
                    <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat=D4}" Width="60" /><DataGridTextColumn Header="{tomb:Localize Name}" Binding="{Binding Name}" Width="*" /></DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" />
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,0,0" IsEnabled="{Binding HasSelection}">
                    <GroupBox Header="{tomb:Localize SoundParameters}">
                        <Grid Margin="8" DataContext="{Binding SelectedSound}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Label Content="ID" /><TextBox Grid.Column="1" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" Margin="4" />
                            <Label Grid.Column="2" Content="{tomb:Localize Name}" /><TextBox Grid.Column="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                            <Label Grid.Row="1" Content="{tomb:Localize Volume}" /><controls:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" Margin="4" />
                            <Label Grid.Row="1" Grid.Column="2" Content="{tomb:Localize Pitch}" /><controls:NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="-100" Maximum="100" Value="{Binding PitchFactor}" Margin="4" />
                            <Label Grid.Row="2" Content="{tomb:Localize Range}" /><controls:NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RangeInSectors}" Margin="4" />
                            <Label Grid.Row="2" Grid.Column="2" Content="{tomb:Localize Chance}" /><controls:NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding Chance}" Margin="4" />
                            <Label Grid.Row="3" Content="{tomb:Localize Loop}" /><ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="4" ItemsSource="{Binding DataContext.LoopBehaviours, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding LoopBehaviour}" />
                        </Grid>
                    </GroupBox>
                    <WrapPanel Margin="8" DataContext="{Binding SelectedSound}">
                        <CheckBox Content="{tomb:Localize RandomizeVolume}" IsChecked="{Binding RandomizeVolume}" Margin="0,0,16,8" />
                        <CheckBox Content="{tomb:Localize RandomizePitch}" IsChecked="{Binding RandomizePitch}" Margin="0,0,16,8" />
                        <CheckBox Content="{tomb:Localize DisablePanning}" IsChecked="{Binding DisablePanning}" Margin="0,0,16,8" />
                        <CheckBox Content="{tomb:Localize Global}" IsChecked="{Binding Global}" Margin="0,0,16,8" />
                        <CheckBox Content="{tomb:Localize Indexed}" IsChecked="{Binding Indexed}" Margin="0,0,16,8" />
                    </WrapPanel>
                    <GroupBox Header="{tomb:Localize Samples}">
                        <DockPanel Margin="8">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Content="{tomb:Localize AddSample}" Command="{Binding AddSampleCommand}" Margin="0,0,6,0" />
                                <Button Content="{tomb:Localize Browse}" Command="{Binding BrowseSamplesCommand}" Margin="0,0,6,0" />
                                <Button Content="{tomb:Localize Delete}" Command="{Binding DeleteSampleCommand}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding SelectedSound.Samples}" SelectedItem="{Binding SelectedSample}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionChanged="SamplesSelectionChanged" Height="190">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers><DataTrigger Binding="{Binding ResolvedPath}" Value="[not found]"><Setter Property="Background" Value="#70402020" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns><DataGridTextColumn Header="{tomb:Localize Filename}" Binding="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Width="*" /><DataGridTextColumn Header="{tomb:Localize ResolvedPath}" Binding="{Binding ResolvedPath}" IsReadOnly="True" Width="2*" /></DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{tomb:Localize Preview}" Command="{Binding PlayCommand}" IsEnabled="{Binding HasReferenceLevel}" Margin="0,0,8,8" />
                        <Button Content="{tomb:Localize Stop}" Command="{Binding StopCommand}" Margin="0,0,8,8" />
                        <Button Content="{tomb:Localize Copy}" Command="{Binding CopyCommand}" Margin="0,0,8,8" />
                        <Button Content="{tomb:Localize Paste}" Command="{Binding PasteCommand}" Margin="0,0,8,8" />
                        <Button Content="{tomb:Localize Reset}" Command="{Binding ResetCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
