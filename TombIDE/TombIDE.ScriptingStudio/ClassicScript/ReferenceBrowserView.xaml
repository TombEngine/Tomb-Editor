<UserControl
	x:Class="TombIDE.ScriptingStudio.ClassicScript.ReferenceBrowserView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:classicScript="clr-namespace:TombIDE.ScriptingStudio.ClassicScript"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:localControls="clr-namespace:TombIDE.ScriptingStudio.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
	d:DataContext="{d:DesignInstance Type=classicScript:ReferenceBrowserViewModel}"
	mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0" Margin="{x:Static darkUI:Defaults.MediumThickness}">
			<localControls:AlternatingTreeView
				x:Name="categoryTreeView"
				localControls:TreeViewHelper.SelectedItem="{Binding SelectedCategory, Mode=OneWayToSource}"
				Background="Transparent"
				BorderBrush="Transparent"
				BorderThickness="0"
				FocusVisualStyle="{x:Null}"
				ItemsSource="{Binding Categories}">
				<localControls:AlternatingTreeView.ItemContainerStyle>
					<Style BasedOn="{StaticResource {x:Type controls:AlternatingTreeViewItem}}" TargetType="{x:Type localControls:AlternatingTreeViewItem}">
						<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
					</Style>
				</localControls:AlternatingTreeView.ItemContainerStyle>
				<localControls:AlternatingTreeView.ItemTemplate>
					<DataTemplate DataType="{x:Type classicScript:ReferenceBrowserCategoryViewModel}">
						<TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
					</DataTemplate>
				</localControls:AlternatingTreeView.ItemTemplate>
			</localControls:AlternatingTreeView>
		</Grid>

		<controls:SpacedGrid
			Grid.Column="1"
			Margin="{x:Static darkUI:Defaults.MediumThickness}"
			RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBox
				Padding="2,1,18,1"
				VerticalContentAlignment="Center"
				FocusVisualStyle="{x:Null}"
				FontSize="11"
				Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}">
				<darkUI:WatermarkService.Watermark>
					<TextBlock
						FontSize="11"
						Foreground="{DynamicResource Brush_Text}"
						Opacity="0.4"
						Text="{tombLib:Localize SearchPlaceholder}" />
				</darkUI:WatermarkService.Watermark>
			</TextBox>

			<DataGrid
				x:Name="dataGrid"
				Grid.Row="1"
				AlternationCount="2"
				AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
				CanUserAddRows="False"
				CanUserDeleteRows="False"
				CanUserReorderColumns="True"
				ColumnWidth="*"
				IsReadOnly="True"
				ItemsSource="{Binding Rows}"
				SelectedItem="{Binding SelectedRow, Mode=OneWayToSource}"
				SelectionMode="Single"
				SelectionUnit="FullRow">
				<DataGrid.InputBindings>
					<MouseBinding Command="{Binding GoToReferenceDefinitionCommand}" Gesture="LeftDoubleClick" />
				</DataGrid.InputBindings>
				<DataGrid.ContextMenu>
					<ContextMenu>
						<MenuItem
							Command="{Binding CopySelectedRowCommand}"
							Header="{tombLib:Localize CopyLabel}"
							IsEnabled="{Binding CanCopy}" />
					</ContextMenu>
				</DataGrid.ContextMenu>
			</DataGrid>
		</controls:SpacedGrid>
	</Grid>
</UserControl>
