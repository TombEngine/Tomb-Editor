<UserControl
    x:Class="TombEditor.Features.DockableViews.ItemBrowser.ItemBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    d:DesignHeight="250"
    d:DesignWidth="285"
    Background="{DynamicResource Brush_Background}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <controls:SpacedGrid Margin="{x:Static darkUI:Defaults.SmallThickness}" RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:SpacedGrid ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:SearchableComboBox
                x:Name="ItemsCombo"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />

            <Button
                Grid.Column="1"
                Command="{Binding AddCommand}"
                Style="{DynamicResource ButtonWithIconOnly}"
                ToolTip="Add item to map...">
                <Image Source="{tomb:Icon General/plus_math}" />
            </Button>
        </controls:SpacedGrid>

        <Grid Grid.Row="1">
            <Border x:Name="ItemPreviewHost" Visibility="{Binding Preview.IsAvailable, Converter={StaticResource BoolToVisibility}}" />
            <Button Height="Auto" Command="{Binding Preview.ReloadCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Preview.IsAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Margin="10" Text="{Binding Preview.Message}" TextAlignment="Center" TextWrapping="Wrap" />
            </Button>
        </Grid>

        <controls:SpacedGrid Grid.Row="2" ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                BorderBrush="{DynamicResource Brush_Border}"
                BorderThickness="{x:Static darkUI:Defaults.BorderThickness}"
                Visibility="{Binding ShowFromWad, Converter={StaticResource BoolToVisibility}}">
                <Label
                    Content="{Binding FromWadText}"
                    Foreground="{DynamicResource Brush_Text}"
                    Style="{DynamicResource ExtraHorizontalMarginLabel}"
                    ToolTip="{Binding FromWadTooltip}" />
            </Border>

            <Button
                Grid.Column="1"
                Command="{Binding LocateCommand}"
                Style="{DynamicResource ButtonWithIconAndText}"
                ToolTip="Locate item">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{tomb:Icon General/target}" />
                    <TextBlock Text="{tombLib:Localize LocateItem}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding PreviousCommand}"
                Style="{DynamicResource ButtonWithIconOnly}"
                ToolTip="Previous item">
                <Image Source="{tomb:Icon General/ArrowUp}" />
            </Button>

            <Button
                Grid.Column="3"
                Command="{Binding NextCommand}"
                Style="{DynamicResource ButtonWithIconOnly}"
                ToolTip="Next item">
                <Image Source="{tomb:Icon General/ArrowDown}" />
            </Button>
        </controls:SpacedGrid>
    </controls:SpacedGrid>
</UserControl>
