<UserControl
	x:Class="TombEditor.Features.DockableViews.SectorOptionsPanel.SectorOptionsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:conv="clr-namespace:DarkUI.WPF.Converters;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:editor="clr-namespace:TombEditor"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:TombEditor.Features.DockableViews.SectorOptionsPanel"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:rendering="clr-namespace:TombLib.Rendering;assembly=TombLib.Rendering"
	xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
	xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
	MinWidth="285"
	MinHeight="256"
	d:DesignHeight="256"
	d:DesignWidth="285"
	Background="{DynamicResource Brush_Background}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary>
					<conv:VectorToBrushConverter x:Key="VectorToBrushConverter" />
				</ResourceDictionary>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<controls:SpacedGrid
		Margin="{x:Static darkUI:Defaults.SmallThickness}"
		ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}"
		RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<local:Panel2DGrid x:Name="Panel2DGridControl" />

		<controls:SpacedGrid
			Grid.Column="1"
			ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}"
			RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Button
				x:Name="butFloor"
				Background="{Binding FloorColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding SetFloorCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetFloor}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Trigger}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butFloor_Image" Source="{Binding FloorIconSource}" />
			</Button>
			<Button
				x:Name="butCeiling"
				Grid.Column="1"
				Background="{Binding FloorColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding SetCeilingCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetCeiling}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Trigger}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butCeiling_Image" Source="{Binding CeilingIconSource}" />
			</Button>

			<Button
				x:Name="butBox"
				Grid.Row="1"
				Background="{Binding BoxColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding SetBoxCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetBox}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Box}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butBox_Image" Source="{Binding BoxIconSource}" />
			</Button>
			<Button
				x:Name="butNotWalkableBox"
				Grid.Row="1"
				Grid.Column="1"
				Background="{Binding NotWalkableColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding SetNotWalkableCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetNotWalkable}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.NotWalkableFloor}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butNotWalkableBox_Image" Source="{Binding NotWalkableIconSource}" />
			</Button>

			<Button
				x:Name="butMonkey"
				Grid.Row="2"
				Background="{Binding MonkeyswingColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding SetMonkeyswingCommand}"
				IsEnabled="{Binding SupportsMonkeySwing}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetMonkeyswing}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Monkey}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butMonkey_Image" Source="{Binding MonkeyIconSource}" />
			</Button>
			<Button
				x:Name="butDeath"
				Grid.Row="2"
				Grid.Column="1"
				Background="{Binding DeathColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding SetDeathCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetDeath}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Death}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butDeath_Image" Source="{Binding DeathIconSource}" />
			</Button>

			<Button
				x:Name="butPortal"
				Grid.Row="3"
				Background="{Binding PortalColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding AddPortalCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip AddPortal}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Portal}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butPortal_Image" Source="{Binding PortalIconSource}" />
			</Button>
			<Button
				x:Name="butWall"
				Grid.Row="3"
				Grid.Column="1"
				Background="{Binding WallColor, Converter={StaticResource VectorToBrushConverter}}"
				Command="{Binding SetWallCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetWall}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Wall}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butWall_Image" Source="{Binding WallIconSource}" />
			</Button>

			<Button
				x:Name="butFlagTriggerTriggerer"
				Grid.Row="4"
				Command="{Binding SetTriggerTriggererCommand}"
				IsEnabled="{Binding SupportsTriggerTriggerer}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetTriggerTriggerer}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.TriggerTriggerer}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butFlagTriggerTriggerer_Image" Source="{Binding TriggerTriggererIcon}" />
			</Button>
			<Button
				x:Name="butFlagBeetle"
				Grid.Row="4"
				Grid.Column="1"
				Command="{Binding SetBeetleCheckpointCommand}"
				IsEnabled="{Binding SupportsBeetleCheckpoint}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetBeetleCheckpoint}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Beetle}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butFlagBeetle_Image" Source="{Binding BeetleIcon}" />
			</Button>

			<Button
				x:Name="butClimbPositiveZ"
				Grid.Row="5"
				Command="{Binding SetClimbPositiveZCommand}"
				IsEnabled="{Binding SupportsClimbing}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetClimbPositiveZ}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Climb}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butClimbPositiveZ_Image" Source="{tomb:Icon Sectortype/ClimbNorth}" />
			</Button>
			<Button
				x:Name="butClimbNegativeZ"
				Grid.Row="5"
				Grid.Column="1"
				Command="{Binding SetClimbNegativeZCommand}"
				IsEnabled="{Binding SupportsClimbing}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetClimbNegativeZ}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Climb}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butClimbNegativeZ_Image" Source="{tomb:Icon Sectortype/ClimbSouth_1}" />
			</Button>

			<Button
				x:Name="butClimbNegativeX"
				Grid.Row="6"
				Command="{Binding SetClimbNegativeXCommand}"
				IsEnabled="{Binding SupportsClimbing}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetClimbNegativeX}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Climb}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butClimbNegativeX_Image" Source="{tomb:Icon Sectortype/ClimbWest}" />
			</Button>
			<Button
				x:Name="butClimbPositiveX"
				Grid.Row="6"
				Grid.Column="1"
				Command="{Binding SetClimbPositiveXCommand}"
				IsEnabled="{Binding SupportsClimbing}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip SetClimbPositiveX}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Climb}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butClimbPositiveX_Image" Source="{tomb:Icon Sectortype/ClimbEast}" />
			</Button>

			<Button
				x:Name="butAddGhostBlock"
				Grid.Row="7"
				Command="{Binding AddGhostBlocksToSelectionCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip AddGhostBlocksToSelection}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.Trigger}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butAddGhostBlock_Image" Source="{tomb:Icon Objects/geometry-override}" />
			</Button>
			<Button
				x:Name="butForceSolidFloor"
				Grid.Row="7"
				Grid.Column="1"
				Command="{Binding ToggleForceFloorSolidCommand}"
				Style="{DynamicResource ButtonWithIconOnly}"
				ToolTip="{editor:CommandToolTip ToggleForceFloorSolid}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="MouseEnter">
						<i:InvokeCommandAction Command="{Binding SetSectorColoringInfoPriorityCommand}" CommandParameter="{x:Static rendering:SectorColoringType.ForceFloorSolid}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<Image x:Name="butForceSolidFloor_Image" Source="{tomb:Icon Sectortype/ForceSolidFloor}" />
			</Button>
		</controls:SpacedGrid>

		<controls:SpacedGrid
			Grid.Row="1"
			Grid.ColumnSpan="2"
			ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Button
				Command="{Binding FloorStepCommand}"
				Style="{DynamicResource ButtonWithIconAndText}"
				ToolTip="{editor:CommandToolTip SetDiagonalFloorStep, Key=FloorStepTooltip}">
				<StackPanel Orientation="Horizontal">
					<Image Source="{tomb:Icon Sectortype/StepFloor_1}" />
					<TextBlock Text="{tombLib:Localize FloorStep}" />
				</StackPanel>
			</Button>
			<Button
				Grid.Column="1"
				Padding="{x:Static darkUI:Defaults.InputControl_DefaultPadding}"
				Command="{Binding CeilingStepCommand}"
				Style="{DynamicResource ButtonWithIconAndText}"
				ToolTip="{editor:CommandToolTip SetDiagonalCeilingStep, Key=CeilingStepTooltip}">
				<StackPanel Orientation="Horizontal">
					<Image Source="{tomb:Icon Sectortype/StepCeiling}" />
					<TextBlock Text="{tombLib:Localize CeilingStep}" />
				</StackPanel>
			</Button>
			<Button
				Grid.Column="2"
				Command="{Binding DiagonalWallCommand}"
				Style="{DynamicResource ButtonWithIconAndText}"
				ToolTip="{editor:CommandToolTip SetDiagonalWall, Key=DiagonalWallTooltip}">
				<StackPanel Orientation="Horizontal">
					<Image Source="{tomb:Icon Sectortype/DiagonalWall2}" />
					<TextBlock Text="{tombLib:Localize DiagonalWall}" />
				</StackPanel>
			</Button>
		</controls:SpacedGrid>
	</controls:SpacedGrid>
</UserControl>
