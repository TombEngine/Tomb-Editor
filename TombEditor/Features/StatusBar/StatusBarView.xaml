<UserControl
	x:Class="TombEditor.Features.StatusBar.StatusBarView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:TombEditor.Features.StatusBar"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DataContext="{d:DesignInstance Type=local:StatusBarViewModel}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<Style x:Key="StatusText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>

		<Style
			x:Key="AutosaveText"
			BasedOn="{StaticResource StatusText}"
			TargetType="TextBlock">
			<Style.Triggers>
				<DataTrigger Binding="{Binding AutosaveFailed}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource Brush_Text_Highlight}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Border
		Background="{DynamicResource Brush_Background_Low}"
		BorderBrush="{DynamicResource Brush_Border}"
		BorderThickness="0,1,0,0"
		Padding="6,2">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				Style="{StaticResource StatusText}"
				Text="{Binding SelectedRoomText}" />
			<TextBlock
				Grid.Column="1"
				Margin="16,0,0,0"
				Style="{StaticResource StatusText}"
				Text="{Binding SelectionAreaText}" />
			<TextBlock
				Grid.Column="2"
				Margin="16,0,0,0"
				Style="{StaticResource StatusText}"
				Text="{Binding SelectionSizeText}" />
			<TextBlock
				Grid.Column="4"
				Margin="16,0,0,0"
				Style="{StaticResource AutosaveText}"
				Text="{Binding AutosaveText}" />
		</Grid>
	</Border>
</UserControl>
