<UserControl
    x:Class="TombEditor.Features.StatisticsBar.StatisticsBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TombEditor.Features.StatisticsBar"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:StatisticsBarViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="StatTextBrush" Color="{DynamicResource Color_Text}" Opacity="0.6" />

        <Style x:Key="StatRunStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource StatTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Highlight}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Highlight}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="StatRunTemplate">
            <TextBlock Style="{StaticResource StatRunStyle}" Text="{Binding Text}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border
        Background="{DynamicResource Brush_Background}"
        BorderThickness="0"
        Padding="6,3"
        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
        <DockPanel LastChildFill="True">
            <!--  Step height selector (TEN levels only), mirroring the previous panelStepHeightOptions.  -->
            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Visibility="{Binding IsStepHeightVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Style="{StaticResource StatRunStyle}"
                    Margin="12,0,6,0"
                    VerticalAlignment="Center"
                    Text="Step height:" />
                <ComboBox
                    Width="110"
                    VerticalAlignment="Center"
                    FontSize="11"
                    ItemsSource="{Binding StepHeightOptions}"
                    SelectedIndex="{Binding StepHeightIndex}"
                    ToolTip="Set minimum step height for room geometry actions" />
            </StackPanel>
            <ItemsControl
                VerticalAlignment="Center"
                ItemTemplate="{StaticResource StatRunTemplate}"
                ItemsPanel="{StaticResource HorizontalPanel}"
                ItemsSource="{Binding Runs}"
                ToolTip="{Binding LimitWarning}"
                Visibility="{Binding IsStatsVisible, Converter={StaticResource BoolToVis}}" />
        </DockPanel>
    </Border>
</UserControl>
