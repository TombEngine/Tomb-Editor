<Window
    x:Class="TombEditor.Features.Dialogs.TextureRemap.TextureRemapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:TombEditor.Features.Dialogs.TextureRemap"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.TextureRemap"
    Title="{tombLib:Localize Title}"
    Width="720"
    Height="740"
    MinWidth="600"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=vm:TextureRemapWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <controls:SpacedGrid
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="{tombLib:Localize Instructions}"
            TextWrapping="Wrap" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,0,4"
                Content="{tombLib:Localize UntextureCompletely}"
                IsChecked="{Binding UntextureCompletely, Mode=TwoWay}"
                KeyboardNavigation.TabIndex="0" />

            <CheckBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,0,4"
                Content="{tombLib:Localize RestrictToSelectedRooms}"
                IsChecked="{Binding RestrictToSelectedRooms, Mode=TwoWay}"
                KeyboardNavigation.TabIndex="1" />

            <CheckBox
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize RemapAnimTextures}"
                IsChecked="{Binding RemapAnimTextures, Mode=TwoWay}"
                KeyboardNavigation.TabIndex="2" />

            <Label
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="{tombLib:Localize Scaling}" />
            <controls:NumericUpDown
                Grid.Row="2"
                Grid.Column="2"
                Width="80"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                DecimalPlaces="2"
                FormatString="F2"
                Increment="1"
                KeyboardNavigation.TabIndex="3"
                LargeIncrement="0.25"
                Maximum="256"
                Minimum="0.25"
                Value="{Binding Scaling, Mode=TwoWay}" />
        </Grid>

        <controls:SpacedGrid
            Grid.Row="2"
            ColumnSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{tombLib:Localize SourceHeader}">
                <controls:SpacedGrid RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
<Button Style="{DynamicResource ButtonWithIconOnly}" Width="23" Margin="2,0,0,0" Command="{x:Static tombLib:ComboSearch.OpenCommand}" CommandParameter="{Binding ElementName=sourceCombo}" DockPanel.Dock="Right" ToolTip="Search"><Image Width="16" Height="16" Source="{tomb:Icon General/search}" /></Button>
<controls:SearchableComboBox
                        x:Name="sourceCombo"
                                                ItemsSource="{Binding Textures}"
                        SelectedItem="{Binding SourceTexture, Mode=TwoWay}" />
</DockPanel>
                    <local:TextureRemapMapView
                        x:Name="SourceMapView"
                        Grid.Row="1"
                        IsDestination="False" />
                </controls:SpacedGrid>
            </GroupBox>

            <GroupBox
                Grid.Column="1"
                Header="{tombLib:Localize DestinationHeader}"
                IsEnabled="{Binding IsDestinationPanelEnabled}">
                <controls:SpacedGrid RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
<Button Style="{DynamicResource ButtonWithIconOnly}" Width="23" Margin="2,0,0,0" Command="{x:Static tombLib:ComboSearch.OpenCommand}" CommandParameter="{Binding ElementName=destinationCombo}" DockPanel.Dock="Right" ToolTip="Search"><Image Width="16" Height="16" Source="{tomb:Icon General/search}" /></Button>
<controls:SearchableComboBox
                        x:Name="destinationCombo"
                                                ItemsSource="{Binding Textures}"
                        SelectedItem="{Binding DestinationTexture, Mode=TwoWay}" />
</DockPanel>
                    <local:TextureRemapMapView
                        x:Name="DestinationMapView"
                        Grid.Row="1"
                        IsDestination="True" />
                </controls:SpacedGrid>
            </GroupBox>
        </controls:SpacedGrid>

        <controls:SpacedStack
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button
                Width="80"
                Command="{Binding ApplyRemapCommand}"
                Content="{tombLib:Localize Apply}"
                IsDefault="True" />

            <Button
                Width="80"
                Command="{Binding CloseCommand}"
                Content="{tombLib:Localize ~Common.Close}"
                IsCancel="True" />
        </controls:SpacedStack>

        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </controls:SpacedGrid>
</Window>
