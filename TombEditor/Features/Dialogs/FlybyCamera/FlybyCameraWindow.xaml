<Window
    x:Class="TombEditor.Features.Dialogs.FlybyCamera.FlybyCameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.FlybyCamera"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    Title="{tombLib:Localize Title}"
    Width="600"
    d:DataContext="{d:DesignInstance Type=vm:FlybyCameraWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <controls:SpacedGrid
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        ColumnSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}"
        RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ItemsControl
            Grid.Row="0"
            Grid.Column="1"
            ItemsSource="{Binding Flags}"
            KeyboardNavigation.TabIndex="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:SpacedStack Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:SpacedGrid
            Grid.Row="0"
            Grid.Column="0"
            KeyboardNavigation.TabIndex="0"
            ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}"
            RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize Sequence}" />
            <controls:NumericUpDown
                Grid.Row="0"
                Grid.Column="1"
                Increment="1"
                Maximum="255"
                Minimum="0"
                Value="{Binding Sequence, Mode=TwoWay}" />

            <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize Number}" />
            <controls:NumericUpDown
                Grid.Row="1"
                Grid.Column="1"
                Increment="1"
                Maximum="255"
                Minimum="0"
                Value="{Binding Number, Mode=TwoWay}" />

            <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize Timer}" />
            <controls:NumericUpDown
                Grid.Row="2"
                Grid.Column="1"
                Increment="1"
                Maximum="32767"
                Minimum="-32768"
                Value="{Binding Timer, Mode=TwoWay}" />

            <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize Speed}" />
            <controls:NumericUpDown
                Grid.Row="3"
                Grid.Column="1"
                FormatString="F2" DecimalPlaces="2"
                Increment="1"
                Maximum="100"
                Minimum="0"
                Value="{Binding Speed, Mode=TwoWay}" />

            <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize Fov}" />
            <controls:NumericUpDown
                Grid.Row="4"
                Grid.Column="1"
                FormatString="F4"
                Increment="1"
                Maximum="{Binding MaxFov}"
                Minimum="0"
                Value="{Binding Fov, Mode=TwoWay}" />

            <Label Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize Roll}" />
            <controls:NumericUpDown
                Grid.Row="5"
                Grid.Column="1"
                FormatString="F2" DecimalPlaces="2"
                Increment="1"
                Maximum="360"
                Minimum="0"
                LoopValues="True" Value="{Binding Roll, Mode=TwoWay}" />

            <Label Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize RotationX}" />
            <controls:NumericUpDown
                Grid.Row="6"
                Grid.Column="1"
                FormatString="F2" DecimalPlaces="2"
                Increment="1"
                Maximum="90"
                Minimum="-90"
                LoopValues="True" Value="{Binding RotationX, Mode=TwoWay}" />

            <Label Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Content="{tombLib:Localize RotationY}" />
            <controls:NumericUpDown
                Grid.Row="7"
                Grid.Column="1"
                FormatString="F2" DecimalPlaces="2"
                Increment="1"
                Maximum="360"
                Minimum="0"
                LoopValues="True" Value="{Binding RotationY, Mode=TwoWay}" />

            <Label
                Grid.Row="8"
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize DofMode}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />
            <ComboBox
                Grid.Row="8"
                Grid.Column="1"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding DofModes}"
                SelectedItem="{Binding SelectedDofMode, Mode=TwoWay}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />

            <Label
                Grid.Row="9"
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize DofDistance}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />
            <controls:NumericUpDown
                Grid.Row="9"
                Grid.Column="1"
                FormatString="F2" DecimalPlaces="2"
                Increment="128"
                Maximum="1000000"
                Minimum="0"
                Value="{Binding DofDistance, Mode=TwoWay}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />

            <Label
                Grid.Row="10"
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize DofRange}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />
            <controls:NumericUpDown
                Grid.Row="10"
                Grid.Column="1"
                FormatString="F2" DecimalPlaces="2"
                Increment="128"
                Maximum="1000000"
                Minimum="0"
                Value="{Binding DofRange, Mode=TwoWay}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />

            <Label
                Grid.Row="11"
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize DofStrength}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />
            <controls:NumericUpDown
                Grid.Row="11"
                Grid.Column="1"
                FormatString="F2" DecimalPlaces="2"
                Increment="0.05"
                Maximum="1"
                Minimum="0"
                LargeIncrement="0.1" Value="{Binding DofStrength, Mode=TwoWay}"
                Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />
        </controls:SpacedGrid>

        <controls:SpacedStack
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                IsDefault="True" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~Common.Cancel}"
                IsCancel="True" />
        </controls:SpacedStack>
    </controls:SpacedGrid>
</Window>
