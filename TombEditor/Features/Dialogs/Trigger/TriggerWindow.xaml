<Window
    x:Class="TombEditor.Features.Dialogs.Trigger.TriggerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:tombLibControls="clr-namespace:TombLib.WPF.CustomControls;assembly=TombLib.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.Trigger"
    Title="{Binding Title}"
    Width="720"
    MinWidth="600"
    d:DataContext="{d:DesignInstance Type=vm:TriggerWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <controls:SpacedGrid
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}"
        RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <!--  Trigger type + Plugin  -->
            <RowDefinition Height="26" />
            <!--  Target type  -->
            <RowDefinition Height="26" />
            <!--  Target  -->
            <RowDefinition Height="26" />
            <!--  Timer  -->
            <RowDefinition Height="26" />
            <!--  Extra  -->
            <RowDefinition Height="28" />
            <!--  Code bits + Script export  -->
            <RowDefinition Height="26" />
            <!--  OneShot + RawMode  -->
            <RowDefinition Height="Auto" />
            <!--  OK / Cancel  -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="95" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Row 0: Trigger Type + Plugin  -->
        <Label
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="{tombLib:Localize TriggerType}" />
        <tombLibControls:TriggerParameterView
            x:Name="paramTriggerType"
            KeyboardNavigation.TabIndex="1"
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="5" />
        <Label
            Grid.Row="0"
            Grid.Column="6"
            VerticalAlignment="Center"
            Content="{tombLib:Localize PluginEngine}"
            Visibility="{Binding IsNG, Converter={StaticResource BoolToVis}}" />
        <tombLibControls:TriggerParameterView
            x:Name="paramPlugin"
            KeyboardNavigation.TabIndex="17"
            Grid.Row="0"
            Grid.Column="7"
            Visibility="{Binding IsNG, Converter={StaticResource BoolToVis}}" />

        <!--  Row 1: Target Type  -->
        <Label
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="{tombLib:Localize What}" />
        <tombLibControls:TriggerParameterView
            x:Name="paramTargetType"
            KeyboardNavigation.TabIndex="2"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="7" />

        <!--  Row 2: Target  -->
        <Label
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Param}" />
        <tombLibControls:TriggerParameterView
            x:Name="paramTarget"
            KeyboardNavigation.TabIndex="3"
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="7" />

        <!--  Row 3: Timer  -->
        <Label
            Grid.Row="3"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Timer}" />
        <tombLibControls:TriggerParameterView
            x:Name="paramTimer"
            KeyboardNavigation.TabIndex="4"
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="7" />

        <!--  Row 4: Extra  -->
        <Label
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Extra}" />
        <tombLibControls:TriggerParameterView
            x:Name="paramExtra"
            KeyboardNavigation.TabIndex="5"
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="7" />

        <!--  Row 5: Code bits + Script export  -->
        <CheckBox
            Grid.Row="5"
            Grid.Column="1"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Bit1}"
            IsChecked="{Binding Bit1, Mode=TwoWay}"
            KeyboardNavigation.TabIndex="6" />
        <CheckBox
            Grid.Row="5"
            Grid.Column="2"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Bit2}"
            IsChecked="{Binding Bit2, Mode=TwoWay}"
            KeyboardNavigation.TabIndex="7" />
        <CheckBox
            Grid.Row="5"
            Grid.Column="3"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Bit3}"
            IsChecked="{Binding Bit3, Mode=TwoWay}"
            KeyboardNavigation.TabIndex="8" />
        <CheckBox
            Grid.Row="5"
            Grid.Column="4"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Bit4}"
            IsChecked="{Binding Bit4, Mode=TwoWay}"
            KeyboardNavigation.TabIndex="9" />
        <CheckBox
            Grid.Row="5"
            Grid.Column="5"
            VerticalAlignment="Center"
            Content="{tombLib:Localize Bit5}"
            IsChecked="{Binding Bit5, Mode=TwoWay}"
            KeyboardNavigation.TabIndex="10" />

        <Grid
            Grid.Row="5"
            Grid.Column="6"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            KeyboardNavigation.TabIndex="12"
            Visibility="{Binding IsNG, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize Script}">
                <Label.Margin>
                    <Thickness Right="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
                </Label.Margin>
            </Label>
            <TextBox
                Grid.Column="1"
                VerticalAlignment="Center"
                IsEnabled="{Binding ScriptEnabled}"
                IsReadOnly="True"
                Text="{Binding ScriptText, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                Width="24"
                Command="{Binding CopyToClipboardCommand}"
                IsEnabled="{Binding ScriptEnabled}"
                ToolTip="{tombLib:Localize CopyToClipboardTooltip}">
                <Button.Margin>
                    <Thickness Left="{x:Static darkUI:Defaults.TinyThicknessWidth}" />
                </Button.Margin>
                <Image Source="{tomb:Icon General/copy}" />
            </Button>
            <Button
                Grid.Column="3"
                Width="24"
                Command="{Binding CopyWithCommentsCommand}"
                IsEnabled="{Binding ScriptEnabled}"
                ToolTip="{tombLib:Localize CopyWithCommentsTooltip}">
                <Button.Margin>
                    <Thickness Left="{x:Static darkUI:Defaults.TinyThicknessWidth}" />
                </Button.Margin>
                <Image Source="{tomb:Icon General/copy_comments}" />
            </Button>
            <Button
                Grid.Column="4"
                Width="24"
                Command="{Binding SearchTriggerCommand}"
                ToolTip="{tombLib:Localize ImportTriggerTooltip}">
                <Button.Margin>
                    <Thickness Left="{x:Static darkUI:Defaults.TinyThicknessWidth}" />
                </Button.Margin>
                <Image Source="{tomb:Icon General/Import}" />
            </Button>
            <Button
                Grid.Column="5"
                Width="24"
                Command="{Binding CopyAsAnimcommandCommand}"
                IsEnabled="{Binding CopyAsAnimcommandEnabled}"
                ToolTip="{tombLib:Localize CopyAsAnimcommandTooltip}">
                <Button.Margin>
                    <Thickness Left="{x:Static darkUI:Defaults.TinyThicknessWidth}" />
                </Button.Margin>
                <Image Source="{tomb:Icon General/animcommand}" />
            </Button>
        </Grid>

        <!--  Row 6: OneShot + RawMode  -->
        <CheckBox
            Grid.Row="6"
            Grid.Column="1"
            Grid.ColumnSpan="5"
            VerticalAlignment="Center"
            Content="{tombLib:Localize OneShot}"
            IsChecked="{Binding OneShot, Mode=TwoWay}"
            IsEnabled="{Binding OneShotEnabled}"
            KeyboardNavigation.TabIndex="11" />
        <CheckBox
            Grid.Row="6"
            Grid.Column="6"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="{tombLib:Localize RawMode}"
            IsChecked="{Binding RawMode, Mode=TwoWay}"
            KeyboardNavigation.TabIndex="14" />

        <!--  Row 7: OK / Cancel  -->
        <controls:SpacedStack
            Grid.Row="7"
            Grid.Column="0"
            Grid.ColumnSpan="8"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <StackPanel.Margin>
                <Thickness Top="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
            </StackPanel.Margin>
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                KeyboardNavigation.TabIndex="15" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~Common.Cancel}"
                IsCancel="True"
                KeyboardNavigation.TabIndex="16" />
        </controls:SpacedStack>
    </controls:SpacedGrid>
</Window>
