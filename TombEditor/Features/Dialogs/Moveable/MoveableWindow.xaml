<Window
    x:Class="TombEditor.Features.Dialogs.Moveable.MoveableWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.Moveable"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    Title="{tombLib:Localize Title}"
    d:DataContext="{d:DesignInstance Type=vm:MoveableWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    FocusManager.FocusedElement="{Binding ElementName=ocbBox}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <controls:SpacedGrid
        MinWidth="260"
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}"
        RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:SpacedStack
            Grid.Row="0"
            Grid.Column="0"
            Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
            <CheckBox Content="{tombLib:Localize Bit1}" IsChecked="{Binding Bit1, Mode=TwoWay}" />
            <CheckBox Content="{tombLib:Localize Bit2}" IsChecked="{Binding Bit2, Mode=TwoWay}" />
            <CheckBox Content="{tombLib:Localize Bit3}" IsChecked="{Binding Bit3, Mode=TwoWay}" />
            <CheckBox Content="{tombLib:Localize Bit4}" IsChecked="{Binding Bit4, Mode=TwoWay}" />
            <CheckBox Content="{tombLib:Localize Bit5}" IsChecked="{Binding Bit5, Mode=TwoWay}" />
        </controls:SpacedStack>

        <controls:SpacedStack
            Grid.Row="0"
            Grid.Column="1"
            Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
            <CheckBox Content="{tombLib:Localize Invisible}" IsChecked="{Binding Invisible, Mode=TwoWay}" />
            <CheckBox Content="{Binding ClearBodyLabel}" IsChecked="{Binding ClearBody, Mode=TwoWay}" />
        </controls:SpacedStack>

        <controls:SpacedGrid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize Ocb}" />
            <TextBox
                x:Name="ocbBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                IsEnabled="{Binding IsOcbEnabled}"
                KeyboardNavigation.TabIndex="0"
                PreviewTextInput="OcbTextBox_PreviewTextInput"
                Text="{Binding OcbText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:SpacedGrid>

        <controls:SpacedGrid
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}"
            Visibility="{Binding CanBeColored, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{tombLib:Localize Color}" />
            <controls:ColorPickerButton
                Grid.Column="1"
                Height="24"
                Command="{Binding PickColorCommand}"
                SelectedColor="{Binding DisplayColor, Mode=TwoWay}" />
            <Button
                Grid.Column="2"
                Command="{Binding ResetTintCommand}"
                Style="{DynamicResource ButtonWithIconOnly}"
                ToolTip="{tombLib:Localize ResetTint}">
                <Image Source="{tomb:Icon General/undo}" />
            </Button>
        </controls:SpacedGrid>

        <controls:SpacedStack
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                IsDefault="True" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~Common.Cancel}"
                IsCancel="True" />
        </controls:SpacedStack>
    </controls:SpacedGrid>
</Window>
