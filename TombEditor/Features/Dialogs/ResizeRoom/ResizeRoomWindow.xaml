<Window
    x:Class="TombEditor.Features.Dialogs.ResizeRoom.ResizeRoomWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.ResizeRoom"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    Title="{tombLib:Localize Title}"
    Width="600"
    Height="400"
    MinWidth="540"
    MinHeight="355"
    d:DataContext="{d:DesignInstance Type=vm:ResizeRoomWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <controls:SpacedGrid
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        ColumnSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}"
        RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Header="{tombLib:Localize PreviewGroup}">
            <Border Background="{DynamicResource Brush_Background_Low}">
                <vm:ResizeRoomGridControl x:Name="gridControl" />
            </Border>
        </GroupBox>

        <StackPanel Grid.Row="0" Grid.Column="1" Width="270">
            <GroupBox Header="{tombLib:Localize NewDimensionsGroup}">
                <Grid Margin="{x:Static darkUI:Defaults.SmallThickness}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:NumericUpDown
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="76"
                        Margin="0,0,0,4"
                        LargeIncrement="2"
                        Maximum="{Binding MaxZPositive}"
                        Minimum="{Binding MinZPositive}"
                        ToolTip="{tombLib:Localize ZPositive}"
                        Value="{Binding ExpandZPositive, Mode=TwoWay}" />

                    <controls:NumericUpDown
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="76"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        LargeIncrement="2"
                        Maximum="{Binding MaxXNegative}"
                        Minimum="{Binding MinXNegative}"
                        ToolTip="{tombLib:Localize XNegative}"
                        Value="{Binding ExpandXNegative, Mode=TwoWay}" />

                    <!--  Compass: ring, four ticks and a north arrow, like the previous form's picture.  -->
                    <Viewbox
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="76"
                        Height="76">
                        <Canvas Width="76" Height="76">
                            <Ellipse
                                Canvas.Left="10"
                                Canvas.Top="10"
                                Width="56"
                                Height="56"
                                Stroke="{DynamicResource Brush_Text}"
                                StrokeThickness="3" />
                            <Path
                                Data="M 38,1 L 38,16 M 38,60 L 38,75 M 1,38 L 16,38 M 60,38 L 75,38"
                                Stroke="{DynamicResource Brush_Text}"
                                StrokeThickness="3" />
                            <Path Data="M 38,12 L 50,46 L 38,38 L 26,46 Z" Fill="{DynamicResource Brush_Text}" />
                        </Canvas>
                    </Viewbox>

                    <controls:NumericUpDown
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="76"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        LargeIncrement="2"
                        Maximum="{Binding MaxXPositive}"
                        Minimum="{Binding MinXPositive}"
                        ToolTip="{tombLib:Localize XPositive}"
                        Value="{Binding ExpandXPositive, Mode=TwoWay}" />

                    <controls:NumericUpDown
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="76"
                        Margin="0,4,0,0"
                        LargeIncrement="2"
                        Maximum="{Binding MaxZNegative}"
                        Minimum="{Binding MinZNegative}"
                        ToolTip="{tombLib:Localize ZNegative}"
                        Value="{Binding ExpandZNegative, Mode=TwoWay}" />
                </Grid>
            </GroupBox>

            <RadioButton
                Margin="0,8,0,0"
                Content="{tombLib:Localize UseWalls}"
                GroupName="FillMode"
                IsChecked="{Binding UseWalls, Mode=TwoWay}" />
            <RadioButton
                Margin="0,4,0,0"
                Content="{tombLib:Localize UseFloor}"
                GroupName="FillMode"
                IsChecked="{Binding UseFloor, Mode=TwoWay}" />
            <CheckBox
                Margin="0,8,0,0"
                Content="{Binding AllowOversizedText}"
                IsChecked="{Binding AllowOversizedRooms, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Foreground="{DynamicResource Brush_Text_Warning}"
            Text="{Binding OversizedWarning}"
            TextWrapping="Wrap"
            Visibility="{Binding IsOversized, Converter={StaticResource BoolToVis}}" />

        <controls:SpacedStack
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                IsDefault="True" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~Common.Cancel}"
                IsCancel="True" />
        </controls:SpacedStack>
    </controls:SpacedGrid>
</Window>
