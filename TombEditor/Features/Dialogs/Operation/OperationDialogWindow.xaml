<Window
    x:Class="TombEditor.Features.Dialogs.Operation.OperationDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.Operation"
    Title="{Binding Title}"
    Width="600"
    Height="420"
    MinWidth="480"
    MinHeight="320"
    d:DataContext="{d:DesignInstance Type=vm:OperationDialogWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <controls:SpacedGrid
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox
            x:Name="logList"
            Grid.Row="0"
            AlternationCount="0"
            Background="{Binding LogBackground}"
            HorizontalContentAlignment="Stretch"
            ItemsSource="{Binding LogEntries}"
            KeyDown="LogList_KeyDown"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            SelectionMode="Extended"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--  Full-width coloured row (red = error, yellow = warning) with white text.
                        HorizontalContentAlignment=Stretch on the ListBox lets the border fill the whole
                        row, so coloured rows are solid bars rather than partial-width stripes.  -->
                    <Border Background="{Binding Background}">
                        <TextBlock
                            Margin="2,0"
                            Foreground="White"
                            Text="{Binding Text}"
                            TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ProgressBar
            Grid.Row="1"
            Height="18"
            Maximum="100"
            Minimum="0"
            Value="{Binding Progress}"
            Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />

        <controls:SpacedStack
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button
                x:Name="okButton"
                Width="{x:Static darkUI:Defaults.StandardButtonWidth}"
                Command="{Binding OkCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                IsDefault="True" />
            <Button
                Width="{x:Static darkUI:Defaults.StandardButtonWidth}"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~Common.Cancel}"
                IsCancel="True" />
        </controls:SpacedStack>
    </controls:SpacedGrid>
</Window>
