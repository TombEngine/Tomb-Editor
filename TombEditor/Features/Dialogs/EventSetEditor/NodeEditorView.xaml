<UserControl
    x:Class="TombEditor.Features.Dialogs.EventSetEditor.NodeEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:TombEditor.Features.Dialogs.EventSetEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    d:DataContext="{d:DesignInstance Type=local:NodeEditorViewModel}"
    d:DesignHeight="400"
    d:DesignWidth="640"
    Focusable="True"
    KeyDown="OnKeyDown"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Dotted texture of the side grip strip (shown with NodeEditor_ShowGrips)  -->
        <DrawingBrush
            x:Key="GripStripBrush"
            TileMode="Tile"
            Viewport="0,0,4,4"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#59FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,1,2,2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--  Backward-diagonal hatch drawn over locked nodes  -->
        <DrawingBrush
            x:Key="LockedHatchBrush"
            TileMode="Tile"
            Viewport="0,0,8,8"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,0" EndPoint="8,8" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#4D7A8084" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--  Link grip bar of a node  -->
        <Style x:Key="GripBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#40FFFFFF" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="Height" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="#80FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Argument editors: no captions (the argument name is the tooltip), each fills a fixed-height row cell of NodeArgumentPanel  -->
        <DataTemplate x:Key="ArgFunction">
            <DockPanel Visibility="{Binding HasNodeFunctions, Converter={StaticResource BoolToVis}}">
                <Button
                    Width="24"
                    Margin="2,0,0,0"
                    Command="{x:Static tombLib:ComboSearch.OpenCommand}"
                    CommandParameter="{Binding ElementName=functionCombo}"
                    DockPanel.Dock="Right"
                    Style="{DynamicResource ButtonWithIconOnly}"
                    ToolTip="{tombLib:Localize ArgSearchTooltip}">
                    <Image Width="16" Height="16" Source="{tomb:Icon General/search}" />
                </Button>
                <controls:SearchableComboBox
                    x:Name="functionCombo"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsEditable}"
                    ItemsSource="{Binding AvailableFunctions}"
                    SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"
                    ToolTip="{Binding FunctionDescription}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ArgBoolean">
            <CheckBox
                VerticalAlignment="Center"
                Content="{Binding BoolCaption}"
                IsChecked="{Binding BoolValue, Mode=TwoWay}"
                ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate x:Key="ArgNumerical">
            <controls:NumericUpDown
                DecimalPlaces="{Binding DecimalPlaces}"
                Increment="{Binding Increment}"
                LargeIncrement="{Binding LargeIncrement}"
                Maximum="{Binding Maximum}"
                Minimum="{Binding Minimum}"
                ToolTip="{Binding Description}"
                Value="{Binding NumValue, Mode=TwoWay}" />
        </DataTemplate>

        <DataTemplate x:Key="ArgVector2">
            <UniformGrid Columns="2" ToolTip="{Binding Description}">
                <controls:NumericUpDown Margin="0,0,2,0" DecimalPlaces="{Binding DecimalPlaces}" Increment="{Binding Increment}" Maximum="{Binding Maximum}" Minimum="{Binding Minimum}" Value="{Binding X, Mode=TwoWay}" />
                <controls:NumericUpDown Margin="2,0,0,0" DecimalPlaces="{Binding DecimalPlaces}" Increment="{Binding Increment}" Maximum="{Binding Maximum}" Minimum="{Binding Minimum}" Value="{Binding Y, Mode=TwoWay}" />
            </UniformGrid>
        </DataTemplate>

        <DataTemplate x:Key="ArgVector3">
            <UniformGrid
                AllowDrop="True"
                Columns="3"
                DragOver="OnArgDragOver"
                Drop="OnArgDrop"
                ToolTip="{Binding Description}">
                <controls:NumericUpDown Margin="0,0,2,0" DecimalPlaces="{Binding DecimalPlaces}" Increment="{Binding Increment}" Maximum="{Binding Maximum}" Minimum="{Binding Minimum}" Value="{Binding X, Mode=TwoWay}" />
                <controls:NumericUpDown Margin="2,0,2,0" DecimalPlaces="{Binding DecimalPlaces}" Increment="{Binding Increment}" Maximum="{Binding Maximum}" Minimum="{Binding Minimum}" Value="{Binding Y, Mode=TwoWay}" />
                <controls:NumericUpDown Margin="2,0,0,0" DecimalPlaces="{Binding DecimalPlaces}" Increment="{Binding Increment}" Maximum="{Binding Maximum}" Minimum="{Binding Minimum}" Value="{Binding Z, Mode=TwoWay}" />
            </UniformGrid>
        </DataTemplate>

        <DataTemplate x:Key="ArgColor">
            <Button
                AllowDrop="True"
                Background="{Binding ColorBrush}"
                Command="{Binding PickColorCommand}"
                Content=""
                DragOver="OnArgDragOver"
                Drop="OnArgDrop"
                ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate x:Key="ArgTime">
            <UniformGrid Columns="4" ToolTip="{Binding Description}">
                <controls:NumericUpDown Margin="0,0,2,0" Maximum="1000000" Minimum="0" ToolTip="{tombLib:Localize Hours}" Value="{Binding Hours, Mode=TwoWay}" />
                <controls:NumericUpDown Margin="2,0,2,0" Maximum="59" Minimum="0" ToolTip="{tombLib:Localize Minutes}" Value="{Binding Minutes, Mode=TwoWay}" />
                <controls:NumericUpDown Margin="2,0,2,0" Maximum="59" Minimum="0" ToolTip="{tombLib:Localize Seconds}" Value="{Binding Seconds, Mode=TwoWay}" />
                <controls:NumericUpDown Margin="2,0,0,0" Maximum="99" Minimum="0" ToolTip="{tombLib:Localize Centiseconds}" Value="{Binding Cents, Mode=TwoWay}" />
            </UniformGrid>
        </DataTemplate>

        <DataTemplate x:Key="ArgString">
            <DockPanel ToolTip="{Binding Description}">
                <Button
                    Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding OpenTextEditorCommand}"
                    DockPanel.Dock="Right"
                    Style="{DynamicResource ButtonWithIconOnly}"
                    ToolTip="{tombLib:Localize ArgMultilineTooltip}"
                    Visibility="{Binding IsMultiline, Converter={StaticResource BoolToVis}}">
                    <Image Width="16" Height="16" Source="{tomb:Icon General/Multiline-text}" />
                </Button>
                <Popup
                    IsOpen="{Binding IsTextEditorOpen, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=DockPanel}}"
                    StaysOpen="False">
                    <Border
                        Width="320"
                        Height="160"
                        Background="{DynamicResource Brush_Background}"
                        BorderBrush="{DynamicResource Brush_Border}"
                        BorderThickness="1">
                        <TextBox
                            AcceptsReturn="True"
                            Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Popup>
                <TextBox VerticalContentAlignment="Center" Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ArgList">
            <DockPanel
                AllowDrop="True"
                DragOver="OnArgDragOver"
                Drop="OnArgDrop"
                ToolTip="{Binding Description}">
                <Button
                    Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding RunActionCommand}"
                    DockPanel.Dock="Right"
                    Style="{DynamicResource ButtonWithIconOnly}"
                    ToolTip="{tombLib:Localize ArgLocateTooltip}"
                    Visibility="{Binding IsLocateAction, Converter={StaticResource BoolToVis}}">
                    <Image Width="16" Height="16" Source="{tomb:Icon General/target}" />
                </Button>
                <Button
                    Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding RunActionCommand}"
                    DockPanel.Dock="Right"
                    Style="{DynamicResource ButtonWithIconOnly}"
                    ToolTip="{tombLib:Localize ArgPlayTooltip}"
                    Visibility="{Binding IsPlayAction, Converter={StaticResource BoolToVis}}">
                    <Image Width="16" Height="16" Source="{tomb:Icon Actions/play}" />
                </Button>
                <Button
                    Width="24"
                    Margin="2,0,0,0"
                    Command="{x:Static tombLib:ComboSearch.OpenCommand}"
                    CommandParameter="{Binding ElementName=listCombo}"
                    DockPanel.Dock="Right"
                    Style="{DynamicResource ButtonWithIconOnly}"
                    ToolTip="{tombLib:Localize ArgSearchTooltip}"
                    Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}">
                    <Image Width="16" Height="16" Source="{tomb:Icon General/search}" />
                </Button>
                <controls:SearchableComboBox
                    x:Name="listCombo"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
            </DockPanel>
        </DataTemplate>

        <local:ArgumentTemplateSelector
            x:Key="ArgSelector"
            BooleanTemplate="{StaticResource ArgBoolean}"
            ColorTemplate="{StaticResource ArgColor}"
            FunctionTemplate="{StaticResource ArgFunction}"
            ListTemplate="{StaticResource ArgList}"
            NumericalTemplate="{StaticResource ArgNumerical}"
            StringTemplate="{StaticResource ArgString}"
            TimeTemplate="{StaticResource ArgTime}"
            Vector2Template="{StaticResource ArgVector2}"
            Vector3Template="{StaticResource ArgVector3}" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!--  Toolbar  -->
        <controls:SpacedStack
            DockPanel.Dock="Bottom"
            Margin="0,6,0,0"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
            <Button Width="88" Command="{Binding AddActionNodeCommand}" ToolTip="{tombLib:Localize AddActionTooltip}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16" Height="16" Margin="0,0,4,0" Source="{tomb:Icon General/plus_math}" />
                    <TextBlock Text="{tombLib:Localize AddAction}" />
                </StackPanel>
            </Button>
            <Button Width="100" Command="{Binding AddConditionNodeCommand}" ToolTip="{tombLib:Localize AddConditionTooltip}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16" Height="16" Margin="0,0,4,0" Source="{tomb:Icon General/plus_math}" />
                    <TextBlock Text="{tombLib:Localize AddCondition}" />
                </StackPanel>
            </Button>

            <!--  Node actions (operate on the last selected node).  -->
            <Button
                Command="{Binding RenameSelectedCommand}"
                ToolTip="{tombLib:Localize RenameTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon General/edit}" />
            </Button>
            <Button
                Command="{Binding ColorSelectedCommand}"
                ToolTip="{tombLib:Localize ColourTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon Actions/StaticTint}" />
            </Button>
            <Button
                Command="{Binding LockSelectedCommand}"
                ToolTip="{tombLib:Localize LockTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon General/Lock}" />
            </Button>
            <Button
                Command="{Binding LinkSelectedCommand}"
                ToolTip="{tombLib:Localize LinkTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon General/copy_link}" />
            </Button>
            <Button
                Command="{Binding DeleteSelectedNodeCommand}"
                ToolTip="{tombLib:Localize DeleteTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon General/trash}" />
            </Button>
            <Button
                Command="{Binding ExportCommand}"
                ToolTip="{tombLib:Localize ExportTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon General/Export}" />
            </Button>
            <Button
                Command="{Binding ClearNodesCommand}"
                ToolTip="{tombLib:Localize ClearTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon Actions/delete}" />
            </Button>
            <Button
                Command="{Binding FindNodeCommand}"
                ToolTip="{tombLib:Localize FindTooltip}">
                <Image Width="16" Height="16" Source="{tomb:Icon General/search}" />
            </Button>

            <TextBlock VerticalAlignment="Center" Text="{tombLib:Localize CallCount}" />
            <controls:NumericUpDown
                Width="72"
                DecimalPlaces="0"
                Maximum="99999"
                Minimum="0"
                ToolTip="{tombLib:Localize CallCountTooltip}"
                Value="{Binding CallCounter, Mode=TwoWay}" />
        </controls:SpacedStack>

        <!--  Node canvas  -->
        <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
            <ScrollViewer
                x:Name="canvasScroll"
                HorizontalScrollBarVisibility="Auto"
                PreviewMouseWheel="OnPreviewMouseWheel"
                VerticalScrollBarVisibility="Auto">
                <Canvas
                    x:Name="rootCanvas"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    Background="{DynamicResource Brush_Background_Low}"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    MouseMove="Canvas_MouseMove"
                    MouseRightButtonDown="Canvas_MouseRightButtonDown"
                    MouseRightButtonUp="Canvas_MouseRightButtonUp">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="zoomTransform" ScaleX="1" ScaleY="1" />
                    </Canvas.LayoutTransform>

                    <!--  Grid lines (one cell apart, brush created in code from the configured grid step)  -->
                    <Rectangle
                        x:Name="gridRectangle"
                        Width="{Binding CanvasWidth}"
                        Height="{Binding CanvasHeight}"
                        IsHitTestVisible="False" />

                    <!--  Links  -->
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LinkViewModel}">
                                <Path
                                    Data="{Binding Geometry}"
                                    Fill="{Binding Fill}"
                                    IsHitTestVisible="False"
                                    Stroke="{Binding Stroke}"
                                    StrokeThickness="{Binding StrokeThickness}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Rubber-band selection rectangle (under the nodes)  -->
                    <Rectangle
                        x:Name="selectionRectangle"
                        Fill="#804B6EAF"
                        IsHitTestVisible="False"
                        Stroke="{DynamicResource Brush_Selection}"
                        StrokeThickness="2"
                        Visibility="Collapsed" />

                    <!--  Nodes  -->
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:NodeViewModel}">
                                <Grid
                                    Width="{Binding Width}"
                                    PreviewMouseLeftButtonDown="Node_PreviewMouseDown"
                                    SizeChanged="Node_SizeChanged"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:NodeEditorView}}">
                                    <!--  The menu's DataContext is the node; the editor view-model is reached via the placement target's Tag.  -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.SetColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding}"
                                                Header="{tombLib:Localize SetColor}" />
                                            <MenuItem
                                                Header="{tombLib:Localize Locked}"
                                                IsCheckable="True"
                                                IsChecked="{Binding IsLocked, Mode=TwoWay}" />
                                            <Separator />
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding}"
                                                Header="{tombLib:Localize Delete}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!--  Selection highlight: the node color rectangle grown by two pixels  -->
                                    <Border
                                        Margin="-2"
                                        Background="{DynamicResource Brush_Selection}"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                    <!--  Node body, painted in the node color  -->
                                    <Border Background="{Binding BodyBrush}">
                                        <Grid>
                                            <!--  Any free spot of the node drags it  -->
                                            <Thumb DragDelta="NodeThumb_DragDelta" DragStarted="NodeThumb_DragStarted" IsEnabled="{Binding IsEditable}">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>

                                            <!--  Side grip strip  -->
                                            <Border
                                                Height="8"
                                                Margin="3,3,3,0"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource GripStripBrush}"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding ShowGrips, Converter={StaticResource BoolToVis}}" />

                                            <!--  The function the node runs (its primary content) + its arguments  -->
                                            <StackPanel Margin="{Binding ContentMargin}" IsEnabled="{Binding IsEditable}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Text="{tombLib:Localize NoFunctions}"
                                                    TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasNodeFunctions}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemTemplateSelector="{StaticResource ArgSelector}" ItemsSource="{Binding LayoutItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <local:NodeArgumentPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!--  Locked nodes are hatched  -->
                                            <Rectangle
                                                Fill="{StaticResource LockedHatchBrush}"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!--  Node name above the node (a warning when its function is not supported by the event type)  -->
                                    <StackPanel
                                        Margin="0,-20,0,0"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Opacity="0.5"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,4,0"
                                            Foreground="Orange"
                                            Text="&#x26a0;"
                                            Visibility="{Binding IsUnsupported, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding LabelText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!--  Link grips: drag from one to pick up its link, drop on a grip of another node  -->
                                    <Canvas>
                                        <Rectangle
                                            Canvas.Left="{Binding PreviousGrip.Left}"
                                            Canvas.Top="{Binding PreviousGrip.Top}"
                                            Width="{Binding PreviousGrip.Width}"
                                            MouseLeftButtonDown="Grip_MouseDown"
                                            Style="{StaticResource GripBarStyle}"
                                            Tag="Previous"
                                            ToolTip="{tombLib:Localize PortInput}" />
                                        <Rectangle
                                            Canvas.Left="{Binding NextGrip.Left}"
                                            Canvas.Top="{Binding NextGrip.Top}"
                                            Width="{Binding NextGrip.Width}"
                                            MouseLeftButtonDown="Grip_MouseDown"
                                            Style="{StaticResource GripBarStyle}"
                                            Tag="Next"
                                            ToolTip="{tombLib:Localize PortNext}" />
                                        <Rectangle
                                            Canvas.Left="{Binding ElseGrip.Left}"
                                            Canvas.Top="{Binding ElseGrip.Top}"
                                            Width="{Binding ElseGrip.Width}"
                                            MouseLeftButtonDown="Grip_MouseDown"
                                            Style="{StaticResource GripBarStyle}"
                                            Tag="Else"
                                            ToolTip="{tombLib:Localize PortElse}"
                                            Visibility="{Binding IsCondition, Converter={StaticResource BoolToVis}}" />

                                        <!--  "then" and "else" captions under the condition grips  -->
                                        <TextBlock
                                            Canvas.Left="{Binding NextGrip.Left}"
                                            Canvas.Top="{Binding Height}"
                                            Width="{Binding NextGrip.Width}"
                                            IsHitTestVisible="False"
                                            Opacity="0.3"
                                            Text="then"
                                            TextAlignment="Center"
                                            Visibility="{Binding IsCondition, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock
                                            Canvas.Left="{Binding ElseGrip.Left}"
                                            Canvas.Top="{Binding Height}"
                                            Width="{Binding ElseGrip.Width}"
                                            IsHitTestVisible="False"
                                            Opacity="0.3"
                                            Text="else"
                                            TextAlignment="Center"
                                            Visibility="{Binding IsCondition, Converter={StaticResource BoolToVis}}" />
                                    </Canvas>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
