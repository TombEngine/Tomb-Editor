<UserControl
    x:Class="TombEditor.Features.Dialogs.EventSetEditor.LevelScriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:TombEditor.Features.Dialogs.EventSetEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    d:DataContext="{d:DesignInstance Type=local:LevelScriptViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

        <!--  Argument and call count  -->
        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize Argument}" />
            <TextBox
                Grid.Column="1"
                Text="{Binding Argument, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                ToolTip="{tombLib:Localize ArgumentTooltip}" />
            <TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize CallCount}" />
            <controls:NumericUpDown
                Grid.Column="3"
                Width="72"
                DecimalPlaces="0"
                Maximum="99999"
                Minimum="0"
                ToolTip="{tombLib:Localize CallCountTooltip}"
                Value="{Binding CallCounter, Mode=TwoWay}" />
        </Grid>

        <!--  Filter and unassign  -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding HasFunctions, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" Source="{tomb:Icon General/search}" />
            <TextBox
                Grid.Column="1"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{tombLib:Localize SearchTooltip}" />
            <Button
                Grid.Column="2"
                Margin="6,0,0,0"
                Command="{Binding UnassignCommand}"
                Content="{tombLib:Localize Unassign}"
                ToolTip="{tombLib:Localize UnassignTooltip}" />
        </Grid>

        <!--  Function not found in the script  -->
        <TextBlock
            DockPanel.Dock="Bottom"
            Margin="0,6,0,0"
            Foreground="{DynamicResource Brush_Text_Warning}"
            Text="{Binding MissingFunctionText}"
            TextWrapping="Wrap"
            ToolTip="{tombLib:Localize FunctionNotFoundTooltip}"
            Visibility="{Binding HasMissingFunction, Converter={StaticResource BoolToVis}}" />

        <ListBox
            ItemsSource="{Binding FilteredFunctions}"
            SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"
            Visibility="{Binding HasFunctions, Converter={StaticResource BoolToVis}}" />

        <!--  Shown instead of the list when the script is missing or has no functions  -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding HasNotify, Converter={StaticResource BoolToVis}}">
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.7"
                Text="{Binding NotifyText}"
                TextAlignment="Center" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{Binding BrowseCommand}"
                Content="{tombLib:Localize Browse}"
                Visibility="{Binding CanBrowse, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DockPanel>
</UserControl>
