<Window
    x:Class="TombEditor.Features.Dialogs.ImportPrj.ImportPrjWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.ImportPrj"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    Title="{Binding WindowTitle}"
    Width="520"
    d:DataContext="{d:DesignInstance Type=vm:ImportPrjWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <StackPanel Margin="{x:Static darkUI:Defaults.MediumThickness}">

        <GroupBox Header="{tombLib:Localize BaseSoundCatalogGroup}">
            <StackPanel Margin="{x:Static darkUI:Defaults.SmallThickness}">
                <DockPanel>
                    <Button
                        Width="80"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding BrowseSoundsCatalogCommand}"
                        Content="{tombLib:Localize ~Generic.Browse}"
                        DockPanel.Dock="Right" />
                    <TextBox VerticalAlignment="Center" Text="{Binding SoundsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="{DynamicResource Opacity_DisabledContent}"
                    Text="{tombLib:Localize SoundsCatalogTooltip}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <GroupBox Margin="0,8,0,0" Header="{tombLib:Localize ImportSettingsGroup}">
            <StackPanel Margin="{x:Static darkUI:Defaults.SmallThickness}">
                <CheckBox
                    Content="{tombLib:Localize RespectMousepatch}"
                    IsChecked="{Binding RespectMousepatchOnFlybyHandling, Mode=TwoWay}" />
                <TextBlock
                    Margin="20,2,0,8"
                    Opacity="{DynamicResource Opacity_DisabledContent}"
                    Text="{tombLib:Localize RespectMousepatchTooltip}"
                    TextWrapping="Wrap" />
                <CheckBox
                    Content="{tombLib:Localize UseHalfPixelCorrection}"
                    IsChecked="{Binding UseHalfPixelCorrection, Mode=TwoWay}" />
                <TextBlock
                    Margin="20,2,0,0"
                    Opacity="{DynamicResource Opacity_DisabledContent}"
                    Text="{tombLib:Localize UseHalfPixelCorrectionTooltip}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <controls:SpacedStack
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                IsDefault="True" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~Common.Cancel}"
                IsCancel="True" />
        </controls:SpacedStack>
    </StackPanel></Window>
