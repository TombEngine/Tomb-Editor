<Window
    x:Class="TombEditor.Features.Dialogs.SoundSource.SoundSourceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.SoundSource"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    Title="{tombLib:Localize Title}"
    Width="520"
    Height="600"
    
    d:DataContext="{d:DesignInstance Type=vm:SoundSourceWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <controls:SpacedGrid
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="{tombLib:Localize SoundToPlay}">
            <controls:SpacedGrid
                Margin="{x:Static darkUI:Defaults.SmallThickness}"
                ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}"
                RowSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="80"
                    VerticalAlignment="Center"
                    Command="{Binding SearchCommand}"
                    Content="{tombLib:Localize Search}" />

                <ListBox
                    x:Name="soundList"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding Sounds}"
                    SelectedItem="{Binding SelectedSound, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding ConfirmCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ListBox>

                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="{tombLib:Localize PlayMode}"
                        Target="{Binding ElementName=playModeComboBox}" />
                    <ComboBox
                        x:Name="playModeComboBox"
                        Grid.Column="1"
                        Margin="{x:Static darkUI:Defaults.SmallThickness}"
                        VerticalAlignment="Center"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding PlayModes}"
                        SelectedItem="{Binding SelectedPlayMode, Mode=TwoWay}" />
                    <Button
                        Grid.Column="2"
                        Width="100"
                        VerticalAlignment="Center"
                        Command="{Binding PlayCommand}"
                        Content="{tombLib:Localize PlaySound}" />
                </Grid>
            </controls:SpacedGrid>
        </GroupBox>

        <controls:SpacedStack
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                IsDefault="True" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~Common.Cancel}"
                IsCancel="True" />
        </controls:SpacedStack>
    </controls:SpacedGrid>
</Window>
