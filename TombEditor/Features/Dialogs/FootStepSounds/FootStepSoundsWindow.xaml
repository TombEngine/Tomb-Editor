<Window
    x:Class="TombEditor.Features.Dialogs.FootStepSounds.FootStepSoundsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:TombEditor.Features.Dialogs.FootStepSounds"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    Title="{tombLib:Localize Title}"
    Width="440"
    Height="600"
    MinWidth="380"
    MinHeight="420"
    d:DataContext="{d:DesignInstance Type=local:FootStepSoundsWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <controls:SpacedGrid
        Margin="{x:Static darkUI:Defaults.MediumThickness}"
        RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
<Button Style="{DynamicResource ButtonWithIconOnly}" Width="23" Margin="2,0,0,0" Command="{x:Static tombLib:ComboSearch.OpenCommand}" CommandParameter="{Binding ElementName=textureCombo}" DockPanel.Dock="Right" ToolTip="Search"><Image Width="16" Height="16" Source="{tomb:Icon General/search}" /></Button>
<controls:SearchableComboBox
            x:Name="textureCombo"
            ItemsSource="{Binding Textures}"
            KeyboardNavigation.TabIndex="22"
            SelectedItem="{Binding SelectedTexture, Mode=TwoWay}" />
</DockPanel>

        <local:FootStepSoundsTextureMapView
            x:Name="mapView"
            Grid.Row="1"
            KeyboardNavigation.TabIndex="0" />

        <controls:SpacedGrid
            Grid.Row="2"
            ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Grid.Column="0"
                VerticalAlignment="Center"
                ItemsSource="{Binding SoundTypes}"
                KeyboardNavigation.TabIndex="1"
                SelectedIndex="{Binding SelectedSoundIndex, Mode=TwoWay}" />

            <Button
                Grid.Column="1"
                Width="100"
                Command="{Binding AssignSoundCommand}"
                Content="{tombLib:Localize AssignSound}"
                IsEnabled="{Binding CanAssign}"
                KeyboardNavigation.TabIndex="2" />

            <Button
                Grid.Column="2"
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{tombLib:Localize ~Common.OK}"
                IsCancel="True"
                IsDefault="True"
                KeyboardNavigation.TabIndex="3" />
        </controls:SpacedGrid>
    </controls:SpacedGrid>
</Window>
