<Window
    x:Class="WadTool.Features.Dialogs.StaticEditor.StaticEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:WadTool.Features.Dialogs.StaticEditor"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Width="900"
    Height="765"
    MinWidth="900"
    MinHeight="765"
    d:DataContext="{d:DesignInstance Type=local:StaticEditorWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Style BasedOn="{StaticResource {x:Type controls:NumericUpDown}}" TargetType="controls:NumericUpDown">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Minimum" Value="-65535" />
            <Setter Property="Maximum" Value="65535" />
            <Setter Property="DecimalPlaces" Value="0" />
        </Style>
        <Style x:Key="AxisLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">


        <!--  Footer: mesh import/export + OK / Cancel  -->
        <controls:SpacedStack
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <controls:SpacedStack.Margin>
                <Thickness Top="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
            </controls:SpacedStack.Margin>
            <Button
                Width="60"
                Command="{Binding ImportMeshCommand}"
                Content="{tombLib:Localize ~WadTool.StaticEditor.Import}" />
            <Button
                Width="60"
                Command="{Binding ExportMeshCommand}"
                Content="{tombLib:Localize ~WadTool.StaticEditor.Export}" />
            <Button
                Width="60"
                Command="{Binding SaveCommand}"
                Content="{tombLib:Localize ~WadTool.StaticEditor.OK}" />
            <Button
                Width="60"
                Command="{Binding CancelCommand}"
                Content="{tombLib:Localize ~WadTool.StaticEditor.Cancel}" />
        </controls:SpacedStack>

        <!--  Right column: editing controls  -->
        <controls:SpacedStack
            Width="240"
            DockPanel.Dock="Right"
            Orientation="Vertical"
            Spacing="10">
            <controls:SpacedStack.Margin>
                <Thickness Left="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
            </controls:SpacedStack.Margin>

                <!--  Transform  -->
                <GroupBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.PosX}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.PosY}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.PosZ}" />
                        <controls:NumericUpDown Grid.Row="1" Value="{Binding PositionX, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PositionY, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding PositionZ, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.Reset}" />
                        <Button Grid.Row="3" Command="{Binding ResetTranslationCommand}" Content="{tombLib:Localize ~WadTool.StaticEditor.Translation}" />
                        <Button Grid.Row="3" Grid.Column="1" Command="{Binding ResetRotationCommand}" Content="{tombLib:Localize ~WadTool.StaticEditor.Rotation}" />
                        <Button Grid.Row="3" Grid.Column="2" Command="{Binding ResetScaleCommand}" Content="{tombLib:Localize ~WadTool.StaticEditor.Scale}" />
                    </Grid>
                </GroupBox>

                <!--  Visibility Box  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox VerticalAlignment="Center" Content="{tombLib:Localize ~WadTool.StaticEditor.VisibilityBox}" IsChecked="{Binding DrawVisibilityBox, Mode=TwoWay}" />
                        <StackPanel
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Width="56"
                                Command="{Binding ClearVisibilityBoxCommand}"
                                Content="{tombLib:Localize ~WadTool.StaticEditor.Clear}" />
                            <Button
                                Width="72"
                                Margin="6,0,0,0"
                                Command="{Binding CalculateVisibilityBoxCommand}"
                                Content="{tombLib:Localize ~WadTool.StaticEditor.Calculate}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.XMin}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.YMin}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.ZMin}" />
                        <controls:NumericUpDown Grid.Row="2" Value="{Binding VisBoxMinX, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding VisBoxMinY, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding VisBoxMinZ, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.XMax}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.YMax}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.ZMax}" />
                        <controls:NumericUpDown Grid.Row="4" Value="{Binding VisBoxMaxX, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding VisBoxMaxY, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="4" Grid.Column="2" Value="{Binding VisBoxMaxZ, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  Collision Box  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox VerticalAlignment="Center" Content="{tombLib:Localize ~WadTool.StaticEditor.CollisionBox}" IsChecked="{Binding DrawCollisionBox, Mode=TwoWay}" />
                        <StackPanel
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Width="56"
                                Command="{Binding ClearCollisionBoxCommand}"
                                Content="{tombLib:Localize ~WadTool.StaticEditor.Clear}" />
                            <Button
                                Width="72"
                                Margin="6,0,0,0"
                                Command="{Binding CalculateCollisionBoxCommand}"
                                Content="{tombLib:Localize ~WadTool.StaticEditor.Calculate}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.XMin}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.YMin}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.ZMin}" />
                        <controls:NumericUpDown Grid.Row="2" Value="{Binding ColBoxMinX, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ColBoxMinY, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding ColBoxMinZ, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.XMax}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.YMax}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.ZMax}" />
                        <controls:NumericUpDown Grid.Row="4" Value="{Binding ColBoxMaxX, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding ColBoxMaxY, Mode=TwoWay}" />
                        <controls:NumericUpDown Grid.Row="4" Grid.Column="2" Value="{Binding ColBoxMaxZ, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  Shatter  -->
                <GroupBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="{tombLib:Localize ~WadTool.StaticEditor.Shatter}"
                            IsChecked="{Binding Shatter, Mode=TwoWay}"
                            IsEnabled="{Binding ShatterControlsEnabled}" />
                        <Button
                            Grid.Column="1"
                            Width="120"
                            Command="{Binding ResetShatterAttributesCommand}"
                            Content="{tombLib:Localize ~WadTool.StaticEditor.ResetToDefault}"
                            IsEnabled="{Binding ShatterControlsEnabled}" />
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <Button
                                Width="28"
                                DockPanel.Dock="Right"
                                Command="{Binding PlaySoundCommand}"
                                IsEnabled="{Binding PlayEnabled}">
                                <Image Width="16" Height="16" Source="{tomb:Icon Actions/Transport/Play}" />
                            </Button>
                            <Button Width="23" Height="23" Margin="4,0,4,0" Padding="0" Click="ShatterSearch_Click" DockPanel.Dock="Right" IsEnabled="{Binding SoundEnabled}" ToolTip="{tombLib:Localize ~WadTool.StaticEditor.Search}"><Image Width="16" Height="16" Source="{tomb:Icon General/search}" /></Button>
                            <controls:SearchableComboBox x:Name="shatterSoundCombo"
                                IsEnabled="{Binding SoundEnabled}"
                                ItemsSource="{Binding SoundIds}"
                                SelectedIndex="{Binding SoundIdIndex, Mode=TwoWay}" />
                        </DockPanel>
                    </Grid>
                </GroupBox>

                <!--  Lighting and mesh  -->
                <GroupBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.ColumnSpan="2">
                            <Button
                                Width="28"
                                DockPanel.Dock="Right"
                                Command="{Binding DeleteLightCommand}"
                                IsEnabled="{Binding DeleteLightEnabled}">
                                <Image Width="16" Height="16" Source="{tomb:Icon General/trash}" />
                            </Button>
                            <Button
                                Width="28"
                                Margin="4,0"
                                DockPanel.Dock="Right"
                                Command="{Binding AddLightCommand}"
                                IsEnabled="{Binding AddLightEnabled}">
                                <Image Width="16" Height="16" Source="{tomb:Icon General/plus_math}" />
                            </Button>
                            <ComboBox SelectedIndex="{Binding LightingTypeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{tombLib:Localize ~WadTool.StaticEditor.DynamicLighting}" />
                                <ComboBoxItem Content="{tombLib:Localize ~WadTool.StaticEditor.StaticLighting}" />
                            </ComboBox>
                        </DockPanel>
                        <ListBox
                            Grid.Row="1"
                            Width="90"
                            Height="136"
                            Margin="0,4,6,0"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding LightsEnabled}"
                            ItemsSource="{Binding Lights}"
                            SelectedItem="{Binding SelectedLight, Mode=TwoWay}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.Intensity}" />
                                <controls:NumericUpDown
                                    Grid.Column="1"
                                    Margin="4,0,0,2"
                                    DecimalPlaces="2"
                                    Increment="0.03"
                                    IsEnabled="{Binding IntensityEnabled}" TextAlignment="Right"
                                    LargeIncrement="0.12"
                                    Maximum="128"
                                    Minimum="-128"
                                    Value="{Binding Intensity, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.Radius}" />
                                <controls:NumericUpDown
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="4,0,0,2"
                                    DecimalPlaces="2"
                                    Increment="0.03"
                                    IsEnabled="{Binding RadiusEnabled}" TextAlignment="Right"
                                    LargeIncrement="1.0"
                                    Maximum="256"
                                    Minimum="0"
                                    Value="{Binding Radius, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.Ambient}" />
                                <controls:NumericUpDown
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="4,0,0,2"
                                    IsEnabled="{Binding AmbientEnabled}" TextAlignment="Right"
                                    Maximum="255"
                                    Minimum="0"
                                    Value="{Binding Ambient, Mode=TwoWay}" />
                            </Grid>
                            <Button Margin="0,4,0,0" Command="{Binding RecalculateNormalsCommand}" Content="{tombLib:Localize ~WadTool.StaticEditor.RecalculateNormals}" />
                            <Button Margin="0,4,0,0" Command="{Binding EditMeshCommand}" Content="{tombLib:Localize ~WadTool.StaticEditor.EditMesh}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!--  Draw options  -->
                <GroupBox>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AxisLabel}" Text="{tombLib:Localize ~WadTool.StaticEditor.Draw}" />
                        <controls:SpacedStack Margin="0,2,0,0" Orientation="Horizontal" Spacing="8">
                            <CheckBox Content="{tombLib:Localize ~WadTool.StaticEditor.Lights}" IsChecked="{Binding DrawLights, Mode=TwoWay}" />
                            <CheckBox Content="{tombLib:Localize ~WadTool.StaticEditor.Gizmo}" IsChecked="{Binding DrawGizmo, Mode=TwoWay}" />
                            <CheckBox Content="{tombLib:Localize ~WadTool.StaticEditor.Grid}" IsChecked="{Binding DrawGrid, Mode=TwoWay}" />
                            <CheckBox Content="{tombLib:Localize ~WadTool.StaticEditor.Normals}" IsChecked="{Binding DrawNormals, Mode=TwoWay}" />
                        </controls:SpacedStack>
                    </StackPanel>
                </GroupBox>
        </controls:SpacedStack>

        <!--  The 3D view is the legacy previous PanelRenderingStaticEditor, hosted as-is.  -->
        <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
            <Border x:Name="renderingHost" />
        </Border>
    </DockPanel>
</Window>
