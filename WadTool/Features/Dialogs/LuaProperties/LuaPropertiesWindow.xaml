<Window
    x:Class="WadTool.Features.Dialogs.LuaProperties.LuaPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:views="clr-namespace:TombLib.WPF.Views;assembly=TombLib.WPF"
    xmlns:vm="clr-namespace:WadTool.Features.Dialogs.LuaProperties"
    Title="{tombLib:Localize Title}"
    Width="624"
    Height="484"
    MinWidth="500"
    MinHeight="350"
    d:DataContext="{d:DesignInstance Type=vm:LuaPropertiesWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <controls:SpacedGrid Margin="{x:Static darkUI:Defaults.MediumThickness}" RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!--  Object list (moveables + statics)  -->
            <ListBox
                x:Name="objectsList"
                Grid.Column="0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Objects}"
                SelectedItem="{Binding SelectedObject, Mode=TwoWay}" />

            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <!--  Property grid for the selected object  -->
            <views:LuaPropertyGridControl Grid.Column="2" DataContext="{Binding PropertyGrid}" />
        </Grid>

        <Grid Grid.Row="1">
            <Button
                Width="80"
                HorizontalAlignment="Left"
                Command="{Binding ResetAllCommand}"
                Content="{tombLib:Localize ResetAll}" />

            <controls:SpacedStack
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
                <Button
                    Width="80"
                    Command="{Binding ConfirmCommand}"
                    Content="{tombLib:Localize ~Common.OK}"
                    IsDefault="True" />
                <Button
                    Width="80"
                    Command="{Binding CancelCommand}"
                    Content="{tombLib:Localize ~Common.Cancel}"
                    IsCancel="True" />
            </controls:SpacedStack>
        </Grid>
    </controls:SpacedGrid>
</Window>
