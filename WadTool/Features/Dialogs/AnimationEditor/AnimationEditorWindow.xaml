<Window
    x:Class="WadTool.Features.Dialogs.AnimEditor.AnimationEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:WadTool.Features.Dialogs.AnimEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLibControls="clr-namespace:TombLib.WPF.CustomControls;assembly=TombLib.WPF"
    xmlns:wadControls="clr-namespace:WadTool.Controls"
    Title="{Binding Title}"
    Width="1055"
    Height="834"
    MinWidth="906"
    MinHeight="699"
    d:DataContext="{d:DesignInstance Type=local:AnimationEditorWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
        </Style>
        <Style x:Key="Nud" BasedOn="{StaticResource {x:Type controls:NumericUpDown}}" TargetType="controls:NumericUpDown">
            <EventSetter Event="LostKeyboardFocus" Handler="OnParameterLostFocus" />
            <Setter Property="DecimalPlaces" Value="0" />
            <Setter Property="Minimum" Value="-1000000" />
            <Setter Property="Maximum" Value="1000000" />
        </Style>
        <Style x:Key="Axis" BasedOn="{StaticResource {x:Type controls:NumericUpDown}}" TargetType="controls:NumericUpDown">
            <Setter Property="DecimalPlaces" Value="4" />
            <Setter Property="Minimum" Value="-32768" />
            <Setter Property="Maximum" Value="32767" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!--  Icon toolbar button (16px icon, like the legacy topBar)  -->
        <Style
            x:Key="TbBtn"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TbImg" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style x:Key="TbLbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
        </Style>
        <Style x:Key="TbSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="3,3" />
            <Setter Property="Background" Value="{DynamicResource Brush_Border}" />
        </Style>
        <!--  Transport button (24px icon, like the legacy transport strip)  -->
        <Style
            x:Key="TransportBtn"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="33" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style
            x:Key="TransportToggle"
            BasedOn="{StaticResource {x:Type ToggleButton}}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="33" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TransportImg" TargetType="Image">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <!--  Section panel like the WinForms DarkSectionPanel: a header band over the content, no frame  -->
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <DockPanel>
                            <Border Padding="4,3" Background="{DynamicResource Brush_BackgroundSlightlyDark}" DockPanel.Dock="Top">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource Brush_Text}" />
                            </Border>
                            <Border Padding="4">
                                <ContentPresenter />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!--  Menu bar (mirrors the legacy top menu)  -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Edit">
                <MenuItem Command="{Binding UndoCommand}" Header="Undo" InputGestureText="Ctrl+Z"><MenuItem.Icon><Image Source="{tomb:Icon General/undo}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding RedoCommand}" Header="Redo" InputGestureText="Ctrl+Y"><MenuItem.Icon><Image Source="{tomb:Icon General/redo}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding SaveCommand}" Header="Save changes" InputGestureText="Ctrl+S"><MenuItem.Icon><Image Source="{tomb:Icon General/Save}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding CancelCommand}" Header="Close" />
            </MenuItem>
            <MenuItem Header="Animations">
                <MenuItem Command="{Binding AddAnimationCommand}" Header="New animation"><MenuItem.Icon><Image Source="{tomb:Icon General/plus_math}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding DeleteAnimationCommand}" Header="Delete animation"><MenuItem.Icon><Image Source="{tomb:Icon General/trash}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding SplitAnimationCommand}" Header="Split animation"><MenuItem.Icon><Image Source="{tomb:Icon Actions/Split_WadTool}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding CutAnimationCommand}" Header="Cut"><MenuItem.Icon><Image Source="{tomb:Icon Actions/cut}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding CopyAnimationCommand}" Header="Copy"><MenuItem.Icon><Image Source="{tomb:Icon General/copy}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding PasteAnimationCommand}" Header="Paste"><MenuItem.Icon><Image Source="{tomb:Icon General/paste}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding ImportAnimationCommand}" Header="Import..."><MenuItem.Icon><Image Source="{tomb:Icon General/Import}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding ExportAnimationCommand}" Header="Export..."><MenuItem.Icon><Image Source="{tomb:Icon General/Export}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Batch">
                    <MenuItem Command="{Binding BatchImportCommand}" Header="Import..." />
                    <MenuItem Command="{Binding BatchExportSelectedCommand}" Header="Export selected..." />
                    <MenuItem Command="{Binding BatchExportAllCommand}" Header="Export all..." />
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding ResampleAnimationCommand}" Header="Resample animation"><MenuItem.Icon><Image Source="{tomb:Icon Actions/interpolate}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding ResampleAnimationToFramerateCommand}" Header="Resample animation to framerate" />
                <MenuItem Command="{Binding MirrorCommand}" Header="Mirror animation"><MenuItem.Icon><Image Source="{tomb:Icon General/Mirror}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding ReverseCommand}" Header="Reverse animation" />
                <Separator />
                <MenuItem Header="Fix">
                    <MenuItem Command="{Binding FixCurrentAnimationCommand}" Header="Current animation..." />
                    <MenuItem Command="{Binding FixSelectedAnimationsCommand}" Header="Selected animations..." />
                    <MenuItem Command="{Binding FixAllAnimationsCommand}" Header="All animations..." />
                </MenuItem>
                <MenuItem Command="{Binding FindReplaceAnimCommandsCommand}" Header="Find &amp; replace animcommands..."><MenuItem.Icon><Image Source="{tomb:Icon General/Find-and-replace}" /></MenuItem.Icon></MenuItem>
            </MenuItem>
            <MenuItem Header="Frames">
                <MenuItem Command="{Binding AddFrameCommand}" Header="Insert frame after current one"><MenuItem.Icon><Image Source="{tomb:Icon General/plus_math}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding InsertFramesAfterCurrentCommand}" Header="Insert (n) frames after current one" />
                <MenuItem Command="{Binding DeleteFrameCommand}" Header="Delete frames" InputGestureText="Del"><MenuItem.Icon><Image Source="{tomb:Icon General/trash}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding DeleteEveryNthFrameCommand}" Header="Delete every (n)th frame" />
                <Separator />
                <MenuItem Command="{Binding CutFrameCommand}" Header="Cut" InputGestureText="Ctrl+X"><MenuItem.Icon><Image Source="{tomb:Icon Actions/cut}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding CopyFrameCommand}" Header="Copy" InputGestureText="Ctrl+C"><MenuItem.Icon><Image Source="{tomb:Icon General/copy}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding PasteFrameCommand}" Header="Paste" InputGestureText="Ctrl+V"><MenuItem.Icon><Image Source="{tomb:Icon General/paste}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding InterpolateCommand}" Header="Interpolate frames" InputGestureText="Ctrl+I"><MenuItem.Icon><Image Source="{tomb:Icon Actions/interpolate}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding CalculateCurrentFrameBoundingBoxCommand}" Header="Calculate bounding box"><MenuItem.Icon><Image Source="{tomb:Icon General/box}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding DeleteCurrentFrameBoundingBoxCommand}" Header="Delete bounding box" />
            </MenuItem>
            <MenuItem Header="Rendering">
                <MenuItem Header="Draw gizmo" IsCheckable="True" IsChecked="{Binding ShowGizmo, Mode=TwoWay}" />
                <MenuItem Header="Draw grid" IsCheckable="True" IsChecked="{Binding ShowGrid, Mode=TwoWay}" />
                <MenuItem Header="Draw collision box" IsCheckable="True" IsChecked="{Binding ShowCollisionBox, Mode=TwoWay}" />
                <MenuItem Header="Draw skinned mesh" IsCheckable="True" IsChecked="{Binding ShowSkin, Mode=TwoWay}" Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />
                <Separator />
                <MenuItem Header="Smooth animation" IsCheckable="True" IsChecked="{Binding SmoothAnimation, Mode=TwoWay}" />
                <MenuItem Header="Scroll grid" IsCheckable="True" IsChecked="{Binding ScrollGrid, Mode=TwoWay}" />
                <MenuItem Header="Restore grid height" IsCheckable="True" IsChecked="{Binding RestoreGridHeight, Mode=TwoWay}" />
            </MenuItem>
        </Menu>

            <Border
                Margin="0,0,0,4"
                Padding="2"
                Background="{DynamicResource Brush_BackgroundSlightlyDark}"
                DockPanel.Dock="Top">
                <DockPanel LastChildFill="True">
                    <controls:SpacedStack
                        DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button Style="{StaticResource TbBtn}" Command="{Binding SaveCommand}" ToolTip="Save all changes"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Save}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding UndoCommand}" ToolTip="Undo"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/undo}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding RedoCommand}" ToolTip="Redo"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/redo}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding ResetCameraCommand}" ToolTip="Reset camera"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/target}" /></Button>
                        <Border Style="{StaticResource TbSep}" />
                        <TextBlock Style="{StaticResource TbLbl}" Text="Anims:" />
                        <Button Style="{StaticResource TbBtn}" Command="{Binding AddAnimationCommand}" ToolTip="Add animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/plus_math}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding ImportAnimationCommand}" ToolTip="Import..."><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Import}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding DeleteAnimationCommand}" ToolTip="Delete animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/trash}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CutAnimationCommand}" ToolTip="Cut animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/cut}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CopyAnimationCommand}" ToolTip="Copy animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/copy}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding PasteAnimationCommand}" ToolTip="Paste animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/paste}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding ReplaceAnimationCommand}" ToolTip="Replace animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/paste-new}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding SplitAnimationCommand}" ToolTip="Split animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/Split_WadTool}" /></Button>
                        <Border Style="{StaticResource TbSep}" />
                        <TextBlock Style="{StaticResource TbLbl}" Text="Frames:" />
                        <Button Style="{StaticResource TbBtn}" Command="{Binding AddFrameCommand}" ToolTip="Add frame"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/plus_math}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding DeleteFrameCommand}" ToolTip="Delete frames"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/trash}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CutFrameCommand}" ToolTip="Cut frames"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/cut}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CopyFrameCommand}" ToolTip="Copy frames"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/copy}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding PasteFrameCommand}" ToolTip="Paste frames"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/paste}" /></Button>
                        </controls:SpacedStack>
                    
                </DockPanel>
            </Border>

        <DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

        <Border Height="25" Padding="4,5,0,3" Background="{DynamicResource Brush_Background}" DockPanel.Dock="Bottom">
            <TextBlock FontSize="11" Foreground="{DynamicResource Brush_Text}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
        </Border>

        <!--  Status line, then timeline with the transport buttons on its right (WinForms arrangement)  -->
        
        <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Height="36"
                Grid.Column="0"
                Margin="0,2,0,0">
                <tombLibControls:AnimationTrackBar x:Name="timeline">
                    <tombLibControls:AnimationTrackBar.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding MarkInCommand}" Header="Mark in" InputGestureText="I" />
                            <MenuItem Command="{Binding MarkOutCommand}" Header="Mark out" InputGestureText="O" />
                            <MenuItem Command="{Binding SelectAllCommand}" Header="Select all" InputGestureText="Ctrl+A" />
                            <MenuItem Command="{Binding ClearSelectionCommand}" Header="Clear selection" />
                            <Separator />
                            <MenuItem Command="{Binding CreateAnimCommandCommand}" Header="Create anim command..." />
                            <MenuItem Command="{Binding CreateStateChangeCommand}" Header="Create state change..." />
                        </ContextMenu>
                    </tombLibControls:AnimationTrackBar.ContextMenu>
                </tombLibControls:AnimationTrackBar>
            </Border>
            <controls:SpacedStack Grid.Column="1" Width="247" Margin="0,2,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="0">
                    <Button Style="{StaticResource TransportBtn}" Command="{Binding GotoStartCommand}" ToolTip="Go to start"><Image Style="{StaticResource TransportImg}" Source="{tomb:Icon Actions/Transport/Start}" /></Button>
                    <Button Style="{StaticResource TransportBtn}" Command="{Binding GotoPrevCommand}" ToolTip="Back 1 frame"><Image Style="{StaticResource TransportImg}" Source="{tomb:Icon Actions/Transport/FrameBack}" /></Button>
                    <Button Style="{StaticResource TransportBtn}" Command="{Binding PlayCommand}" ToolTip="Playback">
                        <Image>
                            <Image.Style>
                                <Style BasedOn="{StaticResource TransportImg}" TargetType="Image">
                                    <Setter Property="Source" Value="{tomb:Icon Actions/Transport/Play24}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transport/Stop}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                    <Button Style="{StaticResource TransportBtn}" Command="{Binding GotoNextCommand}" ToolTip="Forward 1 frame"><Image Style="{StaticResource TransportImg}" Source="{tomb:Icon Actions/Transport/FrameForward}" /></Button>
                    <Button Style="{StaticResource TransportBtn}" Command="{Binding GotoEndCommand}" ToolTip="Go to end"><Image Style="{StaticResource TransportImg}" Source="{tomb:Icon Actions/Transport/End}" /></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <ToggleButton Style="{StaticResource TransportToggle}" IsChecked="{Binding ChainPlayback, Mode=TwoWay}" ToolTip="Chain playback">
                        <Image>
                            <Image.Style>
                                <Style BasedOn="{StaticResource TransportImg}" TargetType="Image">
                                    <Setter Property="Source" Value="{tomb:Icon Actions/Transport/ChainDisabled}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChainPlayback}" Value="True">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transport/ChainEnabled}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </ToggleButton>
                    <ToggleButton
                        Style="{StaticResource TransportToggle}"
                        Command="{Binding ToggleSoundCommand}"
                        IsEnabled="{Binding RoomsEnabled}"
                        IsChecked="{Binding SoundPreview, Mode=OneWay}"
                        ToolTip="Toggle sound preview">
                        <Image>
                            <Image.Style>
                                <Style BasedOn="{StaticResource TransportImg}" TargetType="Image">
                                    <Setter Property="Source" Value="{tomb:Icon Actions/Transport/Mute}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoundPreview}" Value="True">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transport/Audio}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </ToggleButton>
                    <Button
                        Style="{StaticResource TransportBtn}"
                        Command="{Binding CycleSoundConditionCommand}"
                        IsEnabled="{Binding RoomsEnabled}"
                        ToolTip="{Binding SoundConditionToolTip}">
                        <Image>
                            <Image.Style>
                                <Style BasedOn="{StaticResource TransportImg}" TargetType="Image">
                                    <Setter Property="Source" Value="{tomb:Icon Actions/Transport/OnNothing}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoundConditionLabel}" Value="LandWithMaterial">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transport/OnLand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SoundConditionLabel}" Value="Water">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transport/InShallowWater}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SoundConditionLabel}" Value="Quicksand">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transport/Sand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SoundConditionLabel}" Value="Underwater">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transport/Underwater}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                </controls:SpacedStack>
        </Grid>
        <!--  Left: animation list, current animation, blending (WinForms order)  -->
        <Grid Width="270" DockPanel.Dock="Left" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        <GroupBox
            
            Grid.Row="0"
            Header="Animation List">
            
            <DockPanel>
                <!--  Filter  -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource TbBtn}"
                        Margin="2,0,0,0"
                        Command="{Binding ResetFilterCommand}"
                        ToolTip="Reset filtering">
                        <Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/delete}" />
                    </Button>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource TbBtn}"
                        Margin="2,0,0,0"
                        Command="{Binding ApplyFilterCommand}"
                        ToolTip="Filter list.&#13;&#10;Numerical input - filter by state ID&#13;&#10;String input - filter by name">
                        <Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/filter}" />
                    </Button>
                    <TextBox
                        VerticalContentAlignment="Center"
                        Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Numerical input - filter by state ID.&#13;&#10;String input - filter by animation name.&#13;&#10;&#13;&#10;Tokens:&#13;&#10;s:[name or ID] - state name or ID&#13;&#10;a:[name or ID] - anim name or ID">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ApplyFilterCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <!--  Add / delete  -->
                <controls:SpacedStack
                    DockPanel.Dock="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button Style="{StaticResource TbBtn}" Command="{Binding AddAnimationCommand}" ToolTip="Add new animation"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/plus_math}" /></Button>
                    <Button Style="{StaticResource TbBtn}" Command="{Binding DeleteSelectedAnimationsCommand}" ToolTip="Delete selected animations"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/trash}" /></Button>
                </controls:SpacedStack>

                <ListBox
                    x:Name="animationList"
                    PreviewMouseLeftButtonUp="OnAnimationListClick"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding Animations}"
                    SelectedItem="{Binding SelectedAnim, Mode=TwoWay}"
                    SelectionMode="Extended" />
            </DockPanel>
        </GroupBox>
                <GroupBox Grid.Row="1" Margin="0,6,0,0" Header="Current Animation">
                    <StackPanel>
                        <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLbl}" Text="Name:" /><TextBox x:Name="animationNameBox" KeyDown="OnParameterKeyDown" LostKeyboardFocus="OnParameterLostFocus" Text="{Binding AnimName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLbl}" Text="State:" /><ComboBox Width="24" DockPanel.Dock="Right" IsTextSearchEnabled="False" PreviewMouseWheel="StateCombo_PreviewMouseWheel" ItemsSource="{Binding StateNameChoices}" SelectedItem="{Binding SelectedStateName, Mode=TwoWay}" ToolTip="Known state names" /><controls:AutoCompleteBox x:Name="stateIdBox" ItemsSource="{Binding StateNames}" Text="{Binding StateIdText, Mode=TwoWay}" ToolTip="{Binding StateIdToolTip}" /></DockPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="Framerate" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="1" Maximum="255" Value="{Binding FrameRate, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="End frame" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="32767" Value="{Binding EndFrame, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="Next anim" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="32767" Value="{Binding NextAnimation, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="Next frame" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="32767" Value="{Binding NextFrame, Mode=TwoWay}" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="Start X vel" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding StartVertVel, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="End X vel" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding EndVertVel, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="Start Z vel" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding StartHorVel, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="2,0"><TextBlock Foreground="{DynamicResource Brush_Text_Low}" Text="End Z vel" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding EndHorVel, Mode=TwoWay}" /></StackPanel>
                        </Grid>
                        <UniformGrid Margin="0,8,0,0" Columns="2">
                            <Button Margin="0,0,3,0" Command="{Binding EditStateChangesCommand}" Content="State changes..." />
                            <Button Margin="3,0,0,0" Command="{Binding EditAnimCommandsCommand}" Content="Anim commands..." />
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Row="2" Margin="0,6,0,0" Header="Animation Blending" Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush_Text_Low}" Text="Next anim blend frame count:" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="255" Value="{Binding BlendFrameCount, Mode=TwoWay}" /></DockPanel>
                        <Border Height="110" Margin="0,6,0,0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                            <wadControls:BezierCurveEditor x:Name="bezierEditor" />
                        </Border>
                        <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Text="Preset:" /><ComboBox SelectedIndex="{Binding BlendPresetIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Linear" />
                            <ComboBoxItem Content="Ease In" />
                            <ComboBoxItem Content="Ease Out" />
                            <ComboBoxItem Content="Ease In and Out" />
                        </ComboBox></DockPanel>
                    </StackPanel>
                </GroupBox>
        </Grid>

        <!--  Right: skeleton, transform, root motion, bounding box (WinForms order)  -->
        <ScrollViewer
            Width="300"
            DockPanel.Dock="Right"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Margin>
                <Thickness Left="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
            </ScrollViewer.Margin>
            <controls:SpacedStack Orientation="Vertical" Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
                <GroupBox Header="Skeleton">
                    <DataGrid
                        Height="160"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding Bones}"
                        MouseDoubleClick="OnBoneListDoubleClick"
                        SelectedItem="{Binding SelectedBoneItem, Mode=TwoWay}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" Header="Use">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Mesh" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="{Binding TransformHeader}">
                    <StackPanel>
                        
                                                <controls:SpacedGrid Margin="0,6,0,0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Val}" Text="Rot" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Val}" Text="Y" />
                            <controls:NumericUpDown Grid.Column="2" Style="{StaticResource Axis}" Minimum="0" Maximum="360" LoopValues="True" Value="{Binding RotationY, Mode=TwoWay}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Val}" Text="P" />
                            <controls:NumericUpDown Grid.Column="4" Style="{StaticResource Axis}" Minimum="0" Maximum="360" LoopValues="True" Value="{Binding RotationX, Mode=TwoWay}" />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource Val}" Text="R" />
                            <controls:NumericUpDown Grid.Column="6" Style="{StaticResource Axis}" Minimum="0" Maximum="360" LoopValues="True" Value="{Binding RotationZ, Mode=TwoWay}" />
                        </controls:SpacedGrid>
                        <controls:SpacedGrid Margin="0,4,0,0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Val}" Text="Pos" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Val}" Text="X" />
                            <controls:NumericUpDown Grid.Column="2" Style="{StaticResource Axis}" Value="{Binding TranslationX, Mode=TwoWay}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Val}" Text="Y" />
                            <controls:NumericUpDown Grid.Column="4" Style="{StaticResource Axis}" Value="{Binding TranslationY, Mode=TwoWay}" />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource Val}" Text="Z" />
                            <controls:NumericUpDown Grid.Column="6" Style="{StaticResource Axis}" Value="{Binding TranslationZ, Mode=TwoWay}" />
                        </controls:SpacedGrid>
                    <DockPanel Margin="0,6,0,0">
                            <Image
                                Width="75"
                                Height="21"
                                Margin="6,0,0,0"
                                DockPanel.Dock="Right"
                                RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="{tomb:Icon Actions/Transform/Simple}" />
                                        <Style.Triggers>
                                        <DataTrigger Binding="{Binding TransformModeIndex}" Value="1">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transform/Smooth}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TransformModeIndex}" Value="2">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transform/SmoothReverse}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TransformModeIndex}" Value="3">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transform/Linear}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TransformModeIndex}" Value="4">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transform/LinearReverse}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TransformModeIndex}" Value="5">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transform/Symmetric}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TransformModeIndex}" Value="6">
                                            <Setter Property="Source" Value="{tomb:Icon Actions/Transform/SymmetricLinear}" />
                                        </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <ComboBox SelectedIndex="{Binding TransformModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Smooth" />
                                <ComboBoxItem Content="Smooth reverse" />
                                <ComboBoxItem Content="Linear" />
                                <ComboBoxItem Content="Linear reverse" />
                                <ComboBoxItem Content="Symmetric smooth" />
                                <ComboBoxItem Content="Symmetric linear" />
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Root Motion" Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}">
                    <controls:SpacedStack Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Val}" Text="Pos:" />
                        <CheckBox Content="X" IsChecked="{Binding RootPosX, Mode=TwoWay}" />
                        <CheckBox Content="Y" IsChecked="{Binding RootPosY, Mode=TwoWay}" />
                        <CheckBox Content="Z" IsChecked="{Binding RootPosZ, Mode=TwoWay}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Val}" Text="Rot:" />
                        <CheckBox Content="X" IsChecked="{Binding RootRotX, Mode=TwoWay}" />
                        <CheckBox Content="Y" IsChecked="{Binding RootRotY, Mode=TwoWay}" />
                        <CheckBox Content="Z" IsChecked="{Binding RootRotZ, Mode=TwoWay}" />
                    </controls:SpacedStack>
                </GroupBox>

                <GroupBox Header="Bounding Box">
                    <StackPanel>
                        <controls:SpacedGrid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Val}" Text="Min" />
                            <controls:NumericUpDown Grid.Column="1" Style="{StaticResource Axis}" DecimalPlaces="0" LostKeyboardFocus="OnParameterLostFocus" Value="{Binding BBoxMinX, Mode=TwoWay}" />
                            <controls:NumericUpDown Grid.Column="2" Style="{StaticResource Axis}" DecimalPlaces="0" LostKeyboardFocus="OnParameterLostFocus" Value="{Binding BBoxMinY, Mode=TwoWay}" />
                            <controls:NumericUpDown Grid.Column="3" Style="{StaticResource Axis}" DecimalPlaces="0" LostKeyboardFocus="OnParameterLostFocus" Value="{Binding BBoxMinZ, Mode=TwoWay}" />
                        </controls:SpacedGrid>
                        <controls:SpacedGrid Margin="0,4,0,0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Val}" Text="Max" />
                            <controls:NumericUpDown Grid.Column="1" Style="{StaticResource Axis}" DecimalPlaces="0" LostKeyboardFocus="OnParameterLostFocus" Value="{Binding BBoxMaxX, Mode=TwoWay}" />
                            <controls:NumericUpDown Grid.Column="2" Style="{StaticResource Axis}" DecimalPlaces="0" LostKeyboardFocus="OnParameterLostFocus" Value="{Binding BBoxMaxY, Mode=TwoWay}" />
                            <controls:NumericUpDown Grid.Column="3" Style="{StaticResource Axis}" DecimalPlaces="0" LostKeyboardFocus="OnParameterLostFocus" Value="{Binding BBoxMaxZ, Mode=TwoWay}" />
                        </controls:SpacedGrid>
                    
                        <controls:SpacedGrid Margin="0,6,0,0" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Command="{Binding CalcBoundingBoxCommand}" Content="Calculate" />
                            <Button Grid.Column="1" Command="{Binding ClearBoundingBoxCommand}" Content="Delete" />
                        </controls:SpacedGrid>
                        
                        <controls:SpacedGrid Margin="0,6,0,0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:NumericUpDown Style="{StaticResource Axis}" DecimalPlaces="0" Minimum="0" Maximum="512" Value="{Binding GrowX, Mode=TwoWay}" />
                            <controls:NumericUpDown Grid.Column="1" Style="{StaticResource Axis}" DecimalPlaces="0" Minimum="0" Maximum="512" Value="{Binding GrowY, Mode=TwoWay}" />
                            <controls:NumericUpDown Grid.Column="2" Style="{StaticResource Axis}" DecimalPlaces="0" Minimum="0" Maximum="512" Value="{Binding GrowZ, Mode=TwoWay}" />
                        </controls:SpacedGrid>
                        <controls:SpacedGrid Margin="0,6,0,0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding GrowBoundingBoxCommand}" Content="Grow" />
                            <Button Grid.Column="1" Command="{Binding ShrinkBoundingBoxCommand}" Content="Shrink" />
                        </controls:SpacedGrid>
                    
                    </StackPanel>
                </GroupBox>

                
            </controls:SpacedStack>
        </ScrollViewer>

        <!--  Center: 3D view + timeline + transport  -->
        <DockPanel LastChildFill="True">

            

            

            <!--  3D view (hosted)  -->
            <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                <Border x:Name="panelRenderingHost" />
            </Border>
        </DockPanel>
        </DockPanel>
    </DockPanel>
</Window>