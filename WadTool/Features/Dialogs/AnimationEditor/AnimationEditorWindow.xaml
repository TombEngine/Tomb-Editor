<Window
    x:Class="WadTool.Features.Dialogs.AnimEditor.AnimationEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkDock="clr-namespace:DarkUI.WPF.AvalonDock;assembly=DarkUI.WPF"
    xmlns:dock="clr-namespace:WadTool.Features.DockableViews.AnimationEditor"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:WadTool.Features.Dialogs.AnimEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLibControls="clr-namespace:TombLib.WPF.CustomControls;assembly=TombLib.WPF"
    xmlns:wadControls="clr-namespace:WadTool.Controls"
    Title="{Binding Title}"
    Width="1055"
    Height="834"
    MinWidth="906"
    MinHeight="699"
    d:DataContext="{d:DesignInstance Type=local:AnimationEditorWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/WadTool;component/Features/DockableViews/AnimationEditor/PanelStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="TbLbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
        </Style>
        <!--  Section panel like the WinForms DarkSectionPanel: a header band over the content, no frame  -->
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <DockPanel>
                            <Border Padding="4,2" Background="{DynamicResource Brush_Background_Alternative}" DockPanel.Dock="Top">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource Brush_Text}" />
                            </Border>
                            <Border Padding="2">
                                <ContentPresenter />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>    </ResourceDictionary></Window.Resources>

    <DockPanel LastChildFill="True">

        <!--  Menu bar (mirrors the legacy top menu)  -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Edit}">
                <MenuItem Command="{Binding UndoCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Undo}" InputGestureText="Ctrl+Z"><MenuItem.Icon><Image Source="{tomb:Icon General/undo}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding RedoCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Redo}" InputGestureText="Ctrl+Y"><MenuItem.Icon><Image Source="{tomb:Icon General/redo}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding SaveCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.SaveChanges}" InputGestureText="Ctrl+S"><MenuItem.Icon><Image Source="{tomb:Icon General/Save}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding CancelCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Close}" />
            </MenuItem>
            <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Animations}">
                <MenuItem Command="{Binding AddAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.NewAnimation}"><MenuItem.Icon><Image Source="{tomb:Icon General/plus_math}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding DeleteAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.DeleteAnimation}"><MenuItem.Icon><Image Source="{tomb:Icon General/trash}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding SplitAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.SplitAnimation}"><MenuItem.Icon><Image Source="{tomb:Icon Actions/Split_WadTool}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding CutAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Cut}"><MenuItem.Icon><Image Source="{tomb:Icon Actions/cut}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding CopyAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Copy}"><MenuItem.Icon><Image Source="{tomb:Icon General/copy}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding PasteAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Paste}"><MenuItem.Icon><Image Source="{tomb:Icon General/paste}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding ImportAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Import}"><MenuItem.Icon><Image Source="{tomb:Icon General/Import}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding ExportAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Export}"><MenuItem.Icon><Image Source="{tomb:Icon General/Export}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Batch}">
                    <MenuItem Command="{Binding BatchImportCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Import}" />
                    <MenuItem Command="{Binding BatchExportSelectedCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.ExportSelected}" />
                    <MenuItem Command="{Binding BatchExportAllCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.ExportAll}" />
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding ResampleAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.ResampleAnimation}"><MenuItem.Icon><Image Source="{tomb:Icon Actions/interpolate}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding ResampleAnimationToFramerateCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.ResampleAnimationToFramerate}" />
                <MenuItem Command="{Binding MirrorCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.MirrorAnimation}"><MenuItem.Icon><Image Source="{tomb:Icon General/Mirror}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding ReverseCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.ReverseAnimation}" />
                <Separator />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Fix}">
                    <MenuItem Command="{Binding FixCurrentAnimationCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.CurrentAnimation}" />
                    <MenuItem Command="{Binding FixSelectedAnimationsCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.SelectedAnimations}" />
                    <MenuItem Command="{Binding FixAllAnimationsCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.AllAnimations}" />
                </MenuItem>
                <MenuItem Command="{Binding FindReplaceAnimCommandsCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.FindReplaceAnimcommands}"><MenuItem.Icon><Image Source="{tomb:Icon General/Find-and-replace}" /></MenuItem.Icon></MenuItem>
            </MenuItem>
            <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Frames}">
                <MenuItem Command="{Binding AddFrameCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.InsertFrameAfterCurrentOne}"><MenuItem.Icon><Image Source="{tomb:Icon General/plus_math}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding InsertFramesAfterCurrentCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.InsertNFramesAfterCurrent}" />
                <MenuItem Command="{Binding DeleteFrameCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.DeleteFrames}" InputGestureText="Del"><MenuItem.Icon><Image Source="{tomb:Icon General/trash}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding DeleteEveryNthFrameCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.DeleteEveryNThFrame}" />
                <Separator />
                <MenuItem Command="{Binding CutFrameCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Cut}" InputGestureText="Ctrl+X"><MenuItem.Icon><Image Source="{tomb:Icon Actions/cut}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding CopyFrameCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Copy}" InputGestureText="Ctrl+C"><MenuItem.Icon><Image Source="{tomb:Icon General/copy}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding PasteFrameCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.Paste}" InputGestureText="Ctrl+V"><MenuItem.Icon><Image Source="{tomb:Icon General/paste}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding InterpolateCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.InterpolateFrames}" InputGestureText="Ctrl+I"><MenuItem.Icon><Image Source="{tomb:Icon Actions/interpolate}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Command="{Binding CalculateCurrentFrameBoundingBoxCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.CalculateBoundingBox}"><MenuItem.Icon><Image Source="{tomb:Icon General/box}" /></MenuItem.Icon></MenuItem>
                <MenuItem Command="{Binding DeleteCurrentFrameBoundingBoxCommand}" Header="{tombLib:Localize ~WadTool.AnimationEditor.DeleteBoundingBox}" />
            </MenuItem>
            <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Rendering}">
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.DrawGizmo}" IsCheckable="True" IsChecked="{Binding ShowGizmo, Mode=TwoWay}" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.DrawGrid}" IsCheckable="True" IsChecked="{Binding ShowGrid, Mode=TwoWay}" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.DrawCollisionBox}" IsCheckable="True" IsChecked="{Binding ShowCollisionBox, Mode=TwoWay}" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.DrawSkinnedMesh}" IsCheckable="True" IsChecked="{Binding ShowSkin, Mode=TwoWay}" Visibility="{Binding IsTombEngine, Converter={StaticResource BoolToVis}}" />
                <Separator />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.SmoothAnimation}" IsCheckable="True" IsChecked="{Binding SmoothAnimation, Mode=TwoWay}" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.ScrollGrid}" IsCheckable="True" IsChecked="{Binding ScrollGrid, Mode=TwoWay}" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.RestoreGridHeight}" IsCheckable="True" IsChecked="{Binding RestoreGridHeight, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.View}" SubmenuOpened="OnViewMenuOpened">
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.AnimationList}" IsCheckable="True" Tag="animationList" Click="OnTogglePanel" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.CurrentAnimation2}" IsCheckable="True" Tag="currentAnimation" Click="OnTogglePanel" />
                <MenuItem x:Name="blendingMenuItem" Header="{tombLib:Localize ~WadTool.AnimationEditor.AnimationBlending}" IsCheckable="True" Tag="animationBlending" Click="OnTogglePanel" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Timeline}" IsCheckable="True" Tag="timeline" Click="OnTogglePanel" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Skeleton}" IsCheckable="True" Tag="skeleton" Click="OnTogglePanel" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.Transform}" IsCheckable="True" Tag="transform" Click="OnTogglePanel" />
                <MenuItem x:Name="rootMotionMenuItem" Header="{tombLib:Localize ~WadTool.AnimationEditor.RootMotion}" IsCheckable="True" Tag="rootMotion" Click="OnTogglePanel" />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.BoundingBox}" IsCheckable="True" Tag="boundingBox" Click="OnTogglePanel" />
                <Separator />
                <MenuItem Header="{tombLib:Localize ~WadTool.AnimationEditor.ResetLayout}" Click="OnResetLayout" />
            </MenuItem>
        </Menu>

            <Border
                Padding="2"
                Background="{DynamicResource Brush_Background_Alternative}"
                DockPanel.Dock="Top">
                <DockPanel LastChildFill="True">
                    <controls:SpacedStack
                        DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button Style="{StaticResource TbBtn}" Command="{Binding SaveCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.SaveAllChanges}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Save}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding UndoCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.Undo}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/undo}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding RedoCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.Redo}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/redo}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding ResetCameraCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.ResetCamera}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/target}" /></Button>
                        <Border Style="{StaticResource TbSep}" />
                        <TextBlock Style="{StaticResource TbLbl}" Text="{tombLib:Localize ~WadTool.AnimationEditor.Anims}" />
                        <Button Style="{StaticResource TbBtn}" Command="{Binding AddAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.AddAnimation}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/plus_math}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding ImportAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.Import}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Import}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding DeleteAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.DeleteAnimation}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/trash}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CutAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.CutAnimation}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/cut}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CopyAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.CopyAnimation}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/copy}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding PasteAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.PasteAnimation}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/paste}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding ReplaceAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.ReplaceAnimation}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/paste-new}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding SplitAnimationCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.SplitAnimation}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/Split_WadTool}" /></Button>
                        <Border Style="{StaticResource TbSep}" />
                        <TextBlock Style="{StaticResource TbLbl}" Text="{tombLib:Localize ~WadTool.AnimationEditor.Frames2}" />
                        <Button Style="{StaticResource TbBtn}" Command="{Binding AddFrameCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.AddFrame}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/plus_math}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding DeleteFrameCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.DeleteFrames}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/trash}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CutFrameCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.CutFrames}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/cut}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding CopyFrameCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.CopyFrames}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/copy}" /></Button>
                        <Button Style="{StaticResource TbBtn}" Command="{Binding PasteFrameCommand}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.PasteFrames}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/paste}" /></Button>
                        </controls:SpacedStack>
                    
                </DockPanel>
            </Border>

        <DockPanel LastChildFill="True">

        <Border Height="25" Padding="4,5,0,3" Background="{DynamicResource Brush_Background}" DockPanel.Dock="Bottom">
            <TextBlock FontSize="11" Foreground="{DynamicResource Brush_Text}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
        </Border>
<avalonDock:DockingManager
    x:Name="dockManager"
    GridSplitterWidth="4"
    GridSplitterHeight="4"
    GridSplitterVerticalStyle="{DynamicResource Dock_SplitterVertical}"
    GridSplitterHorizontalStyle="{DynamicResource Dock_SplitterHorizontal}">
<avalonDock:DockingManager.Theme>
<darkDock:DarkUIDockTheme />
</avalonDock:DockingManager.Theme>
<avalonDock:LayoutRoot>
<avalonDock:LayoutPanel Orientation="Vertical">
<avalonDock:LayoutPanel Orientation="Horizontal">
<avalonDock:LayoutAnchorablePaneGroup DockWidth="280" Orientation="Vertical">
<avalonDock:LayoutAnchorablePane DockHeight="300*" DockMinHeight="100">
<avalonDock:LayoutAnchorable ContentId="animationList" CanClose="False" IconSource="{tomb:Icon General/filter}" Title="Animation List">
        <dock:AnimationListPanel x:Name="animationListPanel" />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
<avalonDock:LayoutAnchorablePane DockHeight="205*" DockMinHeight="190">
<avalonDock:LayoutAnchorable ContentId="currentAnimation" CanClose="False" IconSource="{tomb:Icon General/edit}" Title="Current Animation">
        <dock:CurrentAnimationPanel x:Name="currentAnimationPanel" />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
<avalonDock:LayoutAnchorablePane DockHeight="200*" DockMinHeight="140">
<avalonDock:LayoutAnchorable ContentId="animationBlending" CanClose="False" IconSource="{tomb:Icon Actions/interpolate}" Title="Animation Blending">
        <dock:AnimationBlendingPanel x:Name="blendingPanel" />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
</avalonDock:LayoutAnchorablePaneGroup>
<avalonDock:LayoutDocumentPaneGroup>
<avalonDock:LayoutDocumentPane ShowHeader="False">
<avalonDock:LayoutDocument ContentId="view" CanClose="False" CanFloat="False" Title="3D View">
            <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                <Border x:Name="panelRenderingHost" />
            </Border>
</avalonDock:LayoutDocument>
</avalonDock:LayoutDocumentPane>
</avalonDock:LayoutDocumentPaneGroup>
<avalonDock:LayoutAnchorablePaneGroup DockWidth="280" Orientation="Vertical">
<avalonDock:LayoutAnchorablePane DockHeight="200*" DockMinHeight="90">
<avalonDock:LayoutAnchorable ContentId="skeleton" CanClose="False" IconSource="{tomb:Icon General/box}" Title="Skeleton">
        <dock:SkeletonPanel />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
<avalonDock:LayoutAnchorablePane DockHeight="170*" DockMinHeight="120">
<avalonDock:LayoutAnchorable ContentId="transform" CanClose="False" IconSource="{tomb:Icon General/target}" Title="Transform">
        <dock:TransformPanel />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
<avalonDock:LayoutAnchorablePane DockHeight="50*" DockMinHeight="50">
<avalonDock:LayoutAnchorable ContentId="rootMotion" CanClose="False" IconSource="{tomb:Icon General/options}" Title="Root Motion">
        <dock:RootMotionPanel />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
<avalonDock:LayoutAnchorablePane DockHeight="230*" DockMinHeight="190">
<avalonDock:LayoutAnchorable ContentId="boundingBox" CanClose="False" IconSource="{tomb:Icon General/box}" Title="Bounding Box">
        <dock:BoundingBoxPanel />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
</avalonDock:LayoutAnchorablePaneGroup>
</avalonDock:LayoutPanel>
<avalonDock:LayoutAnchorablePane DockHeight="84" DockMinHeight="84">
<avalonDock:LayoutAnchorable ContentId="timeline" CanClose="False" IconSource="{tomb:Icon Actions/Transport/Play24}" Title="Timeline">
        <dock:TimelinePanel x:Name="timelinePanel" />
</avalonDock:LayoutAnchorable>
</avalonDock:LayoutAnchorablePane>
</avalonDock:LayoutPanel>
</avalonDock:LayoutRoot>
</avalonDock:DockingManager>
        </DockPanel>
    </DockPanel>
</Window>
