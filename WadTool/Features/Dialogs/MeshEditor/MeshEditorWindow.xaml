<Window
    x:Class="WadTool.Features.Dialogs.MeshEditor.MeshEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:WadTool.Features.Dialogs.MeshEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:wadControls="clr-namespace:WadTool.Controls"
    Title="{Binding Title}"
    Width="1017"
    Height="646"
    MinWidth="1000"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=local:MeshEditorWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
        </Style>
        <Style x:Key="TbBtn" BasedOn="{StaticResource ButtonFlatIconOnly}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="23" /><Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TbToggle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="23" /><Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TbImg" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style x:Key="TbSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Background" Value="{DynamicResource Brush_Border}" />
        </Style>
        <Style x:Key="Nud" BasedOn="{StaticResource {x:Type controls:NumericUpDown}}" TargetType="controls:NumericUpDown">
            <Setter Property="Width" Value="70" />
            <Setter Property="DecimalPlaces" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

        <!--  Footer: status + OK/Cancel  -->
        <Grid DockPanel.Dock="Bottom">
            <Grid.Margin>
                <Thickness Top="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
            </Grid.Margin>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis" />
            <controls:SpacedStack
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
                <Button Width="80" Command="{Binding OkCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.OK}" />
                <Button Width="80" Command="{Binding CancelCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.Cancel}" Visibility="{Binding CancelVisible, Converter={StaticResource BoolToVis}}" />
            </controls:SpacedStack>
        </Grid>

        
                <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colTree" Width="259" MinWidth="120" />
                <ColumnDefinition x:Name="colTreeSplit" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="colEditSplit" Width="Auto" />
                <ColumnDefinition x:Name="colEdit" Width="331" MinWidth="250" />
            </Grid.ColumnDefinitions>
<!--  Mesh tree (multi-mesh mode)  -->
        <DockPanel
            Grid.Column="0"
            LastChildFill="True"
            Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}">
            <DockPanel.Margin>
                <Thickness Right="{x:Static darkUI:Defaults.MediumThicknessWidth}" Top="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
            </DockPanel.Margin>
            <Border Margin="0,0,0,4" Padding="4,2" Background="{DynamicResource Brush_Background_Alternative}" DockPanel.Dock="Top"><TextBlock Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.MeshList}" /></Border>
            <controls:SpacedGrid
                DockPanel.Dock="Top"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}" /></TextBox.InputBindings></TextBox>
                <Button Grid.Column="1" Style="{StaticResource TbBtn}" Command="{Binding SearchCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.SearchForMeshesByName}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/search}" /></Button>
            </controls:SpacedGrid>
            <controls:AlternatingTreeView x:Name="meshTree" Style="{DynamicResource {x:Type TreeView}}" HorizontalContentAlignment="Stretch" Margin="0,4,0,0" ItemsSource="{Binding RootNodes}">
                <controls:AlternatingTreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type controls:AlternatingTreeViewItem}}" TargetType="controls:AlternatingTreeViewItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </controls:AlternatingTreeView.ItemContainerStyle>
                <controls:AlternatingTreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Margin="0,0,4,0" Style="{StaticResource TbImg}" Source="{tomb:Icon Misc/skinned}" Visibility="{Binding IsSkin, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Text}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </controls:AlternatingTreeView.ItemTemplate>
            </controls:AlternatingTreeView>
        </DockPanel>

        
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
<!--  Toolbar + 3D mesh view  -->
        <DockPanel Grid.Column="2" LastChildFill="True">
            <!--  Toolbar  -->
        <Border
            DockPanel.Dock="Top"
            Padding="2"
            Background="{DynamicResource Brush_Background_Alternative}"
            Visibility="{Binding ShowEditingTools, Converter={StaticResource BoolToVis}}">
            <controls:SpacedStack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                <Button Style="{StaticResource TbBtn}" Command="{Binding UndoCommand}" IsEnabled="{Binding UndoEnabled}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.UndoCtrlZ}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/undo}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding RedoCommand}" IsEnabled="{Binding RedoEnabled}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.RedoCtrlY}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/redo}" /></Button>
                <Border Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding ImportMeshCommand}" IsEnabled="{Binding MeshIoEnabled}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ImportMesh}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Import}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding ExportMeshCommand}" IsEnabled="{Binding MeshIoEnabled}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ExportMesh}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Export}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding RenameCommand}" IsEnabled="{Binding MeshIoEnabled}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.RenameMesh}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/edit}" /></Button>
                <Border Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding ResetCameraCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ResetCamera}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/target}" /></Button>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding DrawAxis, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.DrawGridAndAxis}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/axis}" /></ToggleButton>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding Wireframe, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.DrawInWireframeMode}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Misc/wireframe}" /></ToggleButton>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding AlphaTest, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ToggleTransparency}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/AlphaTest}" /></ToggleButton>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding Bilinear, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ToggleBilinearFilter}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/blur}" /></ToggleButton>
                <Border Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding FindTextureCommand}" Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.SearchForMeshBySelected}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/search-texture}" /></Button>
                <Border Style="{StaticResource TbSep}" Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding RotateTextureCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.RotateCurrentTexture}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Rotate}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding MirrorTextureCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.MirrorCurrentTextureShift}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Mirror}" /></Button>
                <Border Style="{StaticResource TbSep}" />
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding Hidden, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.HideMeshIfSkinnedMesh}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Misc/hide_mesh}" /></ToggleButton>
            </controls:SpacedStack>
        </Border>

        
            <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                <Border x:Name="meshHost" />
            </Border>
        </DockPanel>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
<!--  Texturing + editing tools (right)  -->
        <DockPanel
            Grid.Column="4"
            LastChildFill="True"
            Visibility="{Binding ShowEditingTools, Converter={StaticResource BoolToVis}}">
            <DockPanel.Margin>
                <Thickness Left="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
            </DockPanel.Margin>

            <!--  Editing tools: grids with star columns reproduce the anchoring of the previous form  -->
            <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding EditingEnabled}">
                <Border Padding="4,2" Background="{DynamicResource Brush_Background_Alternative}" DockPanel.Dock="Top"><TextBlock Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.EditingTools}" /></Border>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Mode}" />
                    <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedIndex="{Binding EditingModeIndex, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.MeshEditorOperationMode}">
                        <ComboBoxItem Content="{tombLib:Localize ~WadTool.MeshEditor.FaceAttributes}" />
                        <ComboBoxItem Content="{tombLib:Localize ~WadTool.MeshEditor.VertexRemap}" />
                        <ComboBoxItem Content="{tombLib:Localize ~WadTool.MeshEditor.NormalsShades}" />
                        <ComboBoxItem Content="{tombLib:Localize ~WadTool.MeshEditor.VertexEffects}" />
                        <ComboBoxItem Content="{tombLib:Localize ~WadTool.MeshEditor.VertexWeights}" />
                        <ComboBoxItem Content="{tombLib:Localize ~WadTool.MeshEditor.Sphere}" />
                    </ComboBox>
                    <CheckBox Grid.Column="2" VerticalAlignment="Center" Content="{Binding ExtraLabel}" IsChecked="{Binding ShowExtra, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ShowAdditionalScreenInformation}" />
                </Grid>

                <!--  Face attributes  -->
                <Grid Visibility="{Binding IsFaceMode, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Content="{tombLib:Localize ~WadTool.MeshEditor.Blending}" IsChecked="{Binding ApplyBlend, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ApplyBlendModeAndDouble}" />
                    <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,6,0" ItemsSource="{Binding BlendModes}" SelectedIndex="{Binding BlendModeIndex, Mode=TwoWay}" />
                        <ToggleButton Grid.Column="1" Width="24" Height="23" Padding="0" IsChecked="{Binding DoubleSided, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ToggleDoubleSidedAttribute}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Texture/DoubleSided_1}" /></ToggleButton>
                    </Grid>
                    <CheckBox Grid.Row="1" Grid.Column="0" Margin="0,4,6,0" VerticalAlignment="Center" Content="{tombLib:Localize ~WadTool.MeshEditor.Texture}" IsChecked="{Binding ApplyTexture, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ApplyTexturesToFaces}" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,4,4,0" VerticalAlignment="Center" Content="{tombLib:Localize ~WadTool.MeshEditor.Sheen}" IsChecked="{Binding ApplySheen, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ApplySheenAttributeToFaces}" />
                    <controls:NumericUpDown Grid.Row="1" Grid.Column="2" Style="{StaticResource Nud}" Width="Auto" Margin="0,4,4,0" Maximum="63" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ShininessValueOnTheRange}" Value="{Binding ShineStrength, Mode=TwoWay}" />
                    <Button Grid.Row="1" Grid.Column="3" Width="99" Margin="0,4,0,0" Command="{Binding ApplyToAllFacesCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.ApplyToAll}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ApplySpecifiedFaceAttributesTo}" />
                </Grid>

                <!--  Vertex remap  -->
                <Grid Visibility="{Binding IsRemapMode, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.VertexNumber}" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Style="{StaticResource Nud}" Width="Auto" Margin="0,0,4,0" Maximum="65535" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.VertexNumberToOperateWith}" Value="{Binding VertexNum, Mode=TwoWay}"><controls:NumericUpDown.InputBindings><KeyBinding Key="Return" Command="{Binding RemapVertexCommand}" /></controls:NumericUpDown.InputBindings></controls:NumericUpDown>
                    <Button Grid.Row="0" Grid.Column="2" Width="77" Margin="0,0,4,0" Command="{Binding FindVertexCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.JumpTo}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.JumpToSpecifiedVertexNumber}" />
                    <Button Grid.Row="0" Grid.Column="3" Width="74" Command="{Binding RemapVertexCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.Remap}" IsEnabled="{Binding RemapEnabled}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.RemapSelectedVertexToSpecified}" />
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,4,0,0" Command="{Binding AutoFitCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.AutomaticFit}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.TryToAutomaticallyRemapAll}" />
                </Grid>

                <!--  Normals and shades  -->
                <Grid Visibility="{Binding IsColorsMode, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="94" />
                        <ColumnDefinition Width="94" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.RecalculateNormals}" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="0,0,4,0" Command="{Binding RecalcNormalsCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.Weighted}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.WeightedNormalsRecalculationGivesBetter}" />
                    <Button Grid.Row="0" Grid.Column="3" Command="{Binding RecalcNormalsAvgCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.Averaged}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.AveragedNormalsRecalculationIsMore}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,6,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.VertexShadeColor}" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,4,4,0" Background="{Binding VertexColorBrush}" Command="{Binding PickColorCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.VertexShadeColorToApply}" />
                    <Button Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" Command="{Binding ApplyShadesToAllCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.ApplyToAll}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ApplySpecifiedVertexShadeTo}" />
                </Grid>

                <!--  Vertex effects  -->
                <Grid Visibility="{Binding IsEffectsMode, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Glow}" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Style="{StaticResource Nud}" Width="Auto" Margin="0,0,4,0" Maximum="63" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ForLegacyEnginesAnyValue}" Value="{Binding Glow, Mode=TwoWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,4,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Move}" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="3" Style="{StaticResource Nud}" Width="Auto" Margin="0,0,4,0" Maximum="63" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ForLegacyEnginesAnyValue2}" Value="{Binding Move, Mode=TwoWay}" />
                    <ToggleButton Grid.Row="0" Grid.Column="4" IsChecked="{Binding PreviewActive, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.PreviewAllEffects}">
                        <StackPanel Orientation="Horizontal"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/play}" /><TextBlock Margin="4,0,0,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Preview}" /></StackPanel>
                    </ToggleButton>
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,4,4,0" Command="{Binding ConvertFromShadesCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.ConvertFromShades}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ConvertVertexEffectsFromLegacy}" />
                    <Button Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Command="{Binding ApplyEffectsToAllCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.ApplyToAll}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ApplySpecifiedVertexAttributesTo}" />
                </Grid>

                <!--  Vertex weights  -->
                <Grid Visibility="{Binding IsWeightsMode, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Bone}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,6,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Value}" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource Nud}" Width="Auto" Maximum="63" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneIndex}" Value="{Binding WeightIndex1, Mode=TwoWay}" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="2" Margin="0,0,4,0" Style="{StaticResource Nud}" Width="Auto" Maximum="63" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneIndex}" Value="{Binding WeightIndex2, Mode=TwoWay}" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="3" Margin="0,0,4,0" Style="{StaticResource Nud}" Width="Auto" Maximum="63" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneIndex}" Value="{Binding WeightIndex3, Mode=TwoWay}" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="4" Margin="0,0,4,0" Style="{StaticResource Nud}" Width="Auto" Maximum="63" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneIndex}" Value="{Binding WeightIndex4, Mode=TwoWay}" />
                    <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,4,4,0" Style="{StaticResource Nud}" Width="Auto" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneWeight}" Value="{Binding WeightValue1, Mode=TwoWay}" />
                    <controls:NumericUpDown Grid.Row="1" Grid.Column="2" Margin="0,4,4,0" Style="{StaticResource Nud}" Width="Auto" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneWeight}" Value="{Binding WeightValue2, Mode=TwoWay}" />
                    <controls:NumericUpDown Grid.Row="1" Grid.Column="3" Margin="0,4,4,0" Style="{StaticResource Nud}" Width="Auto" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneWeight}" Value="{Binding WeightValue3, Mode=TwoWay}" />
                    <controls:NumericUpDown Grid.Row="1" Grid.Column="4" Margin="0,4,4,0" Style="{StaticResource Nud}" Width="Auto" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.BoneWeight}" Value="{Binding WeightValue4, Mode=TwoWay}" />
                    <Button Grid.Row="0" Grid.Column="5" Grid.RowSpan="2" Padding="0" Command="{Binding ApplyWeightsToAllCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ApplyCurrentWeightsToAll}">
                        <TextBlock Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Fill}" />
                    </Button>
                </Grid>

                <!--  Sphere  -->
                <Grid Visibility="{Binding IsSphereMode, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource Lbl}" Text="X:" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource Nud}" Width="Auto" Maximum="1000000" Minimum="-1000000" Value="{Binding SphereX, Mode=TwoWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,4,0" Style="{StaticResource Lbl}" Text="Y:" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="3" Margin="0,0,4,0" Style="{StaticResource Nud}" Width="Auto" Maximum="1000000" Minimum="-1000000" Value="{Binding SphereY, Mode=TwoWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Margin="0,0,4,0" Style="{StaticResource Lbl}" Text="Z:" />
                    <controls:NumericUpDown Grid.Row="0" Grid.Column="5" Style="{StaticResource Nud}" Width="Auto" Maximum="1000000" Minimum="-1000000" Value="{Binding SphereZ, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Radius}" />
                    <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,4,0" Style="{StaticResource Nud}" Width="Auto" Maximum="1000000" Minimum="0" Value="{Binding SphereRadius, Mode=TwoWay}" />
                    <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Margin="0,4,0,0" Command="{Binding ResetSphereCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.Recalculate}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.CalculatesAverageSphereWhichEncloses}" />
                </Grid>
            </StackPanel>

            <Border Padding="4,2" Background="{DynamicResource Brush_Background_Alternative}" DockPanel.Dock="Top"><TextBlock Style="{StaticResource Lbl}" Text="{tombLib:Localize ~WadTool.MeshEditor.Texturing}" /></Border>
            <DockPanel Margin="0,4,0,0" DockPanel.Dock="Top" IsEnabled="{Binding EditingEnabled}">
                <controls:SpacedStack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                            <Button Style="{StaticResource TbBtn}" Width="38" Click="OpenButtonMenu" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.AddTexture}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding AddEmbeddedTextureCommand}" Header="{tombLib:Localize ~WadTool.MeshEditor.AddEmbeddedTexture}" />
                                        <MenuItem Command="{Binding AddExternalTextureCommand}" Header="{tombLib:Localize ~WadTool.MeshEditor.AddExternalTexture}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/plus_math}" /><Path Margin="3,0,0,0" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush_Text}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TbBtn}" Width="38" Click="OpenButtonMenu" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ReplaceTexture}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ReplaceEmbeddedTextureCommand}" Header="{tombLib:Localize ~WadTool.MeshEditor.ReplaceWithEmbeddedTexture}" />
                                        <MenuItem Command="{Binding ReplaceExternalTextureCommand}" Header="{tombLib:Localize ~WadTool.MeshEditor.ReplaceWithExternalTexture}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/refresh}" /><Path Margin="3,0,0,0" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush_Text}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TbBtn}" Command="{Binding ExportTextureCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ExportCurrentTextureToFile}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Export}" /></Button>
                            <Button Style="{StaticResource TbBtn}" Command="{Binding DeleteTextureCommand}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.DeleteTexture}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/trash}" /></Button>
                            
                            <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding AllTextures, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.ListAllTexturesFromWad}" Visibility="{Binding ShowAllTexturesButton, Converter={StaticResource BoolToVis}}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/DrawAllRooms}" /></ToggleButton>
                </controls:SpacedStack>
                <controls:SearchableComboBox Margin="0,0,4,0" ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture, Mode=TwoWay}" />
            </DockPanel>
            <controls:SpacedStack Margin="0,4,0,4" DockPanel.Dock="Bottom" IsEnabled="{Binding EditingEnabled}" Orientation="Horizontal" Spacing="4">
                <controls:SpacedStack Margin="0,4,0,0" Orientation="Horizontal" Spacing="4">
                            <Button Width="152" Command="{Binding MaterialEditorCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.Materials}" IsEnabled="{Binding MaterialEditorEnabled}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.EditMaterials}" Visibility="{Binding ShowTextureTools, Converter={StaticResource BoolToVis}}" />
                            <Button Width="152" Command="{Binding AnimationRangesCommand}" Content="{tombLib:Localize ~WadTool.MeshEditor.AnimatedTextures}" ToolTip="{tombLib:Localize ~WadTool.MeshEditor.EditAnimatedTextureSets}" Visibility="{Binding ShowTextureTools, Converter={StaticResource BoolToVis}}" />
                        </controls:SpacedStack>
            </controls:SpacedStack>
            <Border Margin="0,4,0,0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                <wadControls:PanelTextureMap x:Name="textureMap" />
            </Border>
        </DockPanel>

                </Grid>
    </DockPanel>
</Window>