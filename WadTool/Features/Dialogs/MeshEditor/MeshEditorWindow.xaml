<Window
    x:Class="WadTool.Features.Dialogs.MeshEditor.MeshEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:local="clr-namespace:WadTool.Features.Dialogs.MeshEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:wadControls="clr-namespace:WadTool.Controls"
    Title="{Binding Title}"
    Width="1017"
    Height="646"
    MinWidth="1000"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=local:MeshEditorWindowViewModel}"
    Background="{DynamicResource Brush_Background}"
    ShowInTaskbar="False"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
        </Style>
        <Style x:Key="TbBtn" BasedOn="{StaticResource ButtonFlatIconOnly}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TbToggle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TbImg" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style x:Key="TbSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Background" Value="{DynamicResource Brush_Border}" />
        </Style>
        <Style x:Key="Nud" BasedOn="{StaticResource {x:Type controls:NumericUpDown}}" TargetType="controls:NumericUpDown">
            <Setter Property="Width" Value="70" />
            <Setter Property="DecimalPlaces" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

        <!--  Footer: status + OK/Cancel  -->
        <Grid DockPanel.Dock="Bottom">
            <Grid.Margin>
                <Thickness Top="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
            </Grid.Margin>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Brush_Text_Low}"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis" />
            <controls:SpacedStack
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
                <Button Width="80" Command="{Binding OkCommand}" Content="OK" />
                <Button Width="80" Command="{Binding CancelCommand}" Content="Cancel" Visibility="{Binding CancelVisible, Converter={StaticResource BoolToVis}}" />
            </controls:SpacedStack>
        </Grid>

        
                <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colTree" Width="259" MinWidth="120" />
                <ColumnDefinition x:Name="colTreeSplit" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="colEditSplit" Width="Auto" />
                <ColumnDefinition x:Name="colEdit" Width="331" MinWidth="250" />
            </Grid.ColumnDefinitions>
<!--  Mesh tree (multi-mesh mode)  -->
        <DockPanel
            Grid.Column="0"
            LastChildFill="True"
            Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}">
            <DockPanel.Margin>
                <Thickness Right="{x:Static darkUI:Defaults.MediumThicknessWidth}" Top="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
            </DockPanel.Margin>
            <Border Margin="0,0,0,4" Padding="4,2" Background="{DynamicResource Brush_BackgroundSlightlyDark}" DockPanel.Dock="Top"><TextBlock Style="{StaticResource Lbl}" Text="Mesh list" /></Border>
            <controls:SpacedGrid
                DockPanel.Dock="Top"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}" /></TextBox.InputBindings></TextBox>
                <Button Grid.Column="1" Style="{StaticResource TbBtn}" Command="{Binding SearchCommand}" ToolTip="Search for meshes by name"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/search}" /></Button>
            </controls:SpacedGrid>
            <controls:AlternatingTreeView x:Name="meshTree" Style="{DynamicResource {x:Type TreeView}}" HorizontalContentAlignment="Stretch" Margin="0,4,0,0" ItemsSource="{Binding RootNodes}">
                <controls:AlternatingTreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type controls:AlternatingTreeViewItem}}" TargetType="controls:AlternatingTreeViewItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </controls:AlternatingTreeView.ItemContainerStyle>
                <controls:AlternatingTreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Margin="0,0,4,0" Style="{StaticResource TbImg}" Source="{tomb:Icon Misc/skinned}" Visibility="{Binding IsSkin, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Text}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </controls:AlternatingTreeView.ItemTemplate>
            </controls:AlternatingTreeView>
        </DockPanel>

        
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
<!--  Toolbar + 3D mesh view  -->
        <DockPanel Grid.Column="2" LastChildFill="True">
            <!--  Toolbar  -->
        <Border
            DockPanel.Dock="Top"
            Padding="2"
            Background="{DynamicResource Brush_BackgroundSlightlyDark}"
            Visibility="{Binding ShowEditingTools, Converter={StaticResource BoolToVis}}">
            <controls:SpacedStack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                <Button Style="{StaticResource TbBtn}" Command="{Binding UndoCommand}" IsEnabled="{Binding UndoEnabled}" ToolTip="Undo (Ctrl+Z)"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/undo}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding RedoCommand}" IsEnabled="{Binding RedoEnabled}" ToolTip="Redo (Ctrl+Y)"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/redo}" /></Button>
                <Border Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding ImportMeshCommand}" IsEnabled="{Binding MeshIoEnabled}" ToolTip="Import mesh"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Import}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding ExportMeshCommand}" IsEnabled="{Binding MeshIoEnabled}" ToolTip="Export mesh"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Export}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding RenameCommand}" IsEnabled="{Binding MeshIoEnabled}" ToolTip="Rename mesh"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/edit}" /></Button>
                <Border Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding ResetCameraCommand}" ToolTip="Reset camera"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/target}" /></Button>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding DrawAxis, Mode=TwoWay}" ToolTip="Draw grid and axis"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/axis}" /></ToggleButton>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding Wireframe, Mode=TwoWay}" ToolTip="Draw in wireframe mode"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Misc/wireframe}" /></ToggleButton>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding AlphaTest, Mode=TwoWay}" ToolTip="Toggle transparency"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/AlphaTest}" /></ToggleButton>
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding Bilinear, Mode=TwoWay}" ToolTip="Toggle bilinear filter"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/blur}" /></ToggleButton>
                <Border Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding FindTextureCommand}" Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}" ToolTip="Search for mesh by selected texture area (Ctrl+F)"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/search-texture}" /></Button>
                <Border Style="{StaticResource TbSep}" Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource TbBtn}" Command="{Binding RotateTextureCommand}" ToolTip="Rotate current texture (~)"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Rotate}" /></Button>
                <Button Style="{StaticResource TbBtn}" Command="{Binding MirrorTextureCommand}" ToolTip="Mirror current texture (Shift+~)"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Mirror}" /></Button>
                <Border Style="{StaticResource TbSep}" />
                <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding Hidden, Mode=TwoWay}" ToolTip="Hide mesh if skinned mesh is used for the parent object"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Misc/hide_mesh}" /></ToggleButton>
            </controls:SpacedStack>
        </Border>

        
            <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                <Border x:Name="meshHost" />
            </Border>
        </DockPanel>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
<!--  Texturing + editing tools (right)  -->
        <DockPanel
            Grid.Column="4"
            LastChildFill="True"
            Visibility="{Binding ShowEditingTools, Converter={StaticResource BoolToVis}}">
            <DockPanel.Margin>
                <Thickness Left="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
            </DockPanel.Margin>

            <!--  Editing tools  -->
            <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding EditingEnabled}">
                <Border Padding="4,2" Background="{DynamicResource Brush_BackgroundSlightlyDark}" DockPanel.Dock="Top"><TextBlock Style="{StaticResource Lbl}" Text="Editing tools" /></Border>
                <controls:SpacedStack Margin="0,4,0,4" Orientation="Horizontal" Spacing="6">
                    <TextBlock Style="{StaticResource Lbl}" Text="Mode:" />
                    <ComboBox Width="156" SelectedIndex="{Binding EditingModeIndex, Mode=TwoWay}" ToolTip="Mesh editor operation mode">
                        <ComboBoxItem Content="Face attributes" />
                        <ComboBoxItem Content="Vertex remap" />
                        <ComboBoxItem Content="Normals &amp; shades" />
                        <ComboBoxItem Content="Vertex effects" />
                        <ComboBoxItem Content="Vertex weights" />
                        <ComboBoxItem Content="Sphere" />
                    </ComboBox>
                    <CheckBox VerticalAlignment="Center" Content="{Binding ExtraLabel}" IsChecked="{Binding ShowExtra, Mode=TwoWay}" ToolTip="Show additional screen information" />
                </controls:SpacedStack>

                <!--  Face attributes  -->
                <Grid Visibility="{Binding IsFaceMode, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Content="Blending:" IsChecked="{Binding ApplyBlend, Mode=TwoWay}" ToolTip="Apply blend mode and double-sided attribute to faces" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,4,0" ItemsSource="{Binding BlendModes}" SelectedIndex="{Binding BlendModeIndex, Mode=TwoWay}" />
                    <ToggleButton Grid.Row="0" Grid.Column="3" Style="{StaticResource TbToggle}" IsChecked="{Binding DoubleSided, Mode=TwoWay}" ToolTip="Toggle double-sided attribute"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Texture/DoubleSided_1}" /></ToggleButton>
                    <CheckBox Grid.Row="1" Grid.Column="0" Margin="0,4,6,0" VerticalAlignment="Center" Content="Texture" IsChecked="{Binding ApplyTexture, Mode=TwoWay}" ToolTip="Apply textures to faces" />
                    <controls:SpacedStack Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Orientation="Horizontal" Spacing="4">
                        <CheckBox VerticalAlignment="Center" Content="Sheen:" IsChecked="{Binding ApplySheen, Mode=TwoWay}" ToolTip="Apply sheen attribute to faces" />
                        <controls:NumericUpDown Style="{StaticResource Nud}" Width="65" Maximum="63" Minimum="0" ToolTip="Shininess value on the range from 0 to 63" Value="{Binding ShineStrength, Mode=TwoWay}" />
                    </controls:SpacedStack>
                    <Button Grid.Row="1" Grid.Column="3" Width="99" Margin="4,4,0,0" Command="{Binding ApplyToAllFacesCommand}" Content="Apply to all" ToolTip="Apply specified face attributes to all faces" />
                </Grid>

                

                <!--  Vertex remap  -->
                <Border Visibility="{Binding IsRemapMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:SpacedStack Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Vertex number:" />
                            <controls:NumericUpDown Style="{StaticResource Nud}" Maximum="65535" Minimum="0" ToolTip="Vertex number to operate with" Value="{Binding VertexNum, Mode=TwoWay}"><controls:NumericUpDown.InputBindings><KeyBinding Key="Return" Command="{Binding RemapVertexCommand}" /></controls:NumericUpDown.InputBindings></controls:NumericUpDown>
                            <Button Width="70" Command="{Binding FindVertexCommand}" Content="Jump to" ToolTip="Jump to specified vertex number" />
                        </controls:SpacedStack>
                        <controls:SpacedStack Margin="0,6,0,0" Orientation="Horizontal" Spacing="6">
                            <Button Width="80" Command="{Binding RemapVertexCommand}" Content="Remap" IsEnabled="{Binding RemapEnabled}" ToolTip="Remap selected vertex to specified vertex number" />
                            <Button Width="110" Command="{Binding AutoFitCommand}" Content="Automatic fit" ToolTip="Try to automatically remap all vertices sitting on mesh holes.&#13;&#10;For legacy engines, you still have to manually remap hair hole." />
                        </controls:SpacedStack>
                    </StackPanel>
                </Border>

                <!--  Normals and shades  -->
                <Border Visibility="{Binding IsColorsMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:SpacedStack Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Vertex shade (color):" />
                            <Button
                                Width="48"
                                Height="22"
                                Background="{Binding VertexColorBrush}"
                                Command="{Binding PickColorCommand}"
                                ToolTip="Vertex shade (color) to apply" />
                            <Button Width="80" Command="{Binding ApplyShadesToAllCommand}" Content="Apply to all" ToolTip="Apply specified vertex shade to all vertices" />
                        </controls:SpacedStack>
                        <controls:SpacedStack Margin="0,6,0,0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Width="110" Style="{StaticResource Lbl}" Text="Recalculate normals:" TextWrapping="Wrap" />
                            <Button Width="70" Command="{Binding RecalcNormalsCommand}" Content="Weighted" ToolTip="Weighted normals recalculation gives better results&#13;&#10;because it takes angles between different faces in consideration." />
                            <Button Width="70" Command="{Binding RecalcNormalsAvgCommand}" Content="Averaged" ToolTip="Averaged normals recalculation is more rough and straighforward way,&#13;&#10;but still may be useful in some cases." />
                        </controls:SpacedStack>
                    </StackPanel>
                </Border>

                <!--  Vertex effects  -->
                <Border Visibility="{Binding IsEffectsMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:SpacedStack Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Glow:" />
                            <controls:NumericUpDown Style="{StaticResource Nud}" Maximum="63" Minimum="0" ToolTip="For legacy engines, any value above 0 results in constant glow only for merged statics.&#13;&#10;In such case, glow strength is derived from room effect strength." Value="{Binding Glow, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Lbl}" Text="Move:" />
                            <controls:NumericUpDown Style="{StaticResource Nud}" Maximum="63" Minimum="0" ToolTip="For legacy engines, any value above 0 results in constant movement only for merged statics.&#13;&#10;In such case, movement strength is derived from room effect strength." Value="{Binding Move, Mode=TwoWay}" />
                        </controls:SpacedStack>
                        <controls:SpacedStack Margin="0,6,0,0" Orientation="Horizontal" Spacing="6">
                            <Button Width="100" Command="{Binding ApplyEffectsToAllCommand}" Content="Apply to all" ToolTip="Apply specified vertex attributes to all faces" />
                            <ToggleButton Width="80" IsChecked="{Binding PreviewActive, Mode=TwoWay}" ToolTip="Preview all effects">
                                <StackPanel Orientation="Horizontal"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/play}" /><TextBlock Margin="4,0,0,0" Style="{StaticResource Lbl}" Text="Preview" /></StackPanel>
                            </ToggleButton>
                        </controls:SpacedStack>
                        <Button Margin="0,6,0,0" Command="{Binding ConvertFromShadesCommand}" Content="Convert from shades" ToolTip="Convert vertex effects from legacy workflow involving vertex shades." />
                    </StackPanel>
                </Border>

                <!--  Vertex weights  -->
                <Border Visibility="{Binding IsWeightsMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <UniformGrid Columns="2" Rows="1">
                            <TextBlock Margin="2,0,0,0" Style="{StaticResource Lbl}" Text="Bone:" />
                            <TextBlock Margin="2,0,0,0" Style="{StaticResource Lbl}" Text="Value:" />
                        </UniformGrid>
                        <UniformGrid Margin="0,2,0,0" Columns="2" Rows="4">
                            <controls:NumericUpDown Margin="2" Maximum="63" Minimum="0" ToolTip="Bone index" Value="{Binding WeightIndex1, Mode=TwoWay}" />
                            <controls:NumericUpDown Margin="2" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="Bone weight" Value="{Binding WeightValue1, Mode=TwoWay}" />
                            <controls:NumericUpDown Margin="2" Maximum="63" Minimum="0" ToolTip="Bone index" Value="{Binding WeightIndex2, Mode=TwoWay}" />
                            <controls:NumericUpDown Margin="2" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="Bone weight" Value="{Binding WeightValue2, Mode=TwoWay}" />
                            <controls:NumericUpDown Margin="2" Maximum="63" Minimum="0" ToolTip="Bone index" Value="{Binding WeightIndex3, Mode=TwoWay}" />
                            <controls:NumericUpDown Margin="2" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="Bone weight" Value="{Binding WeightValue3, Mode=TwoWay}" />
                            <controls:NumericUpDown Margin="2" Maximum="63" Minimum="0" ToolTip="Bone index" Value="{Binding WeightIndex4, Mode=TwoWay}" />
                            <controls:NumericUpDown Margin="2" DecimalPlaces="4" Maximum="1" Minimum="0" ToolTip="Bone weight" Value="{Binding WeightValue4, Mode=TwoWay}" />
                        </UniformGrid>
                        <Button Margin="0,6,0,0" Command="{Binding ApplyWeightsToAllCommand}" Content="Fill" ToolTip="Apply current weights to all vertices" />
                    </StackPanel>
                </Border>

                <!--  Sphere  -->
                <Border Visibility="{Binding IsSphereMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:SpacedStack Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource Lbl}" Text="X:" />
                            <controls:NumericUpDown Style="{StaticResource Nud}" Maximum="1000000" Minimum="-1000000" Value="{Binding SphereX, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Lbl}" Text="Y:" />
                            <controls:NumericUpDown Style="{StaticResource Nud}" Maximum="1000000" Minimum="-1000000" Value="{Binding SphereY, Mode=TwoWay}" />
                        </controls:SpacedStack>
                        <controls:SpacedStack Margin="0,4,0,0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource Lbl}" Text="Z:" />
                            <controls:NumericUpDown Style="{StaticResource Nud}" Maximum="1000000" Minimum="-1000000" Value="{Binding SphereZ, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Lbl}" Text="Radius:" />
                            <controls:NumericUpDown Style="{StaticResource Nud}" Maximum="1000000" Minimum="0" Value="{Binding SphereRadius, Mode=TwoWay}" />
                        </controls:SpacedStack>
                        <Button Margin="0,6,0,0" Command="{Binding ResetSphereCommand}" Content="Recalculate" ToolTip="Calculates average sphere which encloses the mesh" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Padding="4,2" Background="{DynamicResource Brush_BackgroundSlightlyDark}" DockPanel.Dock="Top"><TextBlock Style="{StaticResource Lbl}" Text="Texturing" /></Border>
            <DockPanel Margin="0,4,0,0" DockPanel.Dock="Top" IsEnabled="{Binding EditingEnabled}">
                <controls:SpacedStack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                            <Button Style="{StaticResource TbBtn}" Width="38" Click="OpenButtonMenu" ToolTip="Add texture">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding AddEmbeddedTextureCommand}" Header="Add embedded texture" />
                                        <MenuItem Command="{Binding AddExternalTextureCommand}" Header="Add external texture" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/plus_math}" /><Path Margin="3,0,0,0" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush_Text}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TbBtn}" Width="38" Click="OpenButtonMenu" ToolTip="Replace texture">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ReplaceEmbeddedTextureCommand}" Header="Replace with embedded texture" />
                                        <MenuItem Command="{Binding ReplaceExternalTextureCommand}" Header="Replace with external texture" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/refresh}" /><Path Margin="3,0,0,0" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush_Text}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TbBtn}" Command="{Binding ExportTextureCommand}" ToolTip="Export current texture to file"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/Export}" /></Button>
                            <Button Style="{StaticResource TbBtn}" Command="{Binding DeleteTextureCommand}" ToolTip="Delete texture"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon General/trash}" /></Button>
                            
                            <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding AllTextures, Mode=TwoWay}" ToolTip="List all textures from wad" Visibility="{Binding ShowAllTexturesButton, Converter={StaticResource BoolToVis}}"><Image Style="{StaticResource TbImg}" Source="{tomb:Icon Actions/DrawAllRooms}" /></ToggleButton>
                </controls:SpacedStack>
                <controls:SearchableComboBox Margin="0,0,4,0" ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture, Mode=TwoWay}" />
            </DockPanel>
            <controls:SpacedStack Margin="0,4,0,4" DockPanel.Dock="Bottom" IsEnabled="{Binding EditingEnabled}" Orientation="Horizontal" Spacing="4">
                <controls:SpacedStack Margin="0,4,0,0" Orientation="Horizontal" Spacing="4">
                            <Button Width="152" Command="{Binding MaterialEditorCommand}" Content="Materials" IsEnabled="{Binding MaterialEditorEnabled}" ToolTip="Edit materials" Visibility="{Binding ShowTextureTools, Converter={StaticResource BoolToVis}}" />
                            <Button Width="152" Command="{Binding AnimationRangesCommand}" Content="Animated textures" ToolTip="Edit animated texture sets" Visibility="{Binding ShowTextureTools, Converter={StaticResource BoolToVis}}" />
                        </controls:SpacedStack>
            </controls:SpacedStack>
            <Border Margin="0,4,0,0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                <wadControls:PanelTextureMap x:Name="textureMap" />
            </Border>
        </DockPanel>

                </Grid>
    </DockPanel>
</Window>