<Window
	x:Class="WadTool.Features.Dialogs.AnimationFixer.AnimationFixerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
	xmlns:vm="clr-namespace:WadTool.Features.Dialogs.AnimationFixer"
	Title="{tombLib:Localize Title}"
	d:DataContext="{d:DesignInstance Type=vm:AnimationFixerWindowViewModel}"
	Background="{DynamicResource Brush_Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="WidthAndHeight"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<controls:SpacedStack
		MinWidth="240"
		Margin="{x:Static darkUI:Defaults.MediumThickness}"
		Orientation="Vertical"
		Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

		<TextBlock Text="{tombLib:Localize Description}" TextWrapping="Wrap" />

		<CheckBox
			Content="{tombLib:Localize EndFrame}"
			IsChecked="{Binding FixEndFrame, Mode=TwoWay}"
			ToolTip="{tombLib:Localize EndFrameTooltip}" />
		<CheckBox
			Content="{tombLib:Localize NextAnimation}"
			IsChecked="{Binding FixNextAnimation, Mode=TwoWay}"
			ToolTip="{tombLib:Localize NextAnimationTooltip}" />
		<CheckBox
			Content="{tombLib:Localize NextFrame}"
			IsChecked="{Binding FixNextFrame, Mode=TwoWay}"
			ToolTip="{tombLib:Localize NextFrameTooltip}" />
		<CheckBox
			Content="{tombLib:Localize StateChangeRanges}"
			IsChecked="{Binding FixStateChangeRanges, Mode=TwoWay}"
			ToolTip="{tombLib:Localize StateChangeRangesTooltip}" />
		<CheckBox
			Content="{tombLib:Localize StateChangeNextAnimation}"
			IsChecked="{Binding FixStateChangeNextAnimation, Mode=TwoWay}"
			ToolTip="{tombLib:Localize StateChangeNextAnimationTooltip}" />
		<CheckBox
			Content="{tombLib:Localize StateChangeNextFrame}"
			IsChecked="{Binding FixStateChangeNextFrame, Mode=TwoWay}"
			ToolTip="{tombLib:Localize StateChangeNextFrameTooltip}" />
		<CheckBox
			Content="{tombLib:Localize RestoreAnimationName}"
			IsChecked="{Binding RestoreAnimationName, Mode=TwoWay}"
			ToolTip="{tombLib:Localize RestoreAnimationNameTooltip}" />

		<controls:SpacedStack
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button
				Width="80"
				Command="{Binding ConfirmCommand}"
				Content="{tombLib:Localize ~Common.OK}"
				IsDefault="True" />
			<Button
				Width="80"
				Command="{Binding CancelCommand}"
				Content="{tombLib:Localize ~Common.Cancel}"
				IsCancel="True" />
		</controls:SpacedStack>
	</controls:SpacedStack>
</Window>
