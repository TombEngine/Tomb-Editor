<UserControl
    x:Class="WadTool.Features.DockableViews.AnimationEditor.AnimationBlendingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:wadControls="clr-namespace:WadTool.Controls">

    <UserControl.Resources>
        <ResourceDictionary Source="PanelStyles.xaml" />
    </UserControl.Resources>
<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border Padding="2">
                    <StackPanel>
                        <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize ~WadTool.AnimationEditor.NextAnimBlendFrameCount}" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="255" Value="{Binding BlendFrameCount, Mode=TwoWay}" /></DockPanel>
                        <Border Height="96" Margin="0,4,0,0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                            <wadControls:BezierCurveEditor x:Name="bezierEditor" />
                        </Border>
                        <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize ~WadTool.AnimationEditor.Preset}" /><ComboBox SelectedIndex="{Binding BlendPresetIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{tombLib:Localize ~WadTool.AnimationEditor.Linear}" />
                            <ComboBoxItem Content="{tombLib:Localize ~WadTool.AnimationEditor.EaseIn}" />
                            <ComboBoxItem Content="{tombLib:Localize ~WadTool.AnimationEditor.EaseOut}" />
                            <ComboBoxItem Content="{tombLib:Localize ~WadTool.AnimationEditor.EaseInAndOut}" />
                        </ComboBox></DockPanel>
                    </StackPanel>
                </Border>
</ScrollViewer>
</UserControl>
