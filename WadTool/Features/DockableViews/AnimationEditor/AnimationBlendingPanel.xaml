<UserControl
    x:Class="WadTool.Features.DockableViews.AnimationEditor.AnimationBlendingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:wadControls="clr-namespace:WadTool.Controls">

    <UserControl.Resources>
        <ResourceDictionary Source="PanelStyles.xaml" />
    </UserControl.Resources>
<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border Padding="2">
                    <StackPanel>
                        <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Text="Next anim blend frame count:" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="255" Value="{Binding BlendFrameCount, Mode=TwoWay}" /></DockPanel>
                        <Border Height="96" Margin="0,4,0,0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
                            <wadControls:BezierCurveEditor x:Name="bezierEditor" />
                        </Border>
                        <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Text="Preset:" /><ComboBox SelectedIndex="{Binding BlendPresetIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Linear" />
                            <ComboBoxItem Content="Ease In" />
                            <ComboBoxItem Content="Ease Out" />
                            <ComboBoxItem Content="Ease In and Out" />
                        </ComboBox></DockPanel>
                    </StackPanel>
                </Border>
</ScrollViewer>
</UserControl>
