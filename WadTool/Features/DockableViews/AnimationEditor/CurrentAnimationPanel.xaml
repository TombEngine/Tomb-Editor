<UserControl
    x:Class="WadTool.Features.DockableViews.AnimationEditor.CurrentAnimationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:wadControls="clr-namespace:WadTool.Controls">

    <UserControl.Resources>
        <ResourceDictionary Source="PanelStyles.xaml" />
    </UserControl.Resources>
<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border Padding="2">
                    <StackPanel>
                        <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLbl}" Text="{tombLib:Localize ~WadTool.AnimationEditor.Name}" /><TextBox x:Name="animationNameBox" KeyDown="OnParameterKeyDown" LostKeyboardFocus="OnParameterLostFocus" Text="{Binding AnimName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLbl}" Text="{tombLib:Localize ~WadTool.AnimationEditor.State}" /><Button x:Name="stateSearchButton" Width="23" Height="23" Margin="4,0,0,0" Padding="0" DockPanel.Dock="Right" Click="StateSearchButton_Click" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.SearchState}"><Image Width="16" Height="16" Source="{tomb:Icon General/search}" /></Button><ComboBox x:Name="stateCombo" Width="24" DockPanel.Dock="Right" IsTextSearchEnabled="False" PreviewMouseWheel="StateCombo_PreviewMouseWheel" ItemsSource="{Binding StateNameChoices}" SelectedItem="{Binding SelectedStateName, Mode=TwoWay}" ToolTip="{tombLib:Localize ~WadTool.AnimationEditor.KnownStateNames}" /><controls:AutoCompleteBox x:Name="stateIdBox" ItemsSource="{Binding StateNames}" Text="{Binding StateIdText, Mode=TwoWay}" ToolTip="{Binding StateIdToolTip}" /></DockPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.Framerate}" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="1" Maximum="255" Value="{Binding FrameRate, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.EndFrame}" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="32767" Value="{Binding EndFrame, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.NextAnim}" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="32767" Value="{Binding NextAnimation, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.NextFrame}" /><controls:NumericUpDown Style="{StaticResource Nud}" Minimum="0" Maximum="32767" Value="{Binding NextFrame, Mode=TwoWay}" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.StartXVel}" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding StartVertVel, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.EndXVel}" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding EndVertVel, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.StartZVel}" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding StartHorVel, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="2,0"><TextBlock Text="{tombLib:Localize ~WadTool.AnimationEditor.EndZVel}" /><controls:NumericUpDown Style="{StaticResource Nud}" DecimalPlaces="4" Minimum="-32767" Maximum="32767" Value="{Binding EndHorVel, Mode=TwoWay}" /></StackPanel>
                        </Grid>
                        <UniformGrid Margin="0,8,0,0" Columns="2">
                            <Button Margin="0,0,3,0" Command="{Binding EditStateChangesCommand}" Content="{tombLib:Localize ~WadTool.AnimationEditor.StateChanges}" />
                            <Button Margin="3,0,0,0" Command="{Binding EditAnimCommandsCommand}" Content="{tombLib:Localize ~WadTool.AnimationEditor.AnimCommands}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
</ScrollViewer>
</UserControl>
