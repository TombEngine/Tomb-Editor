<UserControl
	x:Class="WadTool.AnimCommandEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="157"
	d:DesignWidth="370"
	mc:Ignorable="d">

	<UserControl.Resources>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
			<Setter Property="Margin" Value="0,0,0,3" />
		</Style>
		<Style x:Key="FieldNud" BasedOn="{StaticResource {x:Type controls:NumericUpDown}}" TargetType="controls:NumericUpDown">
			<Setter Property="Width" Value="76" />
			<Setter Property="HorizontalAlignment" Value="Left" />
		</Style>
	</UserControl.Resources>

	<DockPanel>
		<DockPanel DockPanel.Dock="Top">
			<TextBlock
				Margin="0,0,6,0"
				VerticalAlignment="Center"
				DockPanel.Dock="Left"
				Foreground="{DynamicResource Brush_Text}"
				Text="Type:" />
			<ComboBox
				x:Name="comboCommandType"
				IsEnabled="False"
				SelectionChanged="comboCommandType_SelectionChanged" />
		</DockPanel>

		<Grid Margin="0,8,0,0" VerticalAlignment="Top">

			<!--  SetPosition  -->
			<StackPanel
				x:Name="panelSetPosition"
				Orientation="Horizontal"
				Visibility="Collapsed">
				<StackPanel Margin="0,0,6,0">
					<TextBlock Style="{StaticResource FieldLabel}" Text="X:" />
					<controls:NumericUpDown
						x:Name="tbPosX"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="-32768"
						ValueChanged="tbPosX_ValueChanged" />
				</StackPanel>
				<StackPanel Margin="0,0,6,0">
					<TextBlock Style="{StaticResource FieldLabel}" Text="Y:" />
					<controls:NumericUpDown
						x:Name="tbPosY"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="-32768"
						ValueChanged="tbPosY_ValueChanged" />
				</StackPanel>
				<StackPanel>
					<TextBlock Style="{StaticResource FieldLabel}" Text="Z:" />
					<controls:NumericUpDown
						x:Name="tbPosZ"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="-32768"
						ValueChanged="tbPosZ_ValueChanged" />
				</StackPanel>
			</StackPanel>

			<!--  SetJumpDistance  -->
			<StackPanel
				x:Name="panelSetJumpVelocity"
				Orientation="Horizontal"
				Visibility="Collapsed">
				<StackPanel Margin="0,0,6,0">
					<TextBlock Style="{StaticResource FieldLabel}" Text="Horizontal:" />
					<controls:NumericUpDown
						x:Name="tbHorizontal"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="-32768"
						ValueChanged="tbHorizontal_ValueChanged" />
				</StackPanel>
				<StackPanel>
					<TextBlock Style="{StaticResource FieldLabel}" Text="Vertical:" />
					<controls:NumericUpDown
						x:Name="tbVertical"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="-32768"
						ValueChanged="tbVertical_ValueChanged" />
				</StackPanel>
			</StackPanel>

			<!--  FlipEffect  -->
			<DockPanel x:Name="panelFlipEffect" Visibility="Collapsed">
				<StackPanel Margin="0,0,6,0" DockPanel.Dock="Left">
					<TextBlock Style="{StaticResource FieldLabel}" Text="Frame:" />
					<controls:NumericUpDown
						x:Name="tbFlipEffectFrame"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="0"
						ValueChanged="tbFlipEffectFrame_ValueChanged" />
				</StackPanel>
				<StackPanel Margin="0,0,6,0" DockPanel.Dock="Left">
					<TextBlock Style="{StaticResource FieldLabel}" Text="Effect:" />
					<controls:NumericUpDown
						x:Name="tbFlipEffect"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="-32768"
						ValueChanged="tbFlipEffect_ValueChanged" />
				</StackPanel>
				<StackPanel>
					<TextBlock Style="{StaticResource FieldLabel}" Text="Condition:" />
					<ComboBox x:Name="comboFlipeffectConditions" SelectionChanged="comboFlipeffectConditions_SelectionChanged" />
				</StackPanel>
			</DockPanel>

			<!--  PlaySound  -->
			<Grid x:Name="panelPlaySound" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<StackPanel
					Grid.Row="0"
					Grid.Column="0"
					Margin="0,0,6,0">
					<TextBlock Style="{StaticResource FieldLabel}" Text="Frame:" />
					<controls:NumericUpDown
						x:Name="tbPlaySoundFrame"
						Style="{StaticResource FieldNud}"
						Maximum="32767"
						Minimum="0"
						ValueChanged="tbPlaySoundFrame_ValueChanged" />
				</StackPanel>
				<StackPanel Grid.Row="0" Grid.Column="1">
					<TextBlock Style="{StaticResource FieldLabel}" Text="Condition:" />
					<ComboBox x:Name="comboPlaySoundConditions" SelectionChanged="comboPlaySoundConditions_SelectionChanged" />
				</StackPanel>

				<DockPanel
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					Margin="0,6,0,0">
					<TextBlock
						Margin="0,0,6,0"
						VerticalAlignment="Center"
						DockPanel.Dock="Left"
						Foreground="{DynamicResource Brush_Text}"
						Text="Sound:" />
					<Button
						x:Name="butPlaySound"
						Width="23"
						Height="23"
						Click="butPlaySound_Click"
						Content="▶"
						DockPanel.Dock="Right"
						ToolTip="Play" />
					<controls:NumericUpDown
						x:Name="nudSoundId"
						Width="59"
						Margin="0,0,6,0"
						Maximum="32767"
						Minimum="0"
						DockPanel.Dock="Right"
						ValueChanged="nudSoundId_ValueChanged" />
					<controls:SearchableComboBox
						x:Name="comboSound"
						Margin="0,0,6,0"
						SelectionChanged="comboSound_SelectionChanged" />
				</DockPanel>
			</Grid>

			<!--  DisableInterpolation  -->
			<StackPanel x:Name="panelDisableInterpolation" Visibility="Collapsed">
				<TextBlock Style="{StaticResource FieldLabel}" Text="Frame:" />
				<controls:NumericUpDown
					x:Name="tbFrameDisableInterpolation"
					Style="{StaticResource FieldNud}"
					Maximum="32767"
					Minimum="0"
					ValueChanged="tbFrameDisableInterpolation_ValueChanged" />
			</StackPanel>
		</Grid>
	</DockPanel>
</UserControl>
