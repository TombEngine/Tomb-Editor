<Window
    x:Class="WadTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
    xmlns:tombLibControls="clr-namespace:TombLib.WPF.CustomControls;assembly=TombLib.WPF"
    Title="{Binding Title}"
    Icon="pack://application:,,,/WT.ico"
    Width="1200"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    Background="{DynamicResource Brush_Background}"
    Style="{DynamicResource CustomWindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <DockPanel LastChildFill="True">

        <!--  Top: main menu. Mirrors FormMain.darkMenuStrip1 1:1.  -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{tombLib:Localize ~WadTool.Main.File}">
                <MenuItem
                    Command="{Binding Commands[NewWad2Menu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.NewWad2}"
                    InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/create_new}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding Commands[OpenSourceWadMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.OpenSource}"
                    InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/Open}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding Commands[OpenDestinationWadMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.OpenDestination}"
                    InputGestureText="Ctrl+Shift+O">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/Open}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="openRecentMenu" Header="{tombLib:Localize ~WadTool.Main.OpenRecent}" />
                <MenuItem
                    Command="{Binding Commands[OpenReferenceLevelMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.OpenReferenceTombEditorProject}"
                    InputGestureText="Ctrl+Alt+O">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon Misc/TE_icon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="closeReferenceLevelMenu"
                    Command="{Binding Commands[CloseReferenceLevelMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.CloseReferenceTombEditorProject}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon Actions/delete}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    x:Name="saveWad2Menu"
                    Command="{Binding Commands[SaveMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.SaveWad2}"
                    InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/Save}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="saveWad2AsMenu"
                    Command="{Binding Commands[SaveAsMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.SaveWad2As}"
                    InputGestureText="Ctrl+Shift+S">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/Save_As}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding Commands[ExitMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.Exit}"
                    InputGestureText="Alt+F4">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon Misc/door_opened}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{tombLib:Localize ~WadTool.Main.Create}">
                <MenuItem Command="{Binding Commands[NewMoveableMenu_Click]}" Header="{tombLib:Localize ~WadTool.Main.NewMoveable}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/plus_math}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding Commands[NewStaticMenu_Click]}" Header="{tombLib:Localize ~WadTool.Main.NewStatic}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/plus_math}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding Commands[NewSpriteSequenceMenu_Click]}" Header="{tombLib:Localize ~WadTool.Main.NewSpriteSequence}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/plus_math}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{tombLib:Localize ~WadTool.Main.Selection}">
                <MenuItem Header="{tombLib:Localize ~WadTool.Main.Lighting}">
                    <MenuItem
                        x:Name="convertToStaticLightingMenu"
                        Command="{Binding Commands[ConvertToStaticLightingMenu_Click]}"
                        Header="{tombLib:Localize ~WadTool.Main.ConvertToStatic}" />
                    <MenuItem
                        x:Name="convertToDynamicLightingMenu"
                        Command="{Binding Commands[ConvertToDynamicLightingMenu_Click]}"
                        Header="{tombLib:Localize ~WadTool.Main.ConvertToDynamic}" />
                </MenuItem>
                <MenuItem Header="{tombLib:Localize ~WadTool.Main.Textures}">
                    <MenuItem
                        x:Name="convertToTiledMenu"
                        Command="{Binding Commands[ConvertToTiledMenu_Click]}"
                        Header="{tombLib:Localize ~WadTool.Main.ConvertToTiled}" />
                    <MenuItem
                        x:Name="convertToUVMappedMenu"
                        Command="{Binding Commands[ConvertToUVMappedMenu_Click]}"
                        Header="{tombLib:Localize ~WadTool.Main.ConvertToUVMapped}" />
                    <MenuItem
                        x:Name="consolidateTexturesMenu"
                        Command="{Binding Commands[ConsolidateTexturesMenu_Click]}"
                        Header="{tombLib:Localize ~WadTool.Main.ConsolidateTextures}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{tombLib:Localize ~WadTool.Main.Tools}">
                <MenuItem
                    x:Name="animatedTexturesMenu"
                    Command="{Binding Commands[AnimatedTexturesMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.AnimatedTextures}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon Actions/TextureMode}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="meshEditorMenu"
                    Command="{Binding Commands[MeshEditorMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.MeshEditor}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon Misc/wireframe}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="itemPropertiesMenu"
                    Command="{Binding Commands[ItemPropertiesMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.PropertyEditor}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon Misc/properties_16xLG}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    x:Name="convertWadToTombEngineMenu"
                    Command="{Binding Commands[ConvertWadToTombEngineMenu_Click]}"
                    Header="{tombLib:Localize ~WadTool.Main.ConvertWadToTombEngine}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon Actions/TEN}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding Commands[OptionsMenu_Click]}" Header="{tombLib:Localize ~WadTool.Main.Options}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/options}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{tombLib:Localize ~WadTool.Main.Help}">
                <MenuItem Command="{Binding Commands[AboutMenu_Click]}" Header="{tombLib:Localize ~WadTool.Main.AboutWadTool}">
                    <MenuItem.Icon>
                        <Image Source="{tomb:Icon General/AboutIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!--  Only shown when a debugger is attached, mirroring FormMain.  -->
            <MenuItem
                x:Name="debugMenu"
                Header="{tombLib:Localize ~WadTool.Main.Debug}"
                Visibility="Collapsed">
                <MenuItem Command="{Binding Commands[DebugReloadCatalogMenu_Click]}" Header="{tombLib:Localize ~WadTool.Main.DebugAction5ReloadCatalog}" />
                <MenuItem Command="{Binding Commands[DebugMeshEditorMenu_Click]}" Header="{tombLib:Localize ~WadTool.Main.DebugAction9MeshEditor}" />
            </MenuItem>
        </Menu>

        <!--  Top toolbar: Destination | Source | Reference project. Mirrors FormMain.darkToolStrip1.  -->
        <Border
            BorderBrush="{DynamicResource Brush_Border}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <StackPanel Margin="{x:Static darkUI:Defaults.SmallThickness}" Orientation="Horizontal">
                <Label Content="{tombLib:Localize ~WadTool.Main.Destination}" Foreground="{DynamicResource Brush_Text}" VerticalAlignment="Center" />
                <Button
                    Command="{Binding Commands[NewWad2Menu_Click]}"
                    Style="{DynamicResource ButtonFlatIconOnly}"
                    ToolTip="{tombLib:Localize ~WadTool.Main.NewEmptyWad2}">
                    <Image Source="{tomb:Icon General/create_new}" />
                </Button>
                <Button
                    Command="{Binding Commands[OpenDestinationWadMenu_Click]}"
                    Style="{DynamicResource ButtonFlatIconOnly}"
                    ToolTip="{tombLib:Localize ~WadTool.Main.OpenDestinationFile}">
                    <Image Source="{tomb:Icon General/Open}" />
                </Button>
                <Button
                    x:Name="butSave"
                    Command="{Binding Commands[SaveMenu_Click]}"
                    Style="{DynamicResource ButtonFlatIconOnly}"
                    ToolTip="{tombLib:Localize ~WadTool.Main.SaveWad2}">
                    <Image Source="{tomb:Icon General/Save}" />
                </Button>
                <Button
                    x:Name="butSaveAs"
                    Command="{Binding Commands[SaveAsMenu_Click]}"
                    Style="{DynamicResource ButtonFlatIconOnly}"
                    ToolTip="{tombLib:Localize ~WadTool.Main.SaveWad2As}">
                    <Image Source="{tomb:Icon General/Save_As}" />
                </Button>

                <Separator Margin="4,2" />

                <Label Content="{tombLib:Localize ~WadTool.Main.Source}" Foreground="{DynamicResource Brush_Text}" VerticalAlignment="Center" />
                <Button
                    Command="{Binding Commands[OpenSourceWadMenu_Click]}"
                    Style="{DynamicResource ButtonFlatIconOnly}"
                    ToolTip="{tombLib:Localize ~WadTool.Main.OpenSourceFile}">
                    <Image Source="{tomb:Icon General/Open}" />
                </Button>

                <Separator Margin="4,2" />

                <Label Content="{tombLib:Localize ~WadTool.Main.ReferenceProject}" Foreground="{DynamicResource Brush_Text}" VerticalAlignment="Center" />
                <Label
                    x:Name="lblRefLevel"
                    Content="{tombLib:Localize ~WadTool.Main.ProjectNotLoaded}"
                    Foreground="{DynamicResource Brush_Text}"
                    Opacity="0.6"
                    MouseLeftButtonUp="RefLevelLabel_Click"
                    VerticalAlignment="Center" />
                <Button
                    Command="{Binding Commands[OpenReferenceLevelMenu_Click]}"
                    Style="{DynamicResource ButtonFlatIconOnly}"
                    ToolTip="{tombLib:Localize ~WadTool.Main.OpenReferenceProject}">
                    <Image Source="{tomb:Icon General/Open}" />
                </Button>
                <Button
                    x:Name="butCloseRefLevel"
                    Command="{Binding Commands[CloseReferenceLevelMenu_Click]}"
                    Style="{DynamicResource ButtonFlatIconOnly}"
                    ToolTip="{tombLib:Localize ~WadTool.Main.CloseReferenceProject}">
                    <Image Source="{tomb:Icon Actions/delete}" />
                </Button>
            </StackPanel>
        </Border>

        <!--  Bottom: status bar with destination wad statistics. Mirrors FormMain.statusStrip.  -->
        <Border
            Background="{DynamicResource Brush_Background_Alternative}"
            BorderBrush="{DynamicResource Brush_Border}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="labelStatistics" Text="{Binding Statistics}"
                Margin="{x:Static darkUI:Defaults.SmallThickness}"
                Foreground="{DynamicResource Brush_Text}" />
        </Border>

        <!--  Center: Destination tree | 3D preview | Source tree, same 26/48/26 split as
            FormMain.tableLayoutPanel1 (plus grid splitters, which the previous shell lacked).  -->
        <Grid Margin="{x:Static darkUI:Defaults.SmallThickness}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26*" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="26*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!--  Destination wad  -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <StackPanel
                    Margin="0,2,0,0"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding Commands[EditItemButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        ToolTip="{tombLib:Localize ~WadTool.Main.EditSelectedItem}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon General/edit}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.EditItem}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding Commands[ChangeSlotButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        ToolTip="{tombLib:Localize ~WadTool.Main.ChangeSlotOfSelectedItem}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon General/copy}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.ChangeSlot}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding Commands[DeleteObjectButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        ToolTip="{tombLib:Localize ~WadTool.Main.DeleteSelectedObjects}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon General/trash}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.Delete}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush_Background_Alternative}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush_WindowBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Margin="{x:Static darkUI:Defaults.SmallThickness}"
                                Foreground="{DynamicResource Brush_Text}"
                                Text="{tombLib:Localize ~WadTool.Main.Destination2}" />
                        </Border>
                        <tombLibControls:WadTreeView
                            x:Name="treeDestWad"
                            Padding="3"
                            Background="{DynamicResource Brush_Background}" />
                    </DockPanel>
                </Border>
            </DockPanel>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <!--  3D preview  -->
            <DockPanel Grid.Column="2" LastChildFill="True">
                <StackPanel
                    Margin="0,2,0,0"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        x:Name="butEditAnimations"
                        Command="{Binding Commands[EditItemButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon Misc/animations}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.EditAnimations}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="butEditSkeleton"
                        Command="{Binding Commands[EditSkeletonButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon Misc/skeleton}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.EditSkeleton}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="butEditStaticModel"
                        Command="{Binding Commands[EditItemButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon General/edit}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.EditStaticModel}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="butEditSpriteSequence"
                        Command="{Binding Commands[EditItemButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon Objects/movie_projector}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.EditSpriteSequence}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="{x:Static darkUI:Defaults.BorderThickness}">
                    <Border x:Name="panel3DHost" Background="{DynamicResource Brush_Background_Low}" />
                </Border>
            </DockPanel>

            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <!--  Source wad  -->
            <DockPanel Grid.Column="4" LastChildFill="True">
                <StackPanel
                    Margin="0,2,0,0"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding Commands[AddObjectButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        ToolTip="{tombLib:Localize ~WadTool.Main.CopySelectedObjectsToDestination}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon General/angle_left}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.AddObject}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding Commands[AddObjectToDifferentSlotButton_Click]}"
                        Style="{DynamicResource ButtonFlatIconAndText}"
                        ToolTip="{tombLib:Localize ~WadTool.Main.CopySelectedObjectsToDestination2}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{tomb:Icon General/angle_left}" />
                            <TextBlock Text="{tombLib:Localize ~WadTool.Main.AddObjectToDifferentSlot}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush_Background_Alternative}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush_WindowBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                x:Name="sourceHeaderLabel"
                                Margin="{x:Static darkUI:Defaults.SmallThickness}"
                                Foreground="{DynamicResource Brush_Text}"
                                Text="{Binding SourceHeader}" />
                        </Border>
                        <tombLibControls:WadTreeView
                            x:Name="treeSourceWad"
                            Padding="3"
                            Background="{DynamicResource Brush_Background}" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
