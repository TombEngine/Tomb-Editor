<Window
	x:Class="TombLib.WPF.Features.AnimatedTextures.AnimatedTexturesWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:local="clr-namespace:TombLib.WPF.Features.AnimatedTextures"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
	xmlns:tombLib="clr-namespace:TombLib.WPF"
	Title="{tombLib:Localize Title}"
	Width="880"
	Height="680"
	MinWidth="760"
	MinHeight="560"
	d:DataContext="{d:DesignInstance Type=local:AnimatedTexturesWindowViewModel}"
	Background="{DynamicResource Brush_Background}"
	ShowInTaskbar="False"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</Window.Resources>

	<DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

		<!--  OK / Cancel  -->
		<controls:SpacedStack
			DockPanel.Dock="Bottom"
			Margin="0,8,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button Width="80" Command="{Binding OkCommand}" Content="{tombLib:Localize ~Common.OK}" IsDefault="True" />
			<Button Width="80" Command="{Binding CancelCommand}" Content="{tombLib:Localize ~Common.Cancel}" IsCancel="True" />
		</controls:SpacedStack>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="56*" MinWidth="380" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition Width="43*" MinWidth="280" />
			</Grid.ColumnDefinitions>

			<!--  ========================  LEFT: controls  ========================  -->
			<DockPanel Grid.Column="0">

				<!--  Animation set selector (top)  -->
				<Grid DockPanel.Dock="Top" Margin="0,0,0,6">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="86" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{tombLib:Localize AnimationSet}" />
					<ComboBox
						Grid.Column="1"
						ItemsSource="{Binding Sets}"
						SelectedItem="{Binding SelectedSet, Mode=TwoWay}" />
					<controls:SpacedStack
						Grid.Column="2"
						Margin="6,0,0,0"
						Orientation="Horizontal"
						Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
						<Button Command="{Binding RenameSetCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize RenameSetTooltip}">
							<Image Source="{tomb:Icon General/edit}" />
						</Button>
						<Button Command="{Binding NewSetCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize NewSetTooltip}">
							<Image Source="{tomb:Icon General/plus_math}" />
						</Button>
						<Button Command="{Binding CloneSetCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize CloneSetTooltip}">
							<Image Source="{tomb:Icon General/copy}" />
						</Button>
						<Button Command="{Binding DeleteSetCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize DeleteSetTooltip}">
							<Image Source="{tomb:Icon General/trash}" />
						</Button>
					</controls:SpacedStack>
				</Grid>

				<!--  Settings (very bottom)  -->
				<StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
					<TextBlock Margin="0,0,0,2" Text="{tombLib:Localize Settings}" />
					<Border Padding="6" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
						<Grid IsEnabled="{Binding HasSelectedSet}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="90" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="120" />
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize Type}" />
							<ComboBox
								Grid.Column="1"
								ItemsSource="{Binding AnimationTypes}"
								SelectedItem="{Binding SelectedAnimationType, Mode=TwoWay}" />

							<TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize Fps}" />
							<Grid Grid.Column="3">
								<controls:NumericUpDown
									DecimalPlaces="2"
									IsEnabled="{Binding FpsNumericEnabled}"
									Maximum="120"
									Minimum="0"
									Value="{Binding Fps, Mode=TwoWay}"
									Visibility="{Binding ShowFpsNumeric, Converter={StaticResource BoolToVis}}" />
								<ComboBox
									DisplayMemberPath="Display"
									ItemsSource="{Binding NgFpsOptions}"
									SelectedItem="{Binding SelectedNgFps, Mode=TwoWay}"
									Visibility="{Binding ShowNgFpsCombo, Converter={StaticResource BoolToVis}}" />
								<controls:NumericUpDown
									DecimalPlaces="2"
									Maximum="120"
									Minimum="0"
									Value="{Binding TenUvRotateSpeed, Mode=TwoWay}"
									Visibility="{Binding ShowTeUvRotate, Converter={StaticResource BoolToVis}}" />
							</Grid>

							<TextBlock Grid.Column="4" Margin="10,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize UvRotate}" />
							<Grid Grid.Column="5">
								<ComboBox
									DisplayMemberPath="Display"
									IsEnabled="{Binding NgUvRotateEnabled}"
									ItemsSource="{Binding NgUvRotateOptions}"
									SelectedItem="{Binding SelectedNgUvRotate, Mode=TwoWay}"
									Visibility="{Binding ShowNgUvRotateCombo, Converter={StaticResource BoolToVis}}" />
								<controls:NumericUpDown
									DecimalPlaces="0"
									Maximum="360"
									Minimum="-360"
									Value="{Binding TenUvRotateDirection, Mode=TwoWay}"
									Visibility="{Binding ShowTeUvRotate, Converter={StaticResource BoolToVis}}" />
							</Grid>
						</Grid>
					</Border>
				</StackPanel>

				<!--  Procedural animation tool + Preview (above settings)  -->
				<Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!--  Procedural animation tool  -->
					<StackPanel Grid.Column="0">
						<TextBlock Margin="0,0,0,2" Text="{tombLib:Localize ProcAnimTool}" />
						<Border Padding="6" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
							<StackPanel>
								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="64" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{tombLib:Localize Animator}" />
									<ComboBox
										Grid.Column="1"
										DisplayMemberPath="Display"
										ItemsSource="{Binding ProceduralPresets}"
										SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
										ToolTip="{tombLib:Localize AnimatorTooltip}" />
								</Grid>
								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize ProgressPercent}" />
									<controls:NumericUpDown Grid.Column="1" Maximum="100" Minimum="-100" ToolTip="{tombLib:Localize ProgressTooltip}" Value="{Binding GenStrength, Mode=TwoWay}" />
									<TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Text="{tombLib:Localize Frames}" />
									<controls:NumericUpDown Grid.Column="3" Maximum="256" Minimum="1" ToolTip="{tombLib:Localize FrameCountTooltip}" Value="{Binding GenFrameCount, Mode=TwoWay}" />
								</Grid>
								<Grid Margin="0,0,0,4">
									<controls:SpacedStack Orientation="Horizontal" Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
										<CheckBox Content="{tombLib:Localize Symmetric}" IsChecked="{Binding GenLoop, Mode=TwoWay}" ToolTip="{tombLib:Localize SymmetricTooltip}" />
										<CheckBox Content="{tombLib:Localize Smooth}" IsChecked="{Binding GenSmooth, Mode=TwoWay}" ToolTip="{tombLib:Localize SmoothTooltip}" />
									</controls:SpacedStack>
									<controls:SpacedStack HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
										<Button Command="{Binding GenerateNewCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize GenerateTooltip}">
											<Image Source="{tomb:Icon General/create_new}" />
										</Button>
										<Button Command="{Binding GenerateCloneCommand}" IsEnabled="{Binding HasSelectedSet}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize CloneTooltip}">
											<Image Source="{tomb:Icon General/copy}" />
										</Button>
										<Button Command="{Binding GenerateMergeCommand}" IsEnabled="{Binding HasSelectedSet}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize MergeTooltip}">
											<Image Source="{tomb:Icon Actions/Merge}" />
										</Button>
										<Button Command="{Binding GenerateAddFramesCommand}" IsEnabled="{Binding HasSelectedSet}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize AddFramesTooltip}">
											<Image Source="{tomb:Icon General/plus_math}" />
										</Button>
										<Button Command="{Binding GenerateReplaceCommand}" IsEnabled="{Binding HasSelectedSet}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize ReplaceTooltip}">
											<Image Source="{tomb:Icon Actions/refresh}" />
										</Button>
									</controls:SpacedStack>
								</Grid>
							</StackPanel>
						</Border>
					</StackPanel>

						<!--  Preview  -->
						<StackPanel Grid.Column="2" Width="135">
							<TextBlock Margin="0,0,0,2" Text="{tombLib:Localize Preview}" />
							<Border
								Width="135"
								Height="135"
								Background="{DynamicResource Brush_Background_Low}"
								BorderBrush="{DynamicResource Brush_Border}"
								BorderThickness="1"
								ClipToBounds="True">
								<Image
									Width="128"
									Height="128"
									Source="{Binding PreviewImage}"
									Stretch="Fill" />
							</Border>
							<ProgressBar
								Height="16"
								Margin="0,4,0,0"
								Maximum="{Binding PreviewMaximum}"
								Minimum="0"
								Value="{Binding PreviewProgress}" />
						</StackPanel>

				</Grid>

				<!--  TRNG too-many-frames warning  -->
				<TextBlock
					DockPanel.Dock="Bottom"
					Margin="0,6,0,0"
					Foreground="{DynamicResource Brush_Text_Warning}"
					Text="{Binding TooManyFramesText}"
					TextWrapping="Wrap"
					Visibility="{Binding TooManyFrames, Converter={StaticResource BoolToVis}}" />

				<!--  Frames header  -->
				<TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="{tombLib:Localize FramesHeader}" />

				<!--  Frames grid + vertical button strip  -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<DataGrid
						x:Name="framesGrid"
						Grid.Column="0"
						AutoGenerateColumns="False"
						CanUserAddRows="False"
						CanUserDeleteRows="True"
						ItemsSource="{Binding Frames}"
						SelectedItem="{Binding SelectedFrame, Mode=TwoWay}">
						<DataGrid.Columns>
							<DataGridTemplateColumn Width="44" Header="{tombLib:Localize ColumnImage}">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Image
											Width="32"
											Height="32"
											Source="{Binding Thumbnail}"
											Stretch="Uniform" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn
								Width="60"
								Binding="{Binding Repeat, Mode=TwoWay}"
								Header="{tombLib:Localize ColumnRepeat}" />
							<DataGridTemplateColumn Width="*" Header="{tombLib:Localize ColumnTexture}">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding Texture}" TextTrimming="CharacterEllipsis" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
								<DataGridTemplateColumn.CellEditingTemplate>
									<DataTemplate>
										<ComboBox
											ItemsSource="{Binding DataContext.AvailableTextures, RelativeSource={RelativeSource AncestorType=DataGrid}}"
											SelectedItem="{Binding Texture, UpdateSourceTrigger=PropertyChanged}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellEditingTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn
								Width="Auto"
								Binding="{Binding Area}"
								Header="{tombLib:Localize ColumnArea}"
								IsReadOnly="True" />
							<DataGridTextColumn Width="70" Binding="{Binding TexCoord0}" Header="{tombLib:Localize ColumnEdge0}" IsReadOnly="True" />
							<DataGridTextColumn Width="70" Binding="{Binding TexCoord1}" Header="{tombLib:Localize ColumnEdge1}" IsReadOnly="True" />
							<DataGridTextColumn Width="70" Binding="{Binding TexCoord2}" Header="{tombLib:Localize ColumnEdge2}" IsReadOnly="True" />
							<DataGridTextColumn Width="70" Binding="{Binding TexCoord3}" Header="{tombLib:Localize ColumnEdge3}" IsReadOnly="True" />
						</DataGrid.Columns>
					</DataGrid>

					<controls:SpacedStack
						Grid.Column="1"
						Margin="4,0,0,0"
						VerticalAlignment="Top"
						Orientation="Vertical"
						Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
						<Button Command="{Binding AddFrameCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize AddFrameTooltip}">
							<Image Source="{tomb:Icon General/plus_math}" />
						</Button>
						<Button Command="{Binding DeleteFrameCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize DeleteFrameTooltip}">
							<Image Source="{tomb:Icon General/trash}" />
						</Button>
						<Button Command="{Binding UpdateFrameCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize UpdateFrameTooltip}">
							<Image Source="{tomb:Icon Actions/refresh}" />
						</Button>
						<Button Margin="0,8,0,0" Command="{Binding MoveFrameUpCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize MoveUpTooltip}">
							<Image Source="{tomb:Icon General/ArrowUp}" />
						</Button>
						<Button Command="{Binding MoveFrameDownCommand}" Style="{DynamicResource ButtonWithIconOnly}" ToolTip="{tombLib:Localize MoveDownTooltip}">
							<Image Source="{tomb:Icon General/ArrowDown}" />
						</Button>
					</controls:SpacedStack>
				</Grid>
			</DockPanel>

			<GridSplitter
				Grid.Column="1"
				Width="6"
				HorizontalAlignment="Stretch"
				Background="{DynamicResource Brush_Border}" />

			<!--  ========================  RIGHT: texture map  ========================  -->
			<DockPanel Grid.Column="2">
				<DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
					<Button Style="{DynamicResource ButtonWithIconOnly}"
						DockPanel.Dock="Right"
						Width="23"
						Margin="2,0,0,0"
						Command="{x:Static tombLib:ComboSearch.OpenCommand}"
						CommandParameter="{Binding ElementName=textureCombo}"
						ToolTip="Search">
						<Image Width="16" Height="16" Source="{tomb:Icon General/search}" />
					</Button>
					<controls:SearchableComboBox
						x:Name="textureCombo"
						ItemsSource="{Binding AvailableTextures}"
						SelectedItem="{Binding CurrentTexture, Mode=TwoWay}" />
				</DockPanel>
				<Border
					x:Name="textureMapContainer"
					Background="{DynamicResource Brush_Background_Low}"
					BorderBrush="{DynamicResource Brush_Border}"
					BorderThickness="1" />
			</DockPanel>
		</Grid>
	</DockPanel>
</Window>
