<Window
	x:Class="TombLib.WPF.Features.AnimatedTextures.InputDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:local="clr-namespace:TombLib.WPF.Features.AnimatedTextures"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tombLib="clr-namespace:TombLib.WPF"
	Title="{Binding Title}"
	Width="340"
	d:DataContext="{d:DesignInstance Type=local:InputDialogViewModel}"
	Background="{DynamicResource Brush_Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">
	<StackPanel Margin="{x:Static darkUI:Defaults.MediumThickness}">
		<TextBlock Margin="0,0,0,6" Text="{Binding Label}" />
		<TextBox x:Name="input" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
		<controls:SpacedStack
			Margin="0,12,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button
				Width="80"
				Command="{Binding OkCommand}"
				Content="{tombLib:Localize ~Common.OK}"
				IsDefault="True" />
			<Button
				Width="80"
				Content="{tombLib:Localize ~Common.Cancel}"
				IsCancel="True" />
		</controls:SpacedStack>
	</StackPanel>
</Window>
