<Window x:Class="TombLib.WPF.Features.ColorPicker.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
        xmlns:tomb="clr-namespace:TombLib.WPF"
        Title="{tomb:Localize Title}" Width="390" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush_Background}" Style="{DynamicResource CustomWindowStyle}">
    <StackPanel Margin="16">
        <controls:ColorPicker SelectedColor="{Binding SelectedColor}" />
        <GroupBox Header="{tomb:Localize CustomColors}" Margin="0,16,0,12">
            <StackPanel Margin="8">
                <ListBox ItemsSource="{Binding CustomColors}" SelectedIndex="{Binding SelectedSlot}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding}" Width="26" Height="22" BorderBrush="{DynamicResource Brush_Border_Low}" BorderThickness="1" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{tomb:Localize SaveCustom}" Command="{Binding SaveCustomCommand}" Margin="0,8,0,0" />
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{tomb:Localize ~Common.OK}" Command="{Binding AcceptCommand}" IsDefault="True" Width="80" Margin="0,0,8,0" />
            <Button Content="{tomb:Localize ~Common.Cancel}" IsCancel="True" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
