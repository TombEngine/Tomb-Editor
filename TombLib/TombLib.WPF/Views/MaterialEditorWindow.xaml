<Window x:Class="TombLib.WPF.Views.MaterialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TombLib.WPF.Views"
        xmlns:tomb="clr-namespace:TombLib.WPF"
        Title="{tomb:Localize Title}" Width="537" Height="724" MinWidth="537" MinHeight="724"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{DynamicResource CustomWindowStyle}"
        Background="{DynamicResource Brush_Background}">
    <Window.Resources>
        <Style x:Key="MapEditButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Width" Value="64"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source texture. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{tomb:Localize Texture}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture}" DisplayMemberPath="Path"/>
        </StackPanel>

        <!-- Texture maps, one block per map with its preview on the right, like the legacy form. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}">
            <ItemsControl ItemsSource="{Binding Maps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Label, StringFormat={}{0}:}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding ClearCommand}" Style="{StaticResource MapEditButton}"
                                            Content="{tomb:Localize ClearText}" ToolTip="{tomb:Localize Clear}"/>
                                    <Button DockPanel.Dock="Right" Command="{Binding BrowseCommand}" Style="{StaticResource MapEditButton}"
                                            Content="{tomb:Localize BrowseText}" ToolTip="{tomb:Localize Browse}"/>
                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding Error}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error}" Value="">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Background_Low}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="BorderBrush" Value="IndianRed"/>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DockPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Margin="6,0,0,0" Width="44" Height="44" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush_Background_Low}">
                                <Image Source="{Binding Preview}" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Material type, name and the type specific properties. -->
        <GroupBox Grid.Row="2" Header="{tomb:Localize Properties}" Margin="0,6,0,0" IsEnabled="{Binding CanEdit}">
            <StackPanel Margin="6,4">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{tomb:Localize Type}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name"/>
                    <TextBlock Grid.Row="1" Text="{tomb:Localize Name}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <local:LuaPropertyGridControl DataContext="{Binding PropertyGrid}"/>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{tomb:Localize Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="84" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{tomb:Localize OK}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="84"/>
            <TextBlock Text="{Binding MaterialFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
