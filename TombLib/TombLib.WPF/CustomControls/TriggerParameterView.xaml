<UserControl
	x:Class="TombLib.WPF.CustomControls.TriggerParameterView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
	MinWidth="100"
	Height="23"
	d:DesignWidth="315"
	mc:Ignorable="d">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<!--  combo / numericUpDown / label  -->
			<ColumnDefinition Width="Auto" />
			<!--  colorPreview  -->
			<ColumnDefinition Width="Auto" />
			<!--  butView / butReset  -->
			<ColumnDefinition Width="Auto" />
			<!--  search  -->
		</Grid.ColumnDefinitions>

		<controls:SearchableComboBox
			x:Name="comboPart"
			Grid.Column="0"
			VerticalAlignment="Stretch"
			SelectionChanged="OnComboSelectionChanged"
			Visibility="Collapsed" />

		<controls:NumericUpDown
			x:Name="numericPart"
			Grid.Column="0"
			VerticalAlignment="Stretch"
			Minimum="-32768"
			Maximum="65535"
			ValueChanged="OnNumericValueChanged"
			Visibility="Collapsed" />

		<TextBlock
			x:Name="labelPart"
			Grid.Column="0"
			Margin="2,0,0,0"
			VerticalAlignment="Center"
			Foreground="{DynamicResource Brush_Text}"
			MouseDown="OnLabelMouseDown"
			Visibility="Collapsed" />

		<Border
			x:Name="colorPreviewPart"
			Grid.Column="1"
			Width="55"
			Margin="2,0,0,0"
			BorderBrush="{DynamicResource Brush_Border}"
			BorderThickness="1"
			Visibility="Collapsed" />

		<Button
			x:Name="butViewPart"
			Grid.Column="2"
			Width="55"
			Margin="2,0,0,0"
			Click="OnViewClick"
			Content="Locate"
			Visibility="Collapsed" />

		<Button
			x:Name="butResetPart"
			Grid.Column="2"
			Width="55"
			Margin="2,0,0,0"
			Background="#8B0000"
			Click="OnResetClick"
			Content="Reset"
			Visibility="Collapsed" />
		<Button
			Grid.Column="3"
			Width="23"
			Margin="2,0,0,0"
			Click="OnSearchClick"
			ToolTip="Search"
			Visibility="{Binding Visibility, ElementName=comboPart}">
			<Image Width="16" Height="16" Source="{tomb:Icon General/search}" />
		</Button>
	</Grid>
</UserControl>
