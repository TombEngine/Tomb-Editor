<Project Sdk="Microsoft.NET.Sdk">
  <!-- Explicit usings (repository standard; implicit usings are not used). -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="TextMateSharp" Version="2.0.3" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nickelony.LanguageServer.Abstractions" Version="$(NickelonyLanguageServerVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\DarkUI\DarkUI.WPF\DarkUI.WPF.csproj" />
    <ProjectReference Include="..\..\DarkUI\DarkUI\DarkUI.csproj" />
    <PackageReference Include="Nickelony.IDEKit.AvalonEdit" Version="$(NickelonyIDEKitAvalonEditVersion)" />
    <PackageReference Include="Nickelony.IDEKit.AvalonEdit.IntelliSense" Version="$(NickelonyIDEKitAvalonEditIntelliSenseVersion)" />
<PackageReference Include="Nickelony.IDEKit.AvalonEdit.Extras" Version="$(NickelonyIDEKitAvalonEditExtrasVersion)" />
    <PackageReference Include="Nickelony.IDEKit.Core" Version="$(NickelonyIDEKitCoreVersion)" />
    <ProjectReference Include="..\TombLib\TombLib.csproj" />
    <ProjectReference Include="..\TombLib.WPF\TombLib.WPF.csproj" />
  </ItemGroup>
</Project>