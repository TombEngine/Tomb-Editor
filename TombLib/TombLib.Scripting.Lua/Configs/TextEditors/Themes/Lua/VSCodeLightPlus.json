{
	"Name": "VSCode Light+",
	"Aliases": [ "VSCode Light", "Light+" ],
	"Background": "#FFFFFF",
	"Foreground": "#1E1E1E",
	"SemanticColors": {
		"MutedText": "#616161",
		"Misc": "#1E1E1E",
		"Method": "#795E26",
		"Variable": "#001080",
		"Property": "#0451A5",
		"Type": "#267F99",
		"Keyword": "#0000FF",
		"LanguageConstant": "#0000FF",
		"Constant": "#098658",
		"File": "#795E26",
		"SignatureParameterDocumentation": "#4D4D4C",
		"SignatureActiveParameter": "#001080",
		"SignatureText": "#1E1E1E"
	},
	"TextMateTheme": {
		"Rules": [
			{
				"Scope": "comment",
				"Foreground": "#008000"
			},
			{
				"Scope": "string",
				"Foreground": "#A31515"
			},
			{
				"Scope": "constant.numeric",
				"Foreground": "#098658"
			},
			{
				"Scope": "constant.character.escape",
				"Foreground": "#795E26"
			},
			{
				"Scope": "constant.language",
				"Foreground": "#0000FF"
			},
			{
				"Scope": "keyword, storage",
				"Foreground": "#0000FF"
			},
			{
				"Scope": "keyword.operator",
				"Foreground": "#1E1E1E"
			},
			{
				"Scope": "entity.name.function, support.function, support.function.library, support.function.any-method",
				"Foreground": "#795E26"
			},
			{
				"Scope": "entity.name.class, support.class, support.type, storage.type.generic",
				"Foreground": "#267F99"
			},
			{
				"Scope": "variable.parameter, entity.other.attribute",
				"Foreground": "#001080"
			},
			{
				"Scope": "variable.language.self, entity.name.tag, string.tag, storage.type.annotation",
				"Foreground": "#0451A5"
			}
		]
	}
}
