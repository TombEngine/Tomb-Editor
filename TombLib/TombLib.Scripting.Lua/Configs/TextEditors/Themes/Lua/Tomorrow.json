	"TextMateTheme": {
		"Rules": [
			{
				"Scope": "comment",
				"Foreground": "#8E908C"
			},
			{
				"Scope": "string",
				"Foreground": "#718C00"
			},
			{
				"Scope": "constant.numeric",
