<Project Sdk="Microsoft.NET.Sdk">

  <!-- Explicit usings (repository standard; implicit usings are not used). -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Icons\Constant.png" />
    <None Remove="Resources\Icons\Directive.png" />
    <None Remove="Resources\Icons\NewCommand.png" />
    <None Remove="Resources\Icons\OldCommand.png" />
    <None Remove="Resources\Icons\Section.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nickelony.LanguageServer.Abstractions" Version="$(NickelonyLanguageServerVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nickelony.IDEKit.AvalonEdit" Version="$(NickelonyIDEKitAvalonEditVersion)" />
    <PackageReference Include="Nickelony.IDEKit.Core" Version="$(NickelonyIDEKitCoreVersion)" />
    <PackageReference Include="Nickelony.IDEKit.IntelliSense" Version="$(NickelonyIDEKitIntelliSenseVersion)" />
    <PackageReference Include="Nickelony.IDEKit.Tooling" Version="$(NickelonyIDEKitToolingVersion)" />
    <ProjectReference Include="..\TombLib.Scripting.UI\TombLib.Scripting.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Configs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Configs\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="Resources\ClassicScript\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Resources\ClassicScript\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreCLR-NCalc" Version="2.2.101" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\Constant.png" />
    <Resource Include="Resources\Icons\Directive.png" />
    <Resource Include="Resources\Icons\NewCommand.png" />
    <Resource Include="Resources\Icons\OldCommand.png" />
    <Resource Include="Resources\Icons\Section.png" />
  </ItemGroup>

</Project>
