<?xml version="1.0" encoding="utf-8"?>
<propertyCatalog>
    <moveable id="BOO_MUTANT, BIG_SCORPION, COBRA, LIZARD, HARPY, SEAL_MUTANT, SMALL_SCORPION">
        <property
			internalName="Poisonous"
			displayName="Poison attack"
			type="Bool"
			defaultValue="true"
			category="Attack Parameters"
			description="If checked, enemy will poison player with certain attacks"
		/>
    </moveable>
<moveable id="DART_EMITTER, HOMING_DART_EMITTER">
        <property
            internalName="Poisonous"
            displayName="Dart Poison"
            type="Bool"
            defaultValue="false"
            replacesOCB="true"
            category="Dart Parameters"
            description="If checked, dart will poison player"
        />
        <property
            internalName="DartDamage"
            displayName="Dart Damage"
            type="Int"
            defaultValue="25"
            replacesOCB="true"
            minValue="0"
            maxValue="100"
            category="Dart Parameters"
            description="Dart damage"
        />
        <property
            internalName="DartVelocity"
            displayName="Dart Velocity"
            type="Float"
            defaultValue="256"
            replacesOCB="true"
            minValue="0"
            maxValue="1024"
            category="Dart Parameters"
            description="Dart speed in units per frame"
        />
    </moveable>
    <moveable id="DART_EMITTER">
        <property
            internalName="DartDelay"
            displayName="Dart Delay"
            type="Int"
            defaultValue="32"
            replacesOCB="true"
            minValue="0"
            maxValue="100"
            category="Dart Parameters"
            description="Delay between darts in frames"
        />
    </moveable>
    <moveable id="HOMING_DART_EMITTER">
        <property
            internalName="HomingDartDelay"
            displayName="Dart Delay"
            type="Int"
            defaultValue="24"
            replacesOCB="true"
            minValue="0"
            maxValue="100"
            category="Dart Parameters"
            description="Delay between homing darts in frames"
        />
    </moveable>
    <moveable id="TRIBESMAN_WITH_DARTS">
        <property
            internalName="Poisonous"
            displayName="Dart Poison"
            type="Bool"
            defaultValue="true"
            category="Dart Parameters"
            description="If checked, dart will poison player"
        />
        <property
            internalName="DartDamage"
            displayName="Dart Damage"
            type="Int"
            defaultValue="25"
            minValue="0"
            maxValue="1000"
            category="Dart Parameters"
            description="Dart damage"
        />
        <property
            internalName="DartVelocity"
            displayName="Dart Velocity"
            type="Float"
            defaultValue="256"
            minValue="0"
            maxValue="1024"
            category="Dart Parameters"
            description="Dart speed in units per frame"
        />
    </moveable>
</propertyCatalog>