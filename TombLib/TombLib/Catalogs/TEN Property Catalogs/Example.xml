<?xml version="1.0" encoding="utf-8"?>
<!--
  TEN Lua Property Catalog - Example
  
  This file defines custom Lua properties for moveable and static object types.
  Each <moveable> or <static> element targets object slots by numeric type ID
  (via the "id" attribute) or by string name (via the "name" attribute).
  
  Supported id formats:
    - Single:  id="73"
    - List:    id="73,74,75"
    - Range:   id="73-80"
    - Mixed:   id="0-5,73,100-105"
  
  Supported name formats:
    - Single:  name="LARA"
    - List:    name="LARA,SHOTGUN_ITEM"
    - Range:   name="LARA-SHOTGUN_ITEM"
    - Mixed:   name="LARA-PISTOLS_ITEM,SHOTGUN_ITEM"
  
  If both "id" and "name" are specified, "id" takes priority.
  
  Supported types: Bool, Int, Float, String, Vec2, Vec3, Rotation, Color, Time, Enum
  
  Values use Lua literal syntax (e.g. "true", "42", "1.5"):
    - Bool:     "true" or "false"
    - Int:      "0", "100", "-5"
    - Float:    "0.0", "3.14", "-1.5"
    - String:   any text (quotes are added automatically)
    - Vec2:     TEN.Vec2(0, 0)               (two comma-separated floats)
    - Vec3:     TEN.Vec3(0, 0, 0)            (three comma-separated floats, prefixed with `TEN.Vec3`)
    - Rotation: TEN.Rotation(0, 0, 0)        (three angles in degrees, clamped to 0-360, prefixed with `TEN.Rotation`)
    - Color:    TEN.Color(255, 0, 0)         (three 0-255 ints, or four with alpha, prefixed with `TEN.Color`)
    - Time:     TEN.Time(0, 0, 0, 0)         (hours, minutes, seconds, centiseconds, prefixed with `TEN.Time`)
    - Enum:     "0"                          (0-based index; use entry name as defaultValue for readability)
  
  Optional property attributes:
    - replacesOCB: "true" or "false" (default false). When true, the editor will warn and disable this property
	  if the placed object has a non-zero OCB value, preventing conflicts between legacy OCB and modern Lua properties.
    - hasAlpha:    "true" or "false" (Color only, default false). Shows an alpha field next to the color picker.
  
  Properties defined here appear in the WadTool property grid for global (Level 1) 
  editing and in TombEditor for per-instance (Level 2) editing.
  
  See README.md in this folder for a full attribute reference.
-->
<propertyCatalog>
  <!-- Example: Baddy1 (moveable ID 174 in TombEngine slot list) -->
  <moveable name="BADDY1">
    <property internalName="health"
              displayName="Health"
              type="Int"
              defaultValue="100"
              maxValue="1000"
              minValue="1"
              category="Combat"
              description="Base health points for this enemy type." />

    <property internalName="aggroRange"
              displayName="Aggro Range"
              type="Float"
              defaultValue="5120.0"
              category="Combat"
              description="Distance in world units at which the enemy becomes aggressive." />

    <property internalName="isImmortal"
              displayName="Immortal"
              type="Bool"
              defaultValue="false"
              category="Combat"
              description="If true, the enemy cannot be killed." />

    <!-- Enum via compact 'entries' attribute.
         Values compile as 0-based integers: Normal=0, Aggressive=1, Passive=2 -->
    <property internalName="behavior"
              displayName="Behavior"
              type="Enum"
              entries="Normal, Aggressive, Passive"
              defaultValue="Normal"
              category="Combat"
              description="Default AI behavior mode for this enemy." />

    <property internalName="tintColor"
              displayName="Tint Color"
              type="Color"
              defaultValue="TEN.Color(255, 255, 255)"
              category="Appearance"
              description="Color tint applied to this enemy model." />

    <!-- Scale factor replacing legacy OCB-based scaling. -->
    <property internalName="scale"
              displayName="Model Scale"
              type="Float"
              defaultValue="1.0"
              minValue="0.1"
              maxValue="10.0"
              category="Appearance"
              description="Uniform scale multiplier for this moveable."
              replacesOCB="true" />
  </moveable>

  <!-- Example: Name-based moveable targeting. Uses string slot name instead of numeric ID. -->
  <moveable name="LARA">
    <property internalName="crouchRoll"
              displayName="Crouch Roll"
              type="Bool"
              defaultValue="false"
              category="Movement"
              description="If true, enables the crouch-roll move for Lara."
              replacesOCB="true" />

    <property internalName="jumpSpeed"
              displayName="Base Jump Speed"
              type="Float"
              defaultValue="100.0"
              minValue="0.0"
              maxValue="500.0"
              category="Movement"
              description="Base speed applied when Lara jumps." />
  </moveable>

  <!-- Example: Static ID 0 (plant/decoration) -->
  <static id="0">
    <property internalName="swaySpeed"
              displayName="Sway Speed"
              type="Float"
              defaultValue="1.0"
              category="Animation"
              description="Speed multiplier for wind sway animation." />

    <property internalName="swayAmplitude"
              displayName="Sway Amplitude"
              type="Vec3"
              defaultValue="TEN.Vec3(0, 10, 0)"
              category="Animation"
              description="Maximum rotation offset in each axis for sway effect." />

    <!-- Enum via child <entry> nodes (alternative to 'entries' attribute).
         Values compile as 0-based integers: None=0, Low=1, Medium=2, High=3 -->
    <property internalName="priority"
              displayName="Priority"
              type="Enum"
              defaultValue="Medium"
              category="Animation"
              description="Processing priority for this static object's update tick.">
      <entry value="None" />
      <entry value="Low" />
      <entry value="Medium" />
      <entry value="High" />
    </property>
  </static>
</propertyCatalog>
